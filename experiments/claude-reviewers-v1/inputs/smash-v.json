  "synonym_discrimination": {
    "words": [
      "break-v",
      "smash-v",
      "shatter-v",
      "crash-v"
    ],
    "note": "**Break** is the general word: *I broke a cup*. **Smash** adds force and noise, and the thing usually breaks into many pieces, often on purpose: *They smashed the windows*. **Shatter** is used when something, especially glass, breaks suddenly into very small pieces: *The mirror shattered*. **Crash** is used when a vehicle hits something: *The bus crashed into a wall*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "The car smashed with a tree.",
      "correct": "The car smashed into a tree.",
      "note": "When one thing hits another with force, use **into** or **against**, not **with**."
    }
  ],
