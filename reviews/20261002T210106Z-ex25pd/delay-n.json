          "field": "learner_errors",
          "verdict": "issue",
          "quote": "I'm sorry for my delay.",
          "severity": "blocking",
          "family": "learner-error",
          "reason": "This is not an error: it is a natural apology for a delay in responding or arriving, though “I’m sorry I’m late” is more direct when apologizing for personal lateness."
        },
