        {
          "field": "coverage",
          "verdict": "issue",
          "quote": "in someone's wildest dreams",
          "severity": "minor",
          "family": "coverage",
          "reason": "The common idiom 'in/beyond someone's wildest dreams' (or 'wildest dreams') is missing from senses and phrases."
        },
        {
          "field": "examples_fit",
          "verdict": "issue",
          "quote": "They had a wild party last night.",
          "severity": "blocking",
          "family": "example-unnatural",
          "reason": "In sense 4, the definition 'behaving in a way that is not controlled, often noisy or excited' applies to a person/animal behaving, so 'a wild party' does not fit the wording of the definition."
        },
        {
          "field": "examples_fit",
          "verdict": "issue",
          "quote": "It sounds wild, but the story is true.",
          "severity": "blocking",
          "family": "example-unnatural",
          "reason": "This example in sense 7 ('done or said without careful thought, and with little chance of being right') actually belongs to sense 10 ('very surprising or strange', compare sense 10's 'It was a wild story, but every word of it was true')."
        }
