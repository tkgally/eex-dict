  "synonym_discrimination": {
    "words": [
      "quite-adv",
      "fairly-adv",
      "rather-adv",
      "pretty-adv"
    ],
    "note": "All four can mean *more than a little*. **Fairly** is the weakest and the most neutral: *fairly good* (good, but not very). **Pretty** is informal and usually a little stronger: *pretty good*. **Rather** often suggests that something is more than expected, often in a bad way: *rather expensive*. **Quite** is between **fairly** and **very** in British English, and close to **very** in American English: *quite good*."
  },
  "usage_note": "**Quite** goes before **a** or **an**: *quite a big house*, not *a quite big house*. With a negative, **not quite** means *almost*: *I don't quite understand* means *I understand some of it, but not all*.",
  "learner_errors": [
    {
      "incorrect": "It is a quite big house.",
      "correct": "It is quite a big house.",
      "note": "**Quite** comes before **a** or **an**, not after it."
    },
    {
      "incorrect": "I'm quiet sure.",
      "correct": "I'm quite sure.",
      "note": "**Quite** (one part, rhymes with **white**) is the adverb; **quiet** means *not noisy*."
    }
  ],
