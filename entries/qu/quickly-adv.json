  "synonym_discrimination": {
    "words": [
      "quickly-adv",
      "fast-adv",
      "rapidly-adv"
    ],
    "note": "Fast describes speed, usually of something that moves, goes after the verb, and never takes -ly: a fast car, drive fast, run fast. Quickly is the general word for taking little time and is used both for movement and for how soon something is done: walk quickly, quickly realize, answer quickly. Rapidly is more formal and is used mainly of change, growth, and spread: a rapidly growing town."
  },
  "usage_note": "In informal speech quick is used as an adverb after a verb: Come quick! Run as quick as you can. In writing use quickly. The comparative is more quickly, and quicker is common in speech: She got there quicker than me.",
  "learner_errors": [
    {
      "incorrect": "He runs very quick.",
      "correct": "He runs very quickly.",
      "note": "Quick is an adjective; the adverb is quickly, and quick as an adverb belongs mainly to informal speech."
    },
    {
      "incorrect": "She learned it quicklier than me.",
      "correct": "She learned it more quickly than me.",
      "note": "Adverbs ending in -ly form the comparative with more."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages have one word for fast, quickly, and soon; English separates speed (fast, quickly), promptness (quickly, promptly), and time from now (soon). The briefly sense (quickly check) is a short action, not a fast one.",
    "grammar": "Quickly goes after the verb and its object (she read the letter quickly) or before the verb (she quickly read the letter), never between the verb and its object.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Two syllables with the stress on the first; the ck is one k sound: kwik-lee."
  },
