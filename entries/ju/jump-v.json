  "synonym_discrimination": {
    "words": [
      "jump-v",
      "leap-v",
      "hop-v"
    ],
    "note": "**Jump** is the everyday word for any movement into the air: *jump over a puddle*. **Leap** is a long or high jump, and sounds stronger or more written: *the deer leaped over the fence*. **Hop** is a small jump, often on one foot, or a small, quick jump by a bird or an animal: *hop on one leg*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "She jumped the pool.",
      "correct": "She jumped into the pool.",
      "note": "Without a preposition, **jump something** means *go over it*; say **jump into**, **jump off**, and so on for a direction."
    }
  ],
