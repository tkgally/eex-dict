  "synonym_discrimination": null,
  "usage_note": "**Just** usually goes before the main verb (*I just want...*), after **be** (*She's just tired*), or after a helping verb (*I've just eaten*). Its place can change the meaning: *Just Sam came* (only Sam) is different from *Sam just came* (a moment ago).",
  "learner_errors": [
    {
      "incorrect": "I just have eaten.",
      "correct": "I have just eaten.",
      "note": "**Just** goes after the helping verb **have**."
    },
    {
      "incorrect": "I've just seen him an hour ago.",
      "correct": "I saw him an hour ago.",
      "note": "With a finished time such as *an hour ago*, use the past simple; **just** means *a very short time ago* without one."
    }
  ],
  "etymology": null,
