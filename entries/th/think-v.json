  "synonym_discrimination": null,
  "usage_note": "**Think of** and **think about** often mean the same. **Think of** is usual for finding an idea or a name, or for remembering: *I can't think of the word*. **Think about** is usual for considering something for a time: *I need to think about your offer*. *What do you think of it?* asks for an opinion.",
  "learner_errors": [
    {
      "incorrect": "I think not so.",
      "correct": "I don't think so.",
      "note": "To give a negative answer, use **I don't think so**."
    },
    {
      "incorrect": "I am thinking that you are right.",
      "correct": "I think that you are right.",
      "note": "For an opinion, **think** is not usually used in continuous tenses."
    },
    {
      "incorrect": "I thought to buy a new car.",
      "correct": "I thought about buying a new car.",
      "note": "For a plan that is not decided, use **think about** or **think of** with an **-ing** form."
    }
  ],
