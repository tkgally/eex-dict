  "synonym_discrimination": null,
  "usage_note": "Do not confuse **there** with **their** (belonging to them) and **they're** (they are); all three sound the same. **There** is not used after **to**: say *go there*, not *go to there*.",
  "learner_errors": [
    {
      "incorrect": "I went to there yesterday.",
      "correct": "I went there yesterday.",
      "note": "**There** already includes the idea of *to*; no preposition is needed after verbs of movement."
    },
    {
      "incorrect": "There is many people here.",
      "correct": "There are many people here.",
      "note": "The verb agrees with the noun after it: *there is* + singular, *there are* + plural."
    },
    {
      "incorrect": "Near my house has a bank.",
      "correct": "There is a bank near my house.",
      "note": "To say that something exists, use **there is** or **there are**, not **it has**."
    }
