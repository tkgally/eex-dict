  "synonym_discrimination": {
    "words": [
      "throw-v",
      "toss-v",
      "hurl-v"
    ],
    "note": "**Throw** is the general word. **Toss** means throw lightly, often a short way: *toss the keys onto the table*. **Hurl** means throw with great force, often in anger: *hurl a rock at the window*."
  },
  "usage_note": "Plain **throw** means send something through the air. Getting rid of something you do not want is **throw away** or **throw out**, which have their own entries: *Throw away that old newspaper*.",
  "learner_errors": [
    {
      "incorrect": "She threw the ball at me so I could catch it.",
      "correct": "She threw the ball to me so I could catch it.",
      "note": "**Throw to** is for someone to catch; **throw at** means aim at someone or something, often to hit them."
    },
    {
      "incorrect": "He throwed the ball over the fence.",
      "correct": "He threw the ball over the fence.",
      "note": "The past tense is **threw** and the past participle is **thrown**."
    },
    {
      "incorrect": "Please throw this old box.",
      "correct": "Please throw this old box away.",
      "note": "To get rid of something, use **throw away** or **throw out**."
    }
  ],
