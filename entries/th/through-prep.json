  "synonym_discrimination": null,
  "usage_note": "**Through** with no noun after it (*Come through*, *I read it through*) is an adverb, and **through** meaning *finished* (*We're through*) is an adjective; this entry covers only the preposition. Phrasal verbs such as **go through** (*examine carefully*) and **get through** (*pass* or *finish*) have entries of their own.",
  "learner_errors": [
    {
      "incorrect": "We walked though the park.",
      "correct": "We walked through the park.",
      "note": "**Through**, with an **r**, rhymes with **too**; **though** rhymes with **go** and means something different."
    },
    {
      "incorrect": "I found the job by a friend.",
      "correct": "I found the job through a friend.",
      "note": "Use **through** for the person who brought you information or a chance; **by** names the person who does the action."
    }
  ],
