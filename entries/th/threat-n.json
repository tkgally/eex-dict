  "synonym_discrimination": null,
  "usage_note": "When someone or something may cause harm, it is **a threat to** someone or something: *a threat to health*. The possibility of something bad happening is **the threat of** it: *the threat of rain*.",
  "learner_errors": [
    {
      "incorrect": "Smoking is a threat for your health.",
      "correct": "Smoking is a threat to your health.",
      "note": "Use **a threat to** someone or something, not **for**."
    },
    {
      "incorrect": "He did a threat to call the police.",
      "correct": "He threatened to call the police.",
      "note": "People **make** threats, not **do** them; the verb **threaten** is often more natural."
    }
