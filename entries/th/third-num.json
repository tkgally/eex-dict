  "synonym_discrimination": null,
  "usage_note": "**Third** is written **3rd** in short form (*the 3rd of June*). It usually comes after **the** or a word such as **my** or **their** (*the third floor*, *their third child*), but not in some fixed phrases such as *third prize* and *third place*. *A third* meaning one of three equal parts (*a third of the class*) is a noun, which has its own entry.",
  "learner_errors": [
    {
      "incorrect": "the three of June",
      "correct": "the third of June",
      "note": "Dates use the ordinal number: *the third of June* or *June third*."
    }
  ],
