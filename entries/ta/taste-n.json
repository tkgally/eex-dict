  "synonym_discrimination": {
    "words": [
      "taste-n",
      "flavor-n"
    ],
    "note": "**Taste** is the general word for what you notice in your mouth (*a bitter taste*) and for the sense itself. **Flavor** is the particular taste that one kind of food or drink has (*ice cream in six flavors*, *a strong lemon flavor*)."
  },
  "usage_note": null,
