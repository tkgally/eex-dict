  "synonym_discrimination": {
    "words": [
      "tall-adj",
      "high-adj"
    ],
    "note": "Use **tall** for people, and for things such as trees and buildings that are narrow as well as high: *a tall girl*, *a tall tower*. Use **high** for mountains, walls, and things that are far above the ground: *a high mountain*, *a high window*. Only **tall** gives a person's height: *She is five feet tall.*"
  },
  "usage_note": "*A tall order* (a job that is hard to do) and *a tall tale* (a story that is hard to believe; British English also says *a tall story*) do not describe height.",
  "learner_errors": [
