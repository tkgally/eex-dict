  "synonym_discrimination": null,
  "usage_note": "**Talk** is the everyday verb for a conversation and is a little less formal than **speak**. **Talk to someone** and **talk with someone** both mean having a conversation; **with** suggests that both people take part equally. **Talk about** is the usual way to name the subject; **talk of** is more formal or literary.",
  "learner_errors": [
    {
      "incorrect": "I talked him about it.",
      "correct": "I talked to him about it.",
      "note": "The person takes **to** or **with** after **talk**."
    },
    {
      "incorrect": "He talked that he was tired.",
      "correct": "He said that he was tired.",
      "note": "**Talk** does not report exact words with a that-clause; use **say** or **tell**."
    },
    {
      "incorrect": "Do you talk English?",
      "correct": "Do you speak English?",
      "note": "For a language, use **speak**; **talk** is for conversation."
    }
  ],
