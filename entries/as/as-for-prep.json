    {
      "n": 1,
      "signpost": null,
      "definition": "used to move to a new person or thing that is connected with what was said before",
      "explanation": "**As for** usually comes at the start of a sentence, followed by a noun or pronoun and then a comma. It moves the attention to a new person or thing, often to compare it with the one just talked about.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
