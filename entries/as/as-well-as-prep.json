    {
      "n": 1,
      "signpost": null,
      "definition": "in addition to someone or something; and also",
      "explanation": "**As well as** joins two things of the same kind, such as two nouns, two adjectives, or two **-ing** forms. When the main verb is in a simple tense, an action after **as well as** is usually in the **-ing** form: *she teaches as well as writing books*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
        "domain": [],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "She speaks French as well as English.",
          "note": null,
          "pattern": null
        },
        {
          "text": "As well as running the store, he coaches the local team.",
          "note": null,
          "pattern": null
        },
        {
          "text": "The kitchen has a stove as well as a large oven.",
          "note": null,
          "pattern": null
        },
        {
          "text": "Sara plays the piano as well as the guitar.",
          "note": null,
          "pattern": null
        }
