  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Ask** takes the person directly, with no **to**: *ask your teacher*. Use **for** before a thing you want to be given (*ask for help*, *ask him for the keys*), but not before a question or a piece of information (*ask a question*, *ask the way*). With **a favor**, *ask someone a favor* and *ask someone for a favor* are both common.",
  "learner_errors": [
    {
      "incorrect": "Can I ask to you a question?",
      "correct": "Can I ask you a question?",
      "note": "The person you ask is a direct object; do not put **to** before it."
    },
    {
      "incorrect": "He asked me some money.",
      "correct": "He asked me for some money.",
      "note": "Use **for** before a thing you want someone to give you."
    },
    {
      "incorrect": "She asked me where did I live.",
      "correct": "She asked me where I lived.",
      "note": "In a reported question, the subject comes before the verb, with no **did**."
    }
  ],
