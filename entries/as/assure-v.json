  "synonym_discrimination": {
    "words": [
      "assure-v",
      "ensure-v",
      "insure-v"
    ],
    "note": "**Assure** in its main use is about words that take away worry, and its object is the person: *I assured her it was safe.* In its formal use (*assure success*) it is close to **ensure**, which is about making something happen: *Ensure the door is locked.* **Insure** is about paying for protection against loss: *We insured the house.*"
  },
