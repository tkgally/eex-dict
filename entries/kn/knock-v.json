  "synonym_discrimination": null,
  "usage_note": "**Knock on** and **knock at** a door both mean the same and are both common. Phrasal verbs with **knock** have their own entries: *knock down* (a building or a person), *knock out* (make unconscious, or remove from a competition), *knock over* (make something fall).",
  "learner_errors": [
    {
      "incorrect": "Someone knocked the door.",
      "correct": "Someone knocked on the door.",
      "note": "For hitting a door to be let in, use **knock on** or **knock at**; *knock the door* is not standard."
    },
    {
      "incorrect": "I knocked my head with the cupboard.",
      "correct": "I knocked my head on the cupboard.",
      "note": "The thing you hit by accident takes **on** or **against**."
    }
  ],
