  "adaptation": {
    "semantic": "Hitting a door to be let in and hitting something by accident are both \"knock\". Many languages use different verbs for these, and one for a loud repeated sound from an engine.",
    "grammar": "On a door, \"knock\" takes **on** or **at**, not a direct object: *knock on the door*.",
    "culture": "People in English-speaking countries usually knock before entering a closed room, even at home or in an office, and wait to hear *Come in*.",
    "false_friends": null,
    "pronunciation": "The **k** in \"knock\" is silent: it sounds like *nock*."
  },
