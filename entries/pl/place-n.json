  "synonym_discrimination": {
    "words": [
      "place-n",
      "space-n",
      "room-n"
    ],
    "note": "**Place** is a particular point or area (*a quiet place*). **Space** is an empty area that can be used (*a parking space*, *not enough space*). **Room** is uncountable when it means space for something (*Is there room for one more?*)."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "There is no more place in my bag.",
      "correct": "There is no more room in my bag.",
      "note": "For empty space that can be filled, use **room** or **space**, not **place**."
    },
    {
      "incorrect": "The concert will take part on Friday.",
      "correct": "The concert will take place on Friday.",
      "note": "**Take place** means happen; **take part** means join in an activity."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "**place** covers a location, a seat, a home, a chance to study, and a position in a race. Many languages use separate words for these; translate by sense.",
    "grammar": "*take place* means happen and has no passive: *the meeting took place*, never *was taken place*.",
