  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "a large amount or number, as much as is needed or more",
      "explanation": "**Plenty of** goes before both plural nouns (*plenty of chairs*) and uncountable nouns (*plenty of money*). **Plenty** can also stand alone when the noun is clear, or come before **to** and a verb (*plenty to eat*). It is used mostly in positive sentences; in questions and negatives, **enough** or **a lot** is more usual.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
        "domain": [],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "There's no need to hurry; we have plenty of time.",
          "note": null,
          "pattern": null
        },
        {
          "text": "Help yourself to more food. There's plenty.",
          "note": null,
          "pattern": null
        },
        {
          "text": "There's plenty to do in the city on a rainy day.",
          "note": null,
          "pattern": null
        },
        {
          "text": "\"Do you need more chairs?\" \"No, we have plenty, thanks.\"",
          "note": null,
          "pattern": null
        }
      ],
