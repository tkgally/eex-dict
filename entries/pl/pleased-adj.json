  "synonym_discrimination": {
    "words": [
      "pleased-adj",
      "glad-adj",
      "happy-adj"
    ],
    "note": "**Happy** is the general word and can go before a noun: *a happy child*, *I'm happy here*. **Glad** and **pleased** are used mostly after a verb, often about a particular event or result: *I'm glad you came*. **Glad** often shows relief (*I'm glad it's over*); **pleased** often shows satisfaction with a result or a person, and is a little more formal: *The teacher was pleased with our work*."
  },
  "usage_note": "**Pleased** is used mostly after a verb (*She was pleased*). Before a noun it goes mainly with words for a face or a voice (*a pleased smile*, *a pleased look*); say *a happy customer*, not *a pleased customer*. It is followed by **with**, **about**, **for**, a to-infinitive, or a that-clause.",
  "learner_errors": [
    {
      "incorrect": "I'm pleased of the result.",
      "correct": "I'm pleased with the result.",
      "note": "Use **with** or **about**, not **of**."
    },
    {
      "incorrect": "I'm very pleasing to meet you.",
      "correct": "I'm very pleased to meet you.",
      "note": "**Pleased** describes how you feel; **pleasing** describes what makes someone feel that way."
    }
  ],
