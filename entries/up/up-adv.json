  "synonym_discrimination": null,
  "usage_note": "When **up** is followed by a noun phrase (*up the hill*), it is a preposition, a separate entry. **Up** meaning *out of bed* or *finished* after **be** (*Are you up yet?*, *Time's up*) is an adjective use. With a phrasal verb, a pronoun object goes before **up**: *pick it up*, not after it. Many phrasal verbs use **up**, such as **give up**, **get up**, **look up**, and **make up**.",
  "learner_errors": [
    {
      "incorrect": "Can you pick up it?",
      "correct": "Can you pick it up?",
      "note": "A pronoun object goes between the verb and **up**: *pick it up*, *turn it up*."
    },
    {
      "incorrect": "Prices rose up by ten percent.",
      "correct": "Prices rose by ten percent.",
      "note": "**Rise** already means *go up*, so no **up** is needed after it."
    }
  ],
