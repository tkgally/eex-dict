  "synonym_discrimination": {
    "words": [
      "personal-adj",
      "private-adj"
    ],
    "note": "**Personal** stresses that something belongs to or concerns one person: *my personal opinion*, *a personal question*. **Private** stresses that something is not for other people to see, know, or use: *a private meeting*, *private property*. A **personal** question is about your life; a **private** conversation is one that others should not hear."
  },
  "usage_note": "Do not confuse **personal** with **personnel**, a noun for the people who work for a company or the department that deals with them: *the personnel department*.",
  "learner_errors": [
    {
      "incorrect": "Please send your form to the personal department.",
      "correct": "Please send your form to the personnel department.",
      "note": "**Personnel** is the noun for staff; **personal** is the adjective."
    }
  ],
