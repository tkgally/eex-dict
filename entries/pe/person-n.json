  "synonym_discrimination": {
    "words": [
      "person-n",
      "individual-n",
      "human-n"
    ],
    "note": "Person is the ordinary word for one human: a kind person, three people. Individual is formal, or stresses one person as separate from a group: the rights of the individual. Human, or human being, is used when people are contrasted with animals, machines, or gods: the first humans."
  },
  "usage_note": "The usual plural of person is people: three people, most people. Persons is used in formal and legal language and on official signs and notices: persons under eighteen, all persons present. In everyday speech and writing, use people. In job titles, -person replaces -man when the sex of the person is unknown or does not matter: chairperson, spokesperson.",
  "learner_errors": [
    {
      "incorrect": "There were five persons at the meeting.",
      "correct": "There were five people at the meeting.",
      "note": "People is the everyday plural; persons belongs to formal and legal language."
    },
    {
      "incorrect": "the person which called you",
      "correct": "the person who called you",
      "note": "Use who, or that, for a person; which is for things."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "The general sense translates easily. The grammar sense (first, second, third person) uses the same word in many languages but not all. The informal pattern a morning person, a dog person usually needs rephrasing as someone who likes mornings or dogs.",
    "grammar": "Countable, but the ordinary plural is people, not persons; persons belongs to legal and official language. They, their, and them are now the usual pronouns for a person of unknown or unstated sex: each person has their own key.",
    "culture": "Job titles ending in -man are now often replaced by -person forms (chairperson, spokesperson) or by neutral words (chair, firefighter), and a person whose sex is unknown or not stated is referred to as they.",
    "false_friends": "In some languages a word that looks like person can mean nobody in a negative sentence. English person is always a real human, and nobody is a separate word.",
    "pronunciation": "Stress on the first syllable, whose vowel is the same as in bird and word; the second syllable has a weak vowel: PER-sun. Do not stress the second syllable."
  },
