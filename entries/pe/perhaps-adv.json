  "synonym_discrimination": {
    "words": [
      "perhaps-adv",
      "maybe-adv",
      "possibly-adv"
    ],
    "note": "**Maybe** is the usual word in everyday speech, especially in American English: *Maybe we'll go tomorrow*. **Perhaps** is a little more formal and more common in writing and in British English: *Perhaps the letter was lost*. **Possibly** is a little more formal, and can suggest that you do not think the thing is very likely: *It could possibly rain, but I doubt it*."
  },
  "usage_note": "**Perhaps** usually starts the sentence, or comes after **be** or the first helping verb (*It will perhaps rain*), or before the main verb. No **that** follows it.",
  "learner_errors": [
    {
      "incorrect": "Perhaps that he will come.",
      "correct": "Perhaps he will come.",
      "note": "No **that** after **perhaps**; it is an adverb, not a verb like **think**."
    }
  ],
