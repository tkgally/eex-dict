  "synonym_discrimination": {
    "words": [
      "guilty-adj",
      "ashamed-adj"
    ],
    "note": "You feel **guilty** when you know you have done something wrong, whether or not anyone else knows (*I feel guilty about lying*). You feel **ashamed** when you think badly of yourself, often because other people know or might know (*ashamed of his behavior*)."
  },
  "usage_note": null,
