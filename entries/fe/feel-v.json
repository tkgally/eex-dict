  "synonym_discrimination": {
    "words": [
      "feel-v",
      "touch-v"
    ],
    "note": "**Touch** means to put your hand or body against something: *Don't touch the paint*. **Feel** means to touch something in order to learn what it is like, or to notice it through your skin: *Feel how soft it is*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I feel myself tired.",
      "correct": "I feel tired.",
      "note": "**Feel** + an adjective needs no **myself** or **yourself**."
    },
    {
      "incorrect": "I felt like to cry.",
      "correct": "I felt like crying.",
      "note": "**Feel like** is followed by an **-ing** form or a noun, not by **to**."
    },
    {
      "incorrect": "I feel boring at home on Sundays.",
      "correct": "I feel bored at home on Sundays.",
      "note": "After **feel**, use **bored**, **tired**, **interested** for how you feel; **boring** describes the thing that causes it."
    }
