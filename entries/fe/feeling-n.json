  "synonym_discrimination": {
    "words": [
      "feeling-n",
      "emotion-n"
    ],
    "note": "**Feeling** is the everyday word for what you experience inside (*a feeling of joy*) and is also used for sensations in the body. **Emotion** is a little more formal and is used for strong feelings such as love, fear, and anger: *She spoke with great emotion*."
  },
  "usage_note": null,
