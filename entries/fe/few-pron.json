  "synonym_discrimination": null,
  "usage_note": "Bare **few** says not enough; **a few** says a small but real number, the same split as with **little** and **a little**. **Few** used alone or with **of** is a pronoun; directly before a noun, it is a determiner (**[[few-det|few]]** *books*), a separate entry.",
  "learner_errors": [
    {
      "incorrect": "Only few showed interest, which pleased the organizers.",
      "correct": "Only a few showed interest, which pleased the organizers.",
      "note": "Bare **few**, standing alone, sounds negative; a small number reported in a positive way needs **a few**."
    }
  ],
