  "synonym_discrimination": {
    "words": [
      "fall-v",
      "drop-v"
    ],
    "note": "**Fall** is used when something goes down by itself: *The glass fell off the table*. **Drop** can mean the same, but it can also mean letting something fall: *I dropped the glass*. **Fall** never takes an object."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I fell the glass.",
      "correct": "I dropped the glass.",
      "note": "**Fall** has no object. To make something go down, use **drop** or **knock over**."
    },
    {
      "incorrect": "Yesterday I falled down.",
      "correct": "Yesterday I fell down.",
      "note": "The past tense is **fell** and the past participle is **fallen**."
    },
    {
      "incorrect": "I felt down the stairs.",
      "correct": "I fell down the stairs.",
      "note": "**Fell** is the past of **fall**; **felt** is the past of **feel**."
    }
  ],
