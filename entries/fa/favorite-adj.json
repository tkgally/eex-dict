  "synonym_discrimination": null,
  "usage_note": "Favorite already means best liked, so it is not made stronger: my favorite, not my most favorite. It is also a noun: Which is your favorite? In British spelling the word is favourite, and so is the noun.",
  "learner_errors": [
    {
      "incorrect": "my most favorite song",
      "correct": "my favorite song",
      "note": "Favorite already means liked best, so most adds nothing."
    }
  ],
