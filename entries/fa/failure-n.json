  "usage_note": "**Failure** is uncountable for not having success in general (*fear of failure*) and countable for one case of it (*one of his failures*). Calling a person *a failure* is strong and can hurt.",
  "learner_errors": [
    {
      "incorrect": "I had a failure in the exam.",
      "correct": "I failed the exam.",
      "note": "For an exam, English usually uses the verb: **fail an exam**."
    },
    {
      "incorrect": "Her failure of paying the bill caused problems.",
      "correct": "Her failure to pay the bill caused problems.",
      "note": "In the sense of not doing something, **failure** takes a **to** infinitive."
    }
  ],
