  "synonym_discrimination": {
    "words": [
      "famous-adj",
      "well-known-adj",
      "infamous-adj"
    ],
    "note": "**Famous** and **well-known** both mean that many people know about someone or something. **Famous** is stronger and is used for people and things known very widely, often in many countries (*a famous actor*). **Well-known** is often used for things known in one place or one group (*a well-known local doctor*). **Infamous** means known for something bad (*an infamous crime*), so it is not the opposite of **famous**."
  },
  "usage_note": "A person or place is **famous for** the thing that people know about (*famous for its beaches*) and **famous as** a kind of person (*famous as a writer*). The noun is **fame**: *She found fame at a young age.*",
  "learner_errors": [
    {
      "incorrect": "The city is famous by its old bridges.",
      "correct": "The city is famous for its old bridges.",
      "note": "Use **for** before the reason someone or something is known."
    },
    {
      "incorrect": "He is very famous among the world.",
      "correct": "He is famous all over the world.",
      "note": "Say **all over the world**, **around the world**, or **world famous**."
    }
  ],
