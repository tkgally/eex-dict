  "synonym_discrimination": {
    "words": [
      "favor-v",
      "prefer-v"
    ],
    "note": "**Prefer** is the everyday word for liking one thing more than another: *I prefer tea*. **Favor** is a little more formal and is especially common for plans, ideas, and choices made by groups: *Most voters favor the plan*. Only **favor** can mean treating someone better in an unfair way: *She favors her son*."
  },
  "usage_note": "The usual pattern for comparing is *favor something over something*: *They favor trains over planes*. Sense 2 is about unfair treatment, so *The teacher favors him* is a criticism. British English spells the word **favour**.",
  "learner_errors": [
    {
      "incorrect": "She favors to walk.",
      "correct": "She prefers to walk.",
      "note": "**Favor** is not followed by a to-infinitive; use **prefer**, or *favor walking*."
    },
    {
      "incorrect": "He favors tea than coffee.",
      "correct": "He favors tea over coffee.",
      "note": "Use **over** after **favor** to compare, not **than**."
    }
  ],
