  "adaptation": {
    "semantic": null,
    "grammar": "The verb with sense 1 is **do**: *do someone a favor*. Many languages use a verb like *make* here.",
    "culture": null,
    "false_friends": "In some languages a word like **favor** is part of the usual way to say *please*. In English, **favor** alone never means *please*; *do me a favor* is a request for help.",
