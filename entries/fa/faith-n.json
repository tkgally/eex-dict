  "synonym_discrimination": {
    "words": [
      "faith-n",
      "trust-n",
      "belief-n"
    ],
    "note": "**Trust** is a feeling, often based on experience, that someone is honest or will not hurt you: *trust between friends*. **Faith** is stronger and often needs no proof: *faith in God*, *blind faith*. **Belief** is the idea that something is true or exists: *a belief in ghosts*."
  },
  "usage_note": "In the sense of trust, **faith** is followed by **in**: *I have faith in you*.",
  "learner_errors": [
    {
      "incorrect": "I have faith on you.",
      "correct": "I have faith in you.",
      "note": "Use **in**, not **on**, after **faith**."
    },
    {
      "incorrect": "He has a strong faith to God.",
      "correct": "He has a strong faith in God.",
      "note": "Belief in a god also takes **in**."
    }
  ],
