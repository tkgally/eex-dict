  "synonym_discrimination": {
    "words": [
      "false-adj",
      "wrong-adj",
      "untrue-adj"
    ],
    "note": "**False** and **untrue** describe statements and beliefs that do not match the facts: *a false claim*, *That's untrue*. **Wrong** is used for mistakes and bad choices: *the wrong answer*, *the wrong bus*. Only **false** means *not real*: *false teeth*."
  },
  "usage_note": "**False** before a noun often means *not real* or *meant to trick*: *a false name* is a name that is not the person's own. After a verb it usually means *not true*: *The claim is false*.",
  "learner_errors": [
    {
      "incorrect": "I took the false bus.",
      "correct": "I took the wrong bus.",
      "note": "Use **wrong** for a mistake in choosing; **false** means not true or not real."
    }
  ],
  "etymology": null,
  "see_also": [
