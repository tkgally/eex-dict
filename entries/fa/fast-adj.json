  "synonym_discrimination": {
    "words": [
      "fast-adj",
      "quick-adj",
      "rapid-adj"
    ],
    "note": "**Fast** is used for speed of movement and for things that happen at speed: *a fast car*, *fast growth*. **Quick** is the usual word for something that takes only a short time: *a quick look*, *a quick shower*. **Rapid** is more formal and is common for change or growth: *rapid progress*."
  },
  "usage_note": "The adverb has the same form (*She runs fast*; see **fast** as an adverb). *Fast* about a clock means it shows a later time than the real one.",
  "learner_errors": [
    {
      "incorrect": "My watch is fast five minutes.",
      "correct": "My watch is five minutes fast.",
      "note": "The amount of time comes before **fast**."
    }
