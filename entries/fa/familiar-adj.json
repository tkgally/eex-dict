  "synonym_discrimination": null,
  "usage_note": "A thing is **familiar to** a person when the person recognizes it: *The street was familiar to me*. A person is **familiar with** a thing when they know it well: *I'm familiar with the rules*.",
  "learner_errors": [
    {
      "incorrect": "I'm familiar to this program.",
      "correct": "I'm familiar with this program.",
      "note": "A person is familiar **with** something; something is familiar **to** a person."
    },
    {
      "incorrect": "Her face is familiar for me.",
      "correct": "Her face is familiar to me.",
      "note": "Use **to**, not **for**, after **familiar** in this pattern."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "Two prepositions mark two directions: *familiar to someone* (known by them) and *familiar with something* (knowing it).",
    "culture": null,
    "false_friends": "In some languages a word like **familiar** means *connected with the family*. In English it means *known* or *knowing well*; for the family meaning, use **family** before a noun (*family life*).",
