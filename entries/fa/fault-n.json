  "synonym_discrimination": {
    "words": [
      "fault-n",
      "mistake-n",
      "error-n",
      "blame-n"
    ],
    "note": "**Fault** says who is responsible: *It's my fault*. A **mistake** is something done wrong: *I made a mistake*. An **error** is a mistake, in a more formal or technical style: *a spelling error*. **Blame** is the act of saying someone is responsible: *put the blame on someone*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I made a fault in my homework.",
      "correct": "I made a mistake in my homework.",
      "note": "You **make a mistake**; you do not **make a fault**."
    },
    {
      "incorrect": "It's not my fault of being late.",
      "correct": "It's not my fault that I'm late.",
      "note": "After **fault**, use a **that** clause, not **of** and an **-ing** form."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "In some languages one word covers both *mistake* and *responsibility for a mistake*. English uses **mistake** for the wrong action and **fault** for who is responsible.",
