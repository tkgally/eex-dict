  "synonym_discrimination": null,
  "usage_note": "**Impressed** describes the person who feels admiration; **impressive** describes the thing or person that causes it. *The show was impressive, and we were impressed.* The same pattern holds for **bored** and **boring**, **interested** and **interesting**.",
  "learner_errors": [
    {
      "incorrect": "I was very impressive by the show.",
      "correct": "I was very impressed by the show.",
      "note": "The person who feels admiration is **impressed**; the show is **impressive**."
    },
    {
      "incorrect": "We were impressed of his English.",
      "correct": "We were impressed by his English.",
      "note": "Use **by** or **with** after **impressed**, not **of**."
    }
  ],
