  "synonym_discrimination": {
    "words": [
      "impact-n",
      "effect-n",
      "influence-n"
    ],
    "note": "**Effect** is the general word for a change that something causes: *the effects of the medicine*. **Impact** suggests a strong or sudden effect: *a huge impact on the town*. **Influence** is a slower power, often hard to see, to change how someone thinks or acts: *her mother's influence*."
  },
  "usage_note": "The verb **impact** (*the change will impact sales*) is common in business English, but some careful writers prefer **affect** or **have an impact on**.",
  "learner_errors": [
    {
      "incorrect": "The rain had a big impact to the crops.",
      "correct": "The rain had a big impact on the crops.",
      "note": "Use **on** after **impact**."
    }
