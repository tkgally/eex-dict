  "synonym_discrimination": {
    "words": [
      "block-v",
      "prevent-v",
      "stop-v"
    ],
    "note": "**Block** means being or putting something in the way, physically or by a decision: *a tree blocked the road*, *they blocked the plan*. **Prevent** is more general and more formal, and means making sure something does not happen: *prevent accidents*. **Stop** is the everyday word, and it can also mean ending something that is already happening: *stop the car*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "The guard blocked us to go in.",
      "correct": "The guard blocked us from going in.",
      "note": "**Block someone from** is followed by an -ing form, not a to-infinitive."
    },
    {
      "incorrect": "The road was blocked from snow.",
      "correct": "The road was blocked by snow.",
      "note": "After the passive, the cause follows **by**."
    }
