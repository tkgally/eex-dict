  "synonym_discrimination": {
    "words": [
      "blame-n",
      "fault-n",
      "responsibility-n"
    ],
    "note": "Use **fault** to say who caused a problem, especially in *It's my fault* or *It's not your fault*. Use **blame** with verbs such as **take**, **get**, and **put on**: *She took the blame*. **Responsibility** is more formal and can also be for good things or for a duty: *Who has responsibility for the budget?*"
  },
  "usage_note": "**Blame** is uncountable and is usually used with **the**: *take the blame*, *the blame for the accident*. In *Who is to blame?* and *She is not to blame*, **blame** is the verb.",
  "learner_errors": [
    {
      "incorrect": "It's my blame.",
      "correct": "It's my fault.",
      "note": "After a possessive, English says **fault**, not **blame**: *my fault*, *your fault*."
    },
    {
      "incorrect": "They put the blame to the driver.",
      "correct": "They put the blame on the driver.",
      "note": "The blame is put **on** someone, and **for** something."
    }
  ],
