  "synonym_discrimination": null,
  "usage_note": "You **borrow** from the owner, and the owner **lends** to you: *I borrowed a chair from Lee, so Lee lent me a chair.* A library **lends** books, and readers **borrow** them. In its ordinary sense, **borrow** is for things you will give back; if you pay to use something for a time, you **rent** it.",
  "learner_errors": [
    {
      "incorrect": "Can you borrow me your pen?",
      "correct": "Can you lend me your pen?",
      "note": "**Borrow** is what the taker does; the giver **lends**. You can also say *Can I borrow your pen?*"
    },
    {
      "incorrect": "I borrowed the money to my friend.",
      "correct": "I lent the money to my friend.",
      "note": "The giver **lends**; the taker **borrows**, and borrows **from**."
    },
    {
      "incorrect": "I borrowed a bike and paid ten dollars for it.",
      "correct": "I rented a bike and paid ten dollars for it.",
      "note": "When you pay to use something, you **rent** it, even if you give it back afterward."
    }
  ],
  "etymology": null,
