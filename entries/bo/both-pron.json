  "synonym_discrimination": null,
  "usage_note": "**Both** used alone or with **of** is a pronoun; directly before a noun, with no **of**, it is a determiner (**[[both-det|both]]** *hands*), a separate entry. **Both** with a negative verb is easy to misread. To say that each of the two is not liked, use **either** or **neither**: *I don't like either of them*, *I like neither of them*.",
  "learner_errors": [
    {
      "incorrect": "Both of they are happy about the news.",
      "correct": "Both of them are happy about the news.",
      "note": "After **both of**, the object pronoun (**them**, **us**, **you**) is used, not the subject pronoun **they**."
    }
