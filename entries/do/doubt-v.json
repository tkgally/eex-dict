  "synonym_discrimination": null,
  "usage_note": "**I don't doubt that** and **there's no doubt that** mean the speaker is sure: *I don't doubt that you tried* means *I am sure you tried*. In a negative sentence or a question, **doubt** is usually followed by **that**, not **whether**.",
  "learner_errors": [
    {
      "incorrect": "I doubt that he took the money, because he was the only one in the room.",
      "correct": "I suspect that he took the money, because he was the only one in the room.",
      "note": "**Doubt** means you think it is probably not true; **suspect** means you think it probably is."
    },
    {
      "incorrect": "I doubt about his story.",
      "correct": "I doubt his story.",
      "note": "**Doubt** takes an object directly, with no **about**."
    }
  ],
