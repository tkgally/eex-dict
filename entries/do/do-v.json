  "synonym_discrimination": {
    "words": [
      "do-v",
      "make-v"
    ],
    "note": "Do is used for actions, tasks, and work in general, and for an activity that is not named exactly: do the dishes, do your homework, do something. Make is used when you create or produce a thing or a result: make a cake, make a plan, make a mistake. Learners meet this choice often, so it is worth learning common pairs by heart."
  },
  "usage_note": "Do is also the helper for short answers, question tags, and agreement: Do you like it? Yes, I do. You know Sam, don't you? So do I. When do is both helper and main verb, it appears twice: What do you do? (meaning what is your job).",
  "learner_errors": [
    {
      "incorrect": "I must make my homework.",
      "correct": "I must do my homework.",
      "note": "Use do for tasks and work; make is for creating or producing something."
    },
    {
      "incorrect": "I no like it.",
      "correct": "I don't like it.",
      "note": "Negatives of ordinary verbs in the present and past need the helper do."
    },
    {
      "incorrect": "Does she likes coffee?",
      "correct": "Does she like coffee?",
      "note": "After does or did, the main verb stays in its base form."
    }
  ],
  "etymology": null,
