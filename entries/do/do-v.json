  "synonym_discrimination": {
    "words": [
      "do-v",
      "make-v"
    ],
    "note": "**Do** is used for actions, tasks, and work in general, and for an activity that is not named exactly: *do the dishes*, *do your homework*, *do something*. **Make** is used when you create or produce a thing or a result: *make a cake*, *make a plan*, *make a mistake*. Learners meet this choice often, so it is worth learning common pairs by heart."
  },
  "usage_note": "**Do** is both a main verb and a helping verb, and the two often meet in one sentence: *What do you do?* (what is your job), *I didn't do it.* For **do** in questions, negatives, short answers, and emphasis (*Do you know?*, *I don't know*, *Yes, I do*), see the helping verb entry.",
  "learner_errors": [
    {
      "incorrect": "I must make my homework.",
      "correct": "I must do my homework.",
      "note": "Use **do** for tasks and work; **make** is for creating or producing something."
    },
    {
      "incorrect": "What do you do? I'm doing my homework.",
      "correct": "What are you doing? I'm doing my homework.",
      "note": "*What do you do?* asks about someone's job; to ask about the activity now, use *What are you doing?*"
    },
    {
      "incorrect": "I did a mistake.",
      "correct": "I made a mistake.",
      "note": "A few common nouns go with **make**, not **do**: *make a mistake*, *make a decision*, *make a noise*."
    }
  ],
