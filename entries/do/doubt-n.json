  "synonym_discrimination": null,
  "usage_note": "**No doubt** on its own usually means only *probably*: *no doubt you're tired* is a guess. To say that something is certain, use **without a doubt** or **there's no doubt that**: *there's no doubt that he's right*.",
  "learner_errors": [
    {
      "incorrect": "There is no doubt about that he is right.",
      "correct": "There is no doubt that he is right.",
      "note": "Put the **that**-clause straight after **no doubt**, with no **about**."
    },
    {
      "incorrect": "Excuse me, I have a doubt about the homework.",
      "correct": "Excuse me, I have a question about the homework.",
      "note": "In most varieties of English a **doubt** is a feeling of not being sure; for something you want explained, say **question**."
    }
