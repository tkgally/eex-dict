  "synonym_discrimination": null,
  "usage_note": "When **down** is followed by a noun phrase (*down the stairs*), it is a preposition, a separate entry. With a phrasal verb, a pronoun object goes before **down**: *write it down*, *turn it down*. Many phrasal verbs use **down**, such as **break down**, **calm down**, **let someone down**, and **turn something down**.",
  "learner_errors": [
    {
      "incorrect": "Please write down it.",
      "correct": "Please write it down.",
      "note": "A pronoun object goes before **down**: *write it down*."
    },
    {
      "incorrect": "The prices went down of ten percent.",
      "correct": "The prices went down by ten percent.",
      "note": "Use **by** to give the size of a fall."
    }
  ],
  "etymology": null,
