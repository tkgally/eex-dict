  "synonym_discrimination": null,
  "usage_note": "In sense 3, **keep** is followed by the **-ing** form, not by **to** and a base form: *keep trying*. **Keep on** doing something means the same and can sound more annoyed: *he keeps on asking*.",
  "learner_errors": [
    {
      "incorrect": "Keep to smile!",
      "correct": "Keep smiling!",
      "note": "In the sense *continue*, **keep** takes the **-ing** form, not **to** and a base form."
    },
    {
      "incorrect": "Keep attention to the road.",
      "correct": "Pay attention to the road.",
      "note": "English says **pay attention**, not **keep attention**."
    }
  ],
