  "synonym_discrimination": null,
  "usage_note": "Before another noun, as in *a key player* or *a key question*, **key** means very important; that use is the adjective **key**. For a lock or a way to succeed, the noun takes **to**: *the key to the door*, *the key to success*; a musical key takes **of**: *in the key of G*.",
  "learner_errors": [
    {
      "incorrect": "I lost the key of my room.",
      "correct": "I lost the key to my room.",
      "note": "Use **to** after **key** when you mean the thing it opens."
    },
    {
      "incorrect": "The key of success is practice.",
      "correct": "The key to success is practice.",
      "note": "Use *the key to something* in this sense too."
    }
  ],
