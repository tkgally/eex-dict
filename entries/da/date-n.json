  "adaptation": {
    "semantic": null,
    "grammar": null,
    "culture": "Date order differs: month-day in American English (*5/3* is May 3), day-month in British English (*5/3* is 5 March). In English-speaking countries going on *a date* usually means a romantic meeting.",
    "false_friends": "In English a **date** is a day or a romantic meeting. A meeting with a doctor, a bank, or a business is an **appointment**.",
