  "synonym_discrimination": null,
  "usage_note": "Dates are written and said differently in different countries. In American English the month usually comes first (*May 3*, said *May third*); in British English the day often comes first (*3 May*, said *the third of May*). Numbers alone, such as 3/5, can be read two ways, so many people write the month as a word. The sweet brown fruit called a **date** is a different word.",
  "learner_errors": [
    {
      "incorrect": "We have a date with the doctor on Monday.",
      "correct": "We have an appointment with the doctor on Monday.",
      "note": "A formal meeting with a doctor or a lawyer is an **appointment**; **a date** is usually romantic or social."
    }
  ],
