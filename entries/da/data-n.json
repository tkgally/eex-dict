  "synonym_discrimination": null,
  "usage_note": "**Data** is grammatically plural in origin, and some writers, especially in science, use a plural verb (*the data are clear*). In everyday English it is treated as uncountable with a singular verb (*the data is clear*), like **information**. In ordinary use it is not used with **a** and never adds **-s**; for one item, say *a piece of data* or *a data point*.",
  "learner_errors": [
    {
      "incorrect": "We collected many datas.",
      "correct": "We collected a lot of data.",
      "note": "**Data** does not add **-s**; use **a lot of** or **much** with it."
    },
    {
      "incorrect": "I need a data about the sales.",
      "correct": "I need some data about the sales.",
      "note": "In ordinary English **data** is not used with **a**; say **some data** or **a piece of data**."
    }
  ],
