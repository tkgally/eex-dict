  "synonym_discrimination": {
    "words": [
      "danger-n",
      "risk-n",
      "threat-n"
    ],
    "note": "**Danger** is the general word for a situation where harm is possible: *in danger*. **Risk** is the chance of something bad, often one that a person chooses to accept: *take a risk*. **Threat** is a person or thing likely to cause harm, or a warning that someone will cause harm: *a threat to peace*."
  },
  "usage_note": "**In danger** is a common phrase: *in danger* alone means at risk of harm, and **in danger of** + **-ing** means likely to have something bad happen (*in danger of losing his job*).",
  "learner_errors": [
    {
      "incorrect": "It is danger to swim here.",
      "correct": "It is dangerous to swim here.",
      "note": "After **be**, use the adjective **dangerous**; **danger** is a noun."
    },
    {
      "incorrect": "Children are in danger to get hurt.",
      "correct": "Children are in danger of getting hurt.",
      "note": "After **in danger**, use **of** + **-ing**."
    }
  ],
