  "synonym_discrimination": null,
  "usage_note": "With days of the week and dates, use **on**: *on Monday*, *on the day of the party*. Phrases such as *every day*, *the next day*, *one day*, and *the other day* take no preposition. **Every day** (two words) is an adverb phrase (*I walk every day*); **everyday** (one word) is an adjective meaning ordinary (*everyday clothes*).",
  "learner_errors": [
    {
      "incorrect": "I go to the gym everyday.",
      "correct": "I go to the gym every day.",
      "note": "As an adverb phrase, **every day** is two words; **everyday** is an adjective."
    },
    {
      "incorrect": "We met in the other day.",
      "correct": "We met the other day.",
      "note": "**The other day** takes no preposition."
    },
    {
      "incorrect": "I'll see you at Monday.",
      "correct": "I'll see you on Monday.",
      "note": "Days of the week take **on**."
    }
  ],
