  "adaptation": {
    "semantic": null,
    "grammar": "\"damage\" is uncountable: *a lot of damage*, not *a damage*. The plural **damages** means money a court orders someone to pay, which is a separate meaning; do not use it as the plural of the harm sense.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"damage\" has the stress on the first part, *DAM-ij*; the ending sounds like the end of **bridge**, not like **age**."
  },
