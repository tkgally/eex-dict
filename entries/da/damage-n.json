  "synonym_discrimination": {
    "words": [
      "damage-n",
      "harm-n",
      "injury-n"
    ],
    "note": "**Damage** is used for things (*damage to the car*) and also for health or a reputation (*damage to the lungs*). **Injury** is physical hurt to a person's or an animal's body: *a leg injury*. **Harm** is the most general word, often used when hurt might happen: *the medicine won't do you any harm*."
  },
  "usage_note": "**Damage** in its main senses is uncountable: *a lot of damage*, *some damage*, never *a damage* or *damages*. The plural **damages** exists only in law, for money paid. People are **injured**, not damaged; **damage** can be used for parts of the body (*liver damage*).",
  "learner_errors": [
    {
      "incorrect": "The storm caused many damages.",
      "correct": "The storm caused a lot of damage.",
      "note": "**Damage** is uncountable; **damages** means money paid by order of a court."
    },
    {
      "incorrect": "The fire made a big damage.",
      "correct": "The fire caused a lot of damage.",
      "note": "Use **cause** or **do** with **damage**, and no **a**."
    }
  ],
