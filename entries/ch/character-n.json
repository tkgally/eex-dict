  "synonym_discrimination": {
    "words": [
      "character-n",
      "personality-n"
    ],
    "note": "**Personality** is a person's usual way of feeling and behaving, especially as other people see it: lively, shy, or funny: *a warm personality*. **Character** covers all of a person's qualities, and is the usual word when moral qualities such as honesty and courage matter: *a man of good character*. **Character** is also used for places and things, where **personality** is not usual."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "My father has a bad character; he gets angry quickly.",
      "correct": "My father has a bad temper; he gets angry quickly.",
      "note": "For someone who gets angry easily, English says **bad temper**; **bad character** means dishonest or unkind."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": null,
    "culture": null,
    "false_friends": "\"character\": in some languages a similar word means *temper*. In English *a bad character* is a dishonest person, not someone who gets angry quickly; that is *a bad temper*.",
    "pronunciation": "\"character\": the **ch** is said like **k**, and the stress is on the first part: *KAIR-uk-ter*."
