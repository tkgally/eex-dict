  "synonym_discrimination": {
    "words": [
      "child-n",
      "kid-n",
      "baby-n",
      "toddler-n",
      "teenager-n"
    ],
    "note": "Child is the neutral word for a young person, and the one used in writing. Kid means the same but is informal and very common in speech: the kids are in bed. A baby cannot yet walk or talk, a toddler is just learning to walk, and a teenager is between thirteen and nineteen. Only child and kid also mean someone's son or daughter of any age."
  },
  "usage_note": "The plural is children, and the possessive of the plural is children's: the children's room. Child is the neutral word; in speech, kid is more common. Child covers roughly the years from birth to the early teens; a person from thirteen to nineteen is a teenager, though the law may still count them as a child.",
  "learner_errors": [
    {
      "incorrect": "There were many childs in the park.",
      "correct": "There were many children in the park.",
      "note": "The plural is children."
    },
    {
      "incorrect": "She has a children.",
      "correct": "She has a child.",
      "note": "Children is plural; the singular is child."
    },
    {
      "incorrect": "the childrens' toys",
      "correct": "the children's toys",
      "note": "Children is already plural, so the possessive adds apostrophe s."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages have different words for a young person (a child of six) and for someone's son or daughter (her children are all grown up). English uses child for both, so decide from the context which is meant.",
    "grammar": "The plural children is irregular and is already plural: three children, the children's toys, never childs, a children, or childrens. Child is countable and needs an article in the singular: a child, the child.",
    "culture": "The age at which a child legally becomes an adult varies by country and by purpose, such as voting, driving, or marriage. Kid is the everyday word in American speech and is not disrespectful.",
    "false_friends": null,
    "pronunciation": "The vowel is the long i of my, and the final d is pronounced: child rhymes with wild. The plural children has a short i in the first syllable, like chill, not the vowel of child."
  },
