  "synonym_discrimination": {
    "words": [
      "check-v",
      "examine-v",
      "inspect-v"
    ],
    "note": "**Check** is the everyday word for looking at something quickly to be sure about it: *check the oil*. **Examine** means look at something very carefully and in detail, often as an expert: *The doctor examined my knee*. **Inspect** means look at something officially to see that it follows the rules: *inspect a restaurant kitchen*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "The inspector controlled our tickets on the train.",
      "correct": "The inspector checked our tickets on the train.",
      "note": "In English, **control** means *have power over*; looking at tickets or documents is **check**."
    },
    {
      "incorrect": "Let me check if is it correct.",
      "correct": "Let me check if it is correct.",
      "note": "After **check if** or **check whether**, the words keep normal statement order."
    }
