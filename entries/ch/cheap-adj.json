  "synonym_discrimination": {
    "words": [
      "cheap-adj",
      "inexpensive-adj",
      "low-adj"
    ],
    "note": "**Cheap** describes things that cost little: *cheap shoes*; it can also suggest poor quality. **Inexpensive** means the same without that suggestion, so it is more polite in sales and in writing: *an inexpensive hotel*. For a price itself, use **low**: *low prices*, not *cheap prices* in careful English."
  },
  "usage_note": "Calling something cheap can suggest that it is badly made, so shops and hotels prefer **inexpensive**, **affordable**, or **good value**. In American English, calling a person **cheap** is rude.",
  "learner_errors": [
    {
      "incorrect": "The price is very cheap.",
      "correct": "The price is very low.",
      "note": "Things are cheap; prices are low."
    }
  ],
