  "synonym_discrimination": {
    "words": [
      "chance-n",
      "opportunity-n",
      "possibility-n"
    ],
    "note": "For a time when you can do something, use **chance** or the more formal **opportunity**: *a chance to travel*, *an opportunity to travel*. **Possibility** is not used this way: *the chance to study*, not *the possibility to study*. For how likely something is, use **chance** or **possibility**: *a good chance of rain*, *the possibility of rain*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I had the possibility to study abroad.",
      "correct": "I had the chance to study abroad.",
      "note": "For an opportunity to do something, English uses **chance** or **opportunity**, not **possibility**."
    },
    {
      "incorrect": "Good chance in your exam!",
      "correct": "Good luck in your exam!",
      "note": "To wish someone success, say **luck**, not **chance**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"chance\": many languages use different words for the possibility sense, the opportunity sense, and the luck sense; translate each sense on its own.",
    "grammar": null,
    "culture": null,
    "false_friends": "\"chance\": in some languages a similar word means *good luck*. In English **chance** is a possibility or an opportunity; to wish someone success, say *Good luck!*",
    "pronunciation": null
  },
