  "synonym_discrimination": {
    "words": [
      "choose-v",
      "pick-v",
      "select-v"
    ],
    "note": "**Choose** is the usual word for deciding which one you want: *choose a present*. **Pick** means the same but is less formal and often suggests a quick decision: *just pick one*. **Select** is formal and suggests careful choosing from many: *select the best photos from hundreds*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Yesterday I choosed a new phone.",
      "correct": "Yesterday I chose a new phone.",
      "note": "The past tense is **chose** and the past participle is **chosen**."
    },
    {
      "incorrect": "You have to choose between the red one or the blue one.",
      "correct": "You have to choose between the red one and the blue one.",
      "note": "**Choose between** takes **and**; **choose** alone can take **or**: *choose the red one or the blue one*."
    }
