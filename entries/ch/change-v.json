  "synonym_discrimination": {
    "words": [
      "change-v",
      "alter-v",
      "exchange-v"
    ],
    "note": "**Change** is the general word for making something different or replacing it: *We changed the plan*. **Alter** is more formal and usually means making a small change to something that stays the same thing: *alter a dress so it fits*. **Exchange** means giving one thing and getting another back: *exchange a shirt for a bigger size*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "We changed the train at the next station.",
      "correct": "We changed trains at the next station.",
      "note": "When one replaces another, **change** usually takes a plural noun with no **the**."
    },
    {
      "incorrect": "I'm going to change to my pajamas.",
      "correct": "I'm going to change into my pajamas.",
      "note": "You change **into** clothes, not **to** them."
    }
  ],
