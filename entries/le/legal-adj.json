  "usage_note": "Before a noun, **legal** can have either of its first two meanings, and the noun shows which: *legal drugs* and *legal parking* are allowed by the law, but *legal advice*, *legal problems*, and *a legal expert* have to do with the law and the courts.",
  "learner_errors": [
    {
      "incorrect": "He is working here legal.",
      "correct": "He is working here legally.",
      "note": "After a verb, use the adverb **legally**."
    },
    {
      "incorrect": "It is not legal smoking here.",
      "correct": "It is not legal to smoke here.",
      "note": "After **it is legal**, use **to** and the base form of the verb."
    }
