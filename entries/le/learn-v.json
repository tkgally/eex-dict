  "synonym_discrimination": {
    "words": [
      "learn-v",
      "study-v",
      "teach-v"
    ],
    "note": "**Study** is the activity of reading, practicing, and going to classes: *she studies every evening*. **Learn** is the result, getting the knowledge or the skill: *you can study a language for years and still not learn it well*. **Teach** is what the other person does: a teacher **teaches** you, and you **learn**."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Can you learn me English?",
      "correct": "Can you teach me English?",
      "note": "The person who gives the knowledge **teaches**; the person who gets it **learns**."
    },
    {
      "incorrect": "I learned English to my little sister.",
      "correct": "I taught English to my little sister.",
      "note": "**Learn** does not take the person taught as an object; use **teach**."
    }
  ],
