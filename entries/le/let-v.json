  "word_family": [],
  "synonym_discrimination": {
    "words": [
      "let-v",
      "allow-v",
      "permit-v"
    ],
    "note": "**Let** is the everyday word; it takes an object and a base form with no **to** (*let me go*), and it is not used in the passive. **Allow** takes **to** (*allow me to go*), sounds a little more formal, and is common in the passive: *you are not allowed to park here*. **Permit** is formal and used mainly for rules: *smoking is not permitted*."
  },
  "usage_note": "The past tense and past participle of **let** are both **let**: *she let me in yesterday*; *they have let the house*. Write **let's**, with an apostrophe, for *let us* (*let's go*); **lets** without one is only the form used after **he**, **she**, or **it**: *she lets her kids stay up late*.",
  "learner_errors": [
    {
      "incorrect": "Let me to explain.",
      "correct": "Let me explain.",
      "note": "After **let someone**, use a base form without **to**."
    },
    {
      "incorrect": "I was let to stay up late.",
      "correct": "I was allowed to stay up late.",
      "note": "**Let** is not used in the passive in this sense; use **be allowed to**."
    },
    {
      "incorrect": "Lets go to the park.",
      "correct": "Let's go to the park.",
      "note": "The suggestion form is **let's**, short for *let us*, with an apostrophe."
    }
  ],
