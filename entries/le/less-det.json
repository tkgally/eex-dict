  "synonym_discrimination": null,
  "usage_note": "In careful or formal writing, **fewer** is used before a plural countable noun (*fewer problems*) and **less** before an uncountable noun (*less trouble*). In everyday speech, many people use **less** with both (*less problems*); a reviewer or teacher may still mark this as an error, so learners preparing for formal writing should keep **fewer** for countable nouns.",
  "learner_errors": [
    {
      "incorrect": "There are less people here today.",
      "correct": "There are fewer people here today.",
      "note": "In careful writing, a countable plural noun takes **fewer**, not **less**."
    }
