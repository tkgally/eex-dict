  "synonym_discrimination": null,
  "usage_note": "Lend has two patterns: lend someone something (lend me your pen) and lend something to someone (lend your pen to Sam). When the thing is a pronoun, use the second: lend it to me, not lend me it. In American English loan is also common as a verb, especially for money: the bank loaned us the money.",
  "learner_errors": [
    {
      "incorrect": "Can I lend your pen?",
      "correct": "Can I borrow your pen?",
      "note": "Lend is what the giver does; the person who takes borrows."
    },
    {
      "incorrect": "He lent the money from the bank.",
      "correct": "He borrowed the money from the bank.",
      "note": "Lend is never used with from; the receiver borrows from."
    },
    {
      "incorrect": "Could you lend to me your car?",
      "correct": "Could you lend me your car?",
      "note": "The person comes right after lend, with no to; to is used only when the thing comes first: lend your car to me."
    }
  ],
