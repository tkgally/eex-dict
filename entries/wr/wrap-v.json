  "adaptation": {
    "semantic": null,
    "grammar": "\"wrap\" uses **in** for the material and **around** for the thing that is surrounded: *wrap the gift in paper*, *wrap the paper around the gift*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"wrap\": the **w** is silent; the word sounds the same as **rap**."
  },
