  "synonym_discrimination": null,
  "usage_note": "**Wrap** takes **in** before the material (*wrap it in paper*) and **around** before the thing that is surrounded (*wrap a towel around your hair*). British English also uses **round**. For finishing a job or a meeting, English uses the phrasal verb **wrap up**.",
  "learner_errors": [
    {
      "incorrect": "She wraped the box.",
      "correct": "She wrapped the box.",
      "note": "Double the **p** before **-ed** and **-ing**: **wrapped**, **wrapping**."
    },
    {
      "incorrect": "She wrapped a scarf her neck.",
      "correct": "She wrapped a scarf around her neck.",
      "note": "When **wrap** means put something around a person or thing, say what goes around with **around**."
    }
  ],
