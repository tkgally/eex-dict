  "synonym_discrimination": null,
  "usage_note": "In American English **write** someone is common for sending a letter or message (*write me soon*); British English usually says **write to** someone. With two objects, both varieties say *write someone a letter*.",
  "learner_errors": [
    {
      "incorrect": "I have wrote three pages.",
      "correct": "I have written three pages.",
      "note": "The past participle is **written**, with double **t**."
    },
    {
      "incorrect": "She is writting a letter.",
      "correct": "She is writing a letter.",
      "note": "**Writing** has one **t**; only **written** has two."
    },
    {
      "incorrect": "Write your answer with pencil.",
      "correct": "Write your answer in pencil.",
      "note": "Use **in** before the tool or color (*in pencil*, *in ink*, *in red*); use **with** only with **a** (*with a pencil*)."
    }
  ],
