  "adaptation": {
    "semantic": null,
    "grammar": "\"write\" can take two objects (*write someone a letter*). With only the person, American English allows *write me*, but British English usually needs **to**: *write to me*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"write\": the **w** is silent; the word sounds the same as **right**."
