  "synonym_discrimination": {
    "words": [
      "mind-n",
      "brain-n"
    ],
    "note": "**Brain** is the organ inside your head, and it is the word for intelligence in informal use: *She has a good brain.* **Mind** is the thinking, feeling, and remembering that the brain makes possible, and it is the word for thoughts, attention, and decisions: *What's on your mind?*, *I changed my mind.* Doctors operate on the **brain**, never the **mind**."
  },
  "usage_note": "The idioms of this entry use a possessive that matches the subject: *I changed my mind*, *she made up her mind*. The verb **mind** (*Do you mind if I sit here?*, *Never mind*) is a separate entry.",
  "learner_errors": [
    {
      "incorrect": "I decided my mind to stay.",
      "correct": "I made up my mind to stay.",
      "note": "You **make up** your mind; **decide** does not take **mind** as its object."
    },
    {
      "incorrect": "In my mind, the plan is too expensive.",
      "correct": "In my opinion, the plan is too expensive.",
      "note": "To give an opinion, say *in my opinion* or *to my mind*. *In my mind* means in my thoughts or imagination: *In my mind, I was already on the beach.*"
    }
  ],
