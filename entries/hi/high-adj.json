  "synonym_discrimination": {
    "words": [
      "high-adj",
      "tall-adj"
    ],
    "note": "**Tall** is used for people, trees, and narrow things such as towers (*a tall man*, *a tall tree*). **High** is used for mountains, walls, and things far above the ground (*a high wall*, *a high shelf*), and for amounts and levels (*high prices*)."
  },
  "usage_note": "A measurement goes before **high**: *two meters high*. In *fly high* and *jump high*, **high** is an adverb.",
  "learner_errors": [
    {
      "incorrect": "My brother is very high.",
      "correct": "My brother is very tall.",
      "note": "Use **tall** for people."
    },
    {
      "incorrect": "The prices here are expensive.",
      "correct": "The prices here are high.",
      "note": "A price is **high**; the thing you buy is **expensive**."
    }
  ],
