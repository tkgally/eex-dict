  "synonym_discrimination": {
    "words": [
      "game-n",
      "match-n",
      "sport-n"
    ],
    "note": "A **sport** is a physical activity with rules, done by many people: *Tennis is a popular sport*. A **game** is any activity with rules (*a card game*), and also one occasion of playing (*a basketball game*). For one occasion of a sport, British English more often says **match** (*a football match*) and American English more often says **game**, though both use **match** for tennis."
  },
  "usage_note": "You **play** a game; you do not **do** one. *Make up a game* or *invent a game* means create a new one. For a single sports event, **game** is usual in American English for most team sports and **match** is common in British English.",
  "learner_errors": [
    {
      "incorrect": "Let's do a game.",
      "correct": "Let's play a game.",
      "note": "The verb used with **game** is **play**."
    },
    {
      "incorrect": "We made a game of cards.",
      "correct": "We played a game of cards.",
      "note": "Use **play** with **a game of something**."
    }
  ],
