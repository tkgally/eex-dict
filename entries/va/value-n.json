  "synonym_discrimination": {
    "words": [
      "value-n",
      "worth-n",
      "price-n",
      "cost-n"
    ],
    "note": "The **price** is what a seller asks: *The price is $20*. The **cost** is what you pay or spend: *the cost of living*. **Value** is what something is really worth, in money or importance: *the value of the house*. **Worth** is close to **value** and often follows an amount: *ten dollars' worth of food*."
  },
  "usage_note": "In the money sense **value** is often countable when a particular amount is meant (*a value of $500*) and uncountable for the idea in general (*Land gains value*). The beliefs sense is plural: *family values*, *our values*.",
  "learner_errors": [
    {
      "incorrect": "This car is a good value of money.",
      "correct": "This car is a good value for the money.",
      "note": "Use **for**, not **of**. British English says **good value for money**."
    },
    {
      "incorrect": "He has a good value.",
      "correct": "He has good values.",
      "note": "For beliefs about what is right, use the plural **values**."
    }
  ],
