  "synonym_discrimination": null,
  "usage_note": "**Agree** does not take a direct object for an opinion: say **I agree with you**, not **I agree you**. In British English, **agree** can also take a direct object when people decide something together, as in **agree a price**; American English normally adds **on**: **agree on a price**.",
  "learner_errors": [
    {
      "incorrect": "I am agree.",
      "correct": "I agree.",
      "note": "**Agree** is a full verb, not an adjective; do not put **be** before it."
    },
    {
      "incorrect": "I agree you.",
      "correct": "I agree with you.",
      "note": "Agreeing with a person's opinion needs **with**: **agree with someone**."
    }
  ],
