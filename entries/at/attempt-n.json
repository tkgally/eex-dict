  "synonym_discrimination": {
    "words": [
      "attempt-n",
      "try-n",
      "effort-n"
    ],
    "note": "**Try** is the everyday word, often in *have a try* or *give it a try*: *Let me have a try*. **Attempt** is more formal and is often used for something difficult, or something that did not work: *a failed attempt*. **Effort** puts the stress on the work or energy that something needs: *It took a lot of effort to move the piano*."
  },
  "usage_note": "**Attempt** is followed by a to-infinitive (*an attempt to escape*) or by **at** and a noun or an -ing form (*an attempt at escaping*, *an attempt at humor*). You **make** an attempt; you do not *do* one.",
  "learner_errors": [
    {
      "incorrect": "She made an attempt of climbing the wall.",
      "correct": "She made an attempt to climb the wall.",
      "note": "Use a to-infinitive or **at** after **attempt**, not **of**."
    },
    {
      "incorrect": "I did an attempt to fix it.",
      "correct": "I made an attempt to fix it.",
      "note": "The verb that goes with **attempt** is **make**."
    }
  ],
