  "synonym_discrimination": null,
  "usage_note": "**Attend** meaning *go to* is a little formal and takes a direct object with no preposition: *attend a meeting*. In speech, *go to a meeting* is more usual. **Attend to** is a different sense: it means *deal with*.",
  "learner_errors": [
    {
      "incorrect": "I attended to the meeting yesterday.",
      "correct": "I attended the meeting yesterday.",
      "note": "When **attend** means *go to*, there is no **to**. **Attend to** means *deal with*."
    },
    {
      "incorrect": "I'm attending for the bus.",
      "correct": "I'm waiting for the bus.",
      "note": "**Attend** does not mean **wait**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "*Attend a meeting* (go to it) has no preposition; *attend to a problem* (deal with it) needs **to**.",
    "culture": null,
    "false_friends": "In some languages a similar-looking verb means *wait* or *serve a customer*. English **attend** means *go to* an event or, with **to**, *deal with* something.",
    "pronunciation": null
  },
