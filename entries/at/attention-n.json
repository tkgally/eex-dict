  "synonym_discrimination": null,
  "usage_note": "**Attention** is uncountable: *pay attention*, *a lot of attention*, never *an attention*. As a word called out to a group, *Attention, please!* asks people to listen to an announcement.",
  "learner_errors": [
    {
      "incorrect": "Pay attention on the teacher.",
      "correct": "Pay attention to the teacher.",
      "note": "The preposition after **attention** is **to**."
    },
    {
      "incorrect": "Attention! There's a car coming.",
      "correct": "Watch out! There's a car coming.",
      "note": "To warn someone of danger, English says **Watch out!** or **Be careful!**, not **Attention!**"
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"attention\" is uncountable and takes **to**: *pay attention to the road*. The verb that goes with it is **pay**.",
    "culture": null,
    "false_friends": "In some languages a similar word is shouted as a warning of danger. In English, **Attention!** asks people to listen, or is an order to soldiers; the warning is **Watch out!** or **Be careful!**",
    "pronunciation": "\"attention\": stress on the second part, *uh-TEN-shun*. The **ti** is said like **sh**."
  },
