  "synonym_discrimination": null,
  "usage_note": "**My** never changes for number: *my book*, *my books*. It stands alone as an exclamation of surprise (*My, that's a big dog!*); this interjection use is a separate entry. The independent possessive, used without a following noun, is a different word, **mine** (*this is mine*).",
  "learner_errors": [
    {
      "incorrect": "This book is my.",
      "correct": "This book is mine.",
      "note": "Without a following noun, use **mine**; **my** always needs a noun after it."
    }
