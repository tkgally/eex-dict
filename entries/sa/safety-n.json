  "synonym_discrimination": {
    "words": [
      "safety-n",
      "security-n"
    ],
    "note": "**Safety** is about not being hurt, especially by accidents: *road safety*, *safety glasses*. **Security** is about being protected from people who might cause harm, such as thieves or attackers: *airport security*, *a security guard*. A fire exit is for **safety**; a lock on the door is for **security**."
  },
  "usage_note": null,
