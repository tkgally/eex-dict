  "synonym_discrimination": {
    "words": [
      "safe-adj",
      "secure-adj"
    ],
    "note": "**Safe** is the everyday word for not being in danger or not being dangerous: *a safe place to play*. **Secure** stresses that something is well protected or firmly fixed, so it cannot be attacked, stolen, or moved: *a secure building*, *a secure password*. A person feels **secure** when they feel confident and not worried about the future."
  },
  "usage_note": "**Safe** is also a noun, a strong metal box with a lock for keeping money and valuable things in; this is a separate entry.",
  "learner_errors": [
    {
      "incorrect": "This street is not safety at night.",
      "correct": "This street is not safe at night.",
      "note": "**Safety** is a noun; after **be**, use the adjective **safe**."
    },
    {
      "incorrect": "We were safe of the rain in the car.",
      "correct": "We were safe from the rain in the car.",
      "note": "The preposition after **safe** for a danger is **from**."
    }
  ],
