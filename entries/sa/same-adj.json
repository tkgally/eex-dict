  "synonym_discrimination": {
    "words": [
      "same-adj",
      "similar-adj",
      "identical-adj"
    ],
    "note": "**The same** means not different at all, or one thing and not another: *the same school*, *the same as mine*. **Similar** means alike in some ways but not in every way: *a similar color*. **Identical** stresses that two things are exactly alike in every detail: *identical twins*."
  },
  "usage_note": "Compare with **as**, not **like** or **than**: *the same as yours*. **The same** standing alone, as in *I'll have the same*, is a pronoun; that use is a separate entry.",
  "learner_errors": [
    {
      "incorrect": "My bag is same like yours.",
      "correct": "My bag is the same as yours.",
      "note": "Use **the** before **same**, and **as** after it."
    },
    {
      "incorrect": "She is a same age as me.",
      "correct": "She is the same age as me.",
      "note": "**Same** takes **the**, never **a**."
    }
  ],
