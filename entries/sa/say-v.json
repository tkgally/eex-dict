  "synonym_discrimination": {
    "words": [
      "say-v",
      "tell-v",
      "speak-v",
      "talk-v"
    ],
    "note": "**Say** is for the words themselves, and the person spoken to takes **to** (*She said hello to everyone*). **Tell** takes the person as its object and is used for giving information, stories, and orders (*She told me the news.* *Tell him to wait.*). **Speak** is for using your voice or a language, and for a serious or formal exchange (*He spoke softly.* *Do you speak English?* *I must speak to the manager.*). **Talk** is for a conversation between people (*We talked for hours.*). **Say** and **tell** usually center on a message, though it can be left implicit (*What did she say?* *Tell me!*); **speak** and **talk** can be used with no message at all, for the ability or act of talking itself (*He can't speak.* *They talked all evening.*)."
  },
  "usage_note": "After a quotation, the verb can come before a noun subject (*\"Fine,\" said Kim*) but a pronoun comes before the verb (*\"Fine,\" she said*). In writing, **said** is the ordinary reporting verb and does not need to be replaced by fancier verbs. In speech, *Sorry, what did you say?* is the normal way to ask someone to repeat something. Before a number or an example, as in *Meet me at, say, six*, **say** is an adverb (see **say** adverb).",
  "learner_errors": [
    {
      "incorrect": "He said me that he was tired.",
      "correct": "He told me that he was tired.",
      "note": "**Say** never takes the person as its object; use **tell**, or *say it to me*."
    },
    {
      "incorrect": "She said me hello.",
      "correct": "She said hello to me.",
      "note": "The person spoken to takes **to** after **say**."
    },
    {
      "incorrect": "He said that \"I am tired.\"",
      "correct": "He said, 'I am tired.'",
      "note": "Direct speech does not take **that**; either quote the exact words or report them: *He said that he was tired.*"
    }
  ],
  "etymology": null,
  "see_also": [
    {
      "slug": "say-adv",
      "note": null
    }
  ],
  "adaptation": {
    "semantic": "**Say** and **tell** often translate to one verb. In English the difference is mostly grammatical: **say** goes with the words or the message, **tell** with the person receiving it. **Say** is also used for what signs and writing show uses that many languages give to other words.",
    "grammar": "**Say** takes direct speech, a that-clause, or a question-word clause. *Say to do something* reports an order; *tell someone to do something* is more common.",
    "culture": null,
