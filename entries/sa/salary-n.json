  "synonym_discrimination": null,
  "usage_note": "A **salary** is usually paid to people in offices and professions and is talked about as an amount for a year, even when it is paid every week or every month. Pay that is counted by the hour or the day is usually called a **wage**. For the difference between **pay**, **salary**, **wage**, and **income**, see the entry for **pay**.",
  "learner_errors": [
    {
      "incorrect": "He gets a salary of fifteen dollars an hour.",
      "correct": "He is paid fifteen dollars an hour.",
      "note": "An hourly rate is not usually called a **salary**: say how much someone is paid or earns an hour, or call it a **wage**."
    },
    {
      "incorrect": "My salary is very cheap.",
      "correct": "My salary is very low.",
      "note": "Amounts of money are **high** or **low**; things you buy are **cheap**."
