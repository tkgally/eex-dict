  "synonym_discrimination": {
    "words": [
      "barely-adv",
      "hardly-adv",
      "scarcely-adv"
    ],
    "note": "All three mean *almost not*. **Hardly** is the most common and the most general (*I hardly know her*), and it is the usual choice before **any** and **ever** (*hardly anyone*, *hardly ever*). **Barely** stresses that something only just happened or was only just enough: *we barely caught the train*. **Scarcely** means the same as **hardly** but is more formal."
  },
  "usage_note": "**Barely** is about something that only just happens or is only just enough; for how often something happens, **rarely** or **hardly ever** is the usual choice: *I hardly ever go out*. In standard English, because **barely** is already negative, it takes **any** and **anything**, not **no** and **nothing**: *there was barely any food*.",
  "learner_errors": [
    {
      "incorrect": "I couldn't barely see.",
      "correct": "I could barely see.",
      "note": "**Barely** already has a negative meaning, so it is not used with **not**."
    },
    {
      "incorrect": "There was barely nothing left.",
      "correct": "There was barely anything left.",
      "note": "After **barely**, use **any** and **anything**, not **no** and **nothing**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "**Barely** often means that something did happen, but only just (*we barely won*), while a word for *almost not* in other languages may suggest that it did not happen. Check which one the sentence means.",
    "grammar": "**Barely** makes the sentence negative in meaning, so in standard English no other negative word is added: *I could barely move*. It takes **any**, not **no**.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Two syllables with the stress on the first: *BAIR-lee*. The **e** after **bar** is silent."
  },
