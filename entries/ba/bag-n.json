  "synonym_discrimination": null,
  "usage_note": "In American English a woman's bag for money, keys, and so on is often called a **purse**. In British English it is a **handbag**, and a **purse** is a small bag for coins.",
  "learner_errors": [
    {
      "incorrect": "I need a bag of plastic.",
      "correct": "I need a plastic bag.",
      "note": "Put the material before **bag**: *a plastic bag*, *a paper bag*. **A bag of something** means a bag that holds it: *a bag of rice*."
    }
  ],
