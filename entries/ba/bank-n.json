  "synonym_discrimination": {
    "words": [
      "bank-n",
      "shore-n",
      "coast-n",
      "beach-n"
    ],
    "note": "A **bank** is the ground at the edge of a river, a stream, or a lake. The **shore** is the land at the edge of the sea or a large lake, where it meets the water. The **coast** is the land beside the sea, thought of as an area: *a town on the coast*. A **beach** is the sand or small stones at the edge of the sea or a lake, where people swim and sit."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I went to bank to get some money.",
      "correct": "I went to the bank to get some money.",
      "note": "**Bank** is countable and needs **the** or **a**."
    }
  ],
  "etymology": {
    "text": "Both main senses go back to an old Germanic word for a bench or a raised edge. The money sense came through Italian, where a *banca* was the bench or table at which a money changer did business; the river sense came from an old Scandinavian word for a raised edge of ground or a hill.",
    "sources_consulted": [
      "Wiktionary",
      "Online Etymology Dictionary"
    ],
    "checked": "2026-09-16"
  },
