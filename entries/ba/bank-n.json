  "synonym_discrimination": {
    "words": [
      "bank-n",
      "shore-n",
      "coast-n",
      "beach-n"
    ],
    "note": "A bank is the ground at the edge of a river, a stream, or a lake. The shore is the land at the edge of the sea or a large lake, where it meets the water. The coast is the whole area of land beside the sea, seen from far away or on a map: a town on the coast. A beach is the sand or small stones at the edge of the sea, where people swim and sit."
  },
  "usage_note": "Money is in the bank; you go to the bank and open an account at or with a bank. The people who work there are bank staff or bank clerks, and the person in charge is the manager. Bank holiday is British for a public holiday and has nothing to do with banks being open.",
  "learner_errors": [
    {
      "incorrect": "We sat on a bank in the park.",
      "correct": "We sat on a bench in the park.",
      "note": "In several languages a look-alike word means a seat; English bank never does."
    },
    {
      "incorrect": "I went to bank to get some money.",
      "correct": "I went to the bank to get some money.",
      "note": "Bank is countable and needs the or a."
    }
  ],
  "etymology": {
    "text": "Both main senses go back to an old Germanic word for a bench or a raised edge. The money sense came through Italian, where a banca was the bench or table at which a money changer did business; the river sense came from an old Scandinavian word for a raised edge of ground or a hill.",
    "sources_consulted": [
      "Wiktionary",
      "Online Etymology Dictionary"
    ],
    "checked": "2026-09-16"
  },
  "see_also": [
    {
      "slug": "account-n",
      "note": null
    },
    {
      "slug": "loan-n",
      "note": null
    }
  ],
  "adaptation": {
    "semantic": "The money bank, the river bank, and the store (blood bank) are separate words in most languages; translate each sense on its own. A bank of screens or lights is usually a word for row.",
    "grammar": "Bank is countable: the bank, a bank. Money is in the bank, and you go to the bank; you have an account at or with a bank.",
    "culture": "In English-speaking countries a bank account is the normal way to be paid a wage and to pay bills, so the word appears in many everyday phrases: bank card, bank transfer, bank statement.",
    "false_friends": "In several European languages a look-alike word means a bench or a seat, and in some a sofa; in English bank is never a seat.",
    "pronunciation": "The n is pronounced ŋ, as in sing, because it comes before k, so bank rhymes with thank and drank."
  },
