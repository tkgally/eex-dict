  "usage_note": "**Basically** is spelled with **-ally** after **basic**, as with most adjectives ending in **-ic**: *basic*, *basically*; *tragic*, *tragically*. The middle **a** is not pronounced.",
  "learner_errors": [
    {
      "incorrect": "He is basicly a good man.",
      "correct": "He is basically a good man.",
      "note": "Adjectives ending in **-ic** usually add **-ally**, not **-ly**; **publicly** is the main exception."
    }
  ],
