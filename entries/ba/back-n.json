  "synonym_discrimination": null,
  "usage_note": "**At the back of** means in the part farthest from the front: *at the back of the room*. In American English **in back of** can also mean *behind*: *the car in back of us*. **Back** in *come back* or *give it back* is a different word, the adverb, which has its own entry.",
  "learner_errors": [
    {
      "incorrect": "I sat on the back of the class.",
      "correct": "I sat at the back of the class.",
      "note": "Use **at the back of** (or **in the back of**) for the rear part of a room or a vehicle. **On the back of** is for a surface: *on the back of a card*."
    },
    {
      "incorrect": "I have a back pain.",
      "correct": "I have back pain.",
      "note": "**Back pain** is usually uncountable, so it takes no **a**. **Backache** is also used."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages use different words for the body part, the rear part of a place, and the other side of a flat thing. English uses **back** for all three; translate each sense separately.",
