  "synonym_discrimination": null,
  "usage_note": "With a phrasal verb, a pronoun object goes before **back**: *give it back*, *bring them back*. A noun object may go before or after it: *give back the money*, *give the money back*. **Return** already includes the meaning of **back**, so *come back* and *return* are used, but not both together.",
  "learner_errors": [
    {
      "incorrect": "I'll return back tomorrow.",
      "correct": "I'll come back tomorrow.",
      "note": "**Return** already means come or go back, so **back** after it repeats the idea; say *come back* or *return*."
    },
    {
      "incorrect": "Give me back it.",
      "correct": "Give it back to me.",
      "note": "A pronoun object goes before **back**: *give it back*."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages use one word for *returning*, another for *behind*, and another for *in reply*; English **back** covers all three (*come back*, *step back*, *call back*). Translate each sense separately.",
    "grammar": "With a pronoun, the order is fixed: *give it back*, *put them back*. With a noun, both orders are possible: *put back the chair*, *put the chair back*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "One syllable. The **a** is the open sound of **cat**, and the **ck** is one **k** sound."
  },
