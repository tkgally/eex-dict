  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "used after a number from one to twelve to give the time when it is exactly that hour",
      "explanation": "O'clock is used only for whole hours: six o'clock, not six thirty o'clock, and only with the 12-hour clock: three o'clock in the afternoon, not fifteen o'clock. It can be left out when the meaning is clear: at six, at nine in the morning. It is not used together with a.m. or p.m.: six a.m., or six o'clock in the morning.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [
          "not gradable"
        ],
        "patterns": []
      },
      "labels": {
