  "synonym_discrimination": null,
  "usage_note": "**To** before the base form of a verb (*I want to go*) is the sign of the infinitive, not a preposition, and is not covered here. In some phrases, **to** is a preposition and is followed by a noun or an **-ing** form: *look forward to seeing you*, *get used to living alone*.",
  "learner_errors": [
    {
      "incorrect": "I went to home early.",
      "correct": "I went home early.",
      "note": "**Home** after a verb of movement takes no **to**."
    },
    {
      "incorrect": "Can you explain me the problem?",
      "correct": "Can you explain the problem to me?",
      "note": "**Explain** needs **to** before the person."
    },
    {
      "incorrect": "I look forward to see you.",
      "correct": "I look forward to seeing you.",
      "note": "In **look forward to**, **to** is a preposition, so it is followed by an **-ing** form."
    }
  ],
