  "synonym_discrimination": {
    "words": [
      "too-adv",
      "also-adv",
      "either-adv"
    ],
    "note": "**Too** usually goes at the end of a clause: *I like it too*. **Also** usually goes before the main verb or after **be**: *I also like it*. In negative sentences, use **either** at the end: *I don't like it either*."
  },
  "usage_note": "Do not confuse **too** with **to** and **two**. **Too** with an adjective usually means *more than is good or possible*: *too hot to drink* means you cannot drink it.",
  "learner_errors": [
    {
      "incorrect": "It is too much hot today.",
      "correct": "It is too hot today.",
      "note": "Use **too** alone before an adjective; **too much** goes before an uncountable noun."
    },
    {
      "incorrect": "I don't like it too.",
      "correct": "I don't like it either.",
      "note": "In negative sentences, use **either**, not **too**."
    },
    {
      "incorrect": "The food was too good; I loved it.",
      "correct": "The food was very good; I loved it.",
      "note": "To say only that something was very good, use **very** or **really**; **too** means *more than is good or wanted*."
    }
