  "synonym_discrimination": {
    "words": [
      "top-n",
      "lid-n",
      "cap-n"
    ],
    "note": "**Top** is the general word for a cover that closes a container: *the top of the bottle*. A **lid** is a cover for a box, a pot, or a jar, often one you lift off: *the lid of the pan*. A **cap** is a small top, often one that screws on: *a pen cap*."
  },
  "usage_note": "Before another noun, as in *the top shelf* or *a top player*, **top** is the adjective entry. The noun is used mainly with **the** and **of**: *the top of the hill*.",
  "learner_errors": [
    {
      "incorrect": "Write your name in the top of the page.",
      "correct": "Write your name at the top of the page.",
      "note": "Use **at the top of** for a position."
    }
  ],
