  "synonym_discrimination": {
    "words": [
      "problem-n",
      "trouble-n",
      "issue-n",
      "difficulty-n"
    ],
    "note": "**Problem** is the general word and is countable: *a problem*, *two problems*. **Trouble** is usually uncountable: *We had some trouble with the car*, not *a trouble*. **Issue** sounds more polite and is common at work: *There's an issue with your order*. **Difficulty** is a little more formal and often means how hard something is: *She had difficulty breathing*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I have problem with my computer.",
      "correct": "I have a problem with my computer.",
      "note": "**Problem** is countable, so it needs *a* or a plural."
    },
    {
      "incorrect": "I had problems to find the hotel.",
      "correct": "I had problems finding the hotel.",
      "note": "After *have a problem* or *have problems*, use the *-ing* form, not *to*."
    }
