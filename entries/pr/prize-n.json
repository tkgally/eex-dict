  "synonym_discrimination": {
    "words": [
      "prize-n",
      "award-n",
      "reward-n"
    ],
    "note": "A **prize** is given to the winner of a competition or a game of chance: *first prize in a race*. An **award** is given, often officially, for an achievement or good work over time: *an award for bravery*. A **reward** is given in return for something useful you have done, such as helping or finding something: *a reward for finding a lost dog*."
  },
  "usage_note": "Before another noun, **prize** is an adjective meaning *good enough to win prizes* or *most valued* (*a prize cow*, *her prize possession*); see **prize** (adjective).",
  "learner_errors": [
    {
      "incorrect": "He won a price in the competition.",
      "correct": "He won a prize in the competition.",
      "note": "A **price** is the money you pay; a **prize** is what you win. **Prize** ends with a *z* sound."
    }
