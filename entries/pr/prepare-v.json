  "synonym_discrimination": null,
  "usage_note": "In everyday speech, **get ready** is more common than **prepare** when people are talking about themselves: *Get ready, we're leaving!* **Prepare** is a little more formal and is usual when work is needed (*prepare a report*, *prepare a meal*). **Be prepared to** do something means be willing or ready to do it (*I'm prepared to wait*); see **prepared**.",
  "learner_errors": [
    {
      "incorrect": "prepare the exam",
      "correct": "prepare for the exam",
      "note": "When you study for a test, use **prepare for**; *prepare the exam* means write the test, as a teacher does."
    },
    {
      "incorrect": "We prepared to the trip.",
      "correct": "We prepared for the trip.",
      "note": "The event you get ready for comes after **for**, not **to**."
    }
  ],
