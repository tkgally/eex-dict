  "synonym_discrimination": {
    "words": [
      "previous-adj",
      "last-adj",
      "former-adj"
    ],
    "note": "**Last** is the everyday word for the one just before now: *my last job*, *last week*. **Previous** is a little more formal. It can count back from now (*previous experience*, *the previous owner*), but with words of time such as **week** and **year** it usually counts back from another time: *the previous day* is the day before that day. **Former** describes what someone or something used to be: *a former teacher* is not a teacher now."
  },
  "usage_note": "To count back from now with words of time, use **last**: *last week*, *last year*. *The previous week* usually means the week before another time you are talking about, often in a story: *She had arrived the previous week*.",
  "learner_errors": [
    {
      "incorrect": "I visited them in the previous week.",
      "correct": "I visited them last week.",
      "note": "Counting back from now, use **last**, with no **the** or **in**."
    }
  ],
