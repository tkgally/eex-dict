  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "a word such as **in**, **on**, **at**, or **from** that goes before a noun or pronoun to show place, time, direction, or a similar connection",
      "explanation": "A **preposition** is followed by its object: a noun (*on the table*), a pronoun in its object form (*with me*), or an **-ing** form (*before leaving*). The right preposition often depends on the word before it (*interested in*, *afraid of*), so it is best learned together with that word.",
      "grammar": {
        "countability": "countable",
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
