        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "In the phrase \"under the bed,\" the preposition is \"under.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "English has many prepositions of place and time.",
          "note": null,
          "pattern": null
        },
        {
          "text": "In everyday English, a question can end with a preposition: \"Who are you talking to?\"",
          "note": null,
          "pattern": null
        }
