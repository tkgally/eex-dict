  "synonym_discrimination": {
    "words": [
      "promise-v",
      "swear-v",
      "guarantee-v"
    ],
    "note": "**Promise** is the everyday verb for saying you will certainly do something: *I promise to help*. **Swear** is stronger and more serious, as if before a judge or God: *I swear I didn't take it*. **Guarantee** is often used for products and services or for results someone is sure of: *we guarantee delivery within two days*."
  },
  "usage_note": "**Promise** often takes a **that**-clause with **will** or **would**: *I promise I'll be there* (the **that** is often left out). To report a promise made in the past, **would** is usual: *She promised she would help*. *Promise you won't laugh* is a common way to ask someone for a promise.",
  "learner_errors": [
    {
      "incorrect": "I promise you to come.",
      "correct": "I promise I'll come.",
      "note": "With a person after **promise**, use a **that**-clause; without a person, *promise to come* is also correct."
    },
    {
      "incorrect": "He promised to me that he would help.",
      "correct": "He promised me that he would help.",
      "note": "The person comes right after **promise**, with no **to**, before a **that**-clause."
    },
    {
      "incorrect": "I promise I come tomorrow.",
      "correct": "I promise I'll come tomorrow.",
      "note": "When the promise is about the future, use **will** in the clause."
    }
  ],
