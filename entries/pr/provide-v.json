  "synonym_discrimination": {
    "words": [
      "provide-v",
      "supply-v",
      "give-v"
    ],
    "note": "**Give** is the everyday word: *She gave me a pen*. **Provide** is more formal and is used when someone makes something available because it is needed: *The hotel provides towels*. **Supply** is used for large amounts delivered again and again, often in business: *The farm supplies milk to three shops*."
  },
  "usage_note": "**Provided** and **providing**, with or without **that**, are also used like **if** to mean *only if*: *You can go out, provided that you finish your homework first*.",
  "learner_errors": [
    {
      "incorrect": "They provided us books.",
      "correct": "They provided us with books.",
      "note": "With the person first, use **with** before the thing: **provide someone with something**, or **provide something for someone**."
    }
  ],
