  "synonym_discrimination": null,
  "usage_note": "**Probably** is stronger than **perhaps** or **maybe**: it says you think something is more likely than not. As a short answer, *Probably* means *yes, I think so*, and *Probably not* means *I don't think so*.",
  "learner_errors": [
    {
      "incorrect": "He will not probably come.",
      "correct": "He probably won't come.",
      "note": "Put **probably** before **won't** (*He probably won't come*), or between **will** and **not** (*He will probably not come*)."
    },
    {
      "incorrect": "Probably that she knows.",
      "correct": "She probably knows.",
      "note": "No **that** after **probably**; say **It is probable that she knows** or use **probably** before the verb."
    }
