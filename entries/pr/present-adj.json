  "synonym_discrimination": null,
  "usage_note": "Where **present** stands changes its meaning. After a noun, or after **be** or a similar verb, it means *here* (sense 1): *the members present* are the members who are in the room. Before a noun, it means *now* (sense 2): *the present members* are the members at this time.",
  "learner_errors": [
    {
      "incorrect": "The present people at the meeting agreed.",
      "correct": "The people present at the meeting agreed.",
      "note": "In the sense *here*, put **present** after the noun."
    }
  ],
