  "synonym_discrimination": null,
  "usage_note": "**Print out** is the usual phrasal verb for making a paper copy of something from a computer (*print out the form*); **print** alone is also common in this use (*print the form*). A request to *please print* on a form asks for separate capital or small letters, not joined handwriting.",
  "learner_errors": [
    {
      "incorrect": "Can you print me this page?",
      "correct": "Can you print this page for me?",
      "note": "**Print** is not normally used with two objects; use **for** + the person."
    }
  ],
