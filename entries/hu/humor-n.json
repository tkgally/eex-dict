  "synonym_discrimination": {
    "words": [
      "humor-n",
      "wit-n",
      "comedy-n"
    ],
    "note": "**Humor** is the general word for whatever makes people laugh: *a story full of humor*. **Wit** is quick, clever humor with words: *she answered with wit*. **Comedy** is a movie, play, or show meant to make people laugh, or the funny side of a situation: *a romantic comedy*."
  },
  "usage_note": "British English spells the word **humour**, but **humorous** has no **u** after the **o** in either spelling.",
  "learner_errors": [
    {
      "incorrect": "He has a good humor.",
      "correct": "He has a good sense of humor.",
      "note": "To praise someone's ability to enjoy what is funny, say **a sense of humor**."
    },
    {
      "incorrect": "She told us some funny humors.",
      "correct": "She told us some funny jokes.",
      "note": "**Humor** is uncountable; one funny story is **a joke**."
    }
