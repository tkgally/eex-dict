  "usage_note": "Use **arrive in** with a city, a country, or a large area (*arrive in the city*, *arrive in a new country*), **arrive at** with a building, a station, or an event (*arrive at the airport*, *arrive at the party*), and no preposition with **home**, **here**, and **there**.",
  "learner_errors": [
    {
      "incorrect": "We arrived to the hotel at six.",
      "correct": "We arrived at the hotel at six.",
      "note": "**Arrive** is followed by **at** or **in**, never **to**."
    },
    {
      "incorrect": "She arrived to home late.",
      "correct": "She arrived home late.",
      "note": "**Home**, **here**, and **there** take no preposition after **arrive**."
    }
