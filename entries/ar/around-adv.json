  "synonym_discrimination": {
    "words": [
      "around-adv",
      "about-adv",
      "approximately-adv"
    ],
    "note": "Before a number, **around** and **about** both mean *not exactly*: *around fifty people*, *about fifty people*. Both are common everywhere. **Approximately** means the same but is more formal and is used mostly in writing and with measurements: *approximately three kilometers*."
  },
  "usage_note": "When **around** is followed by a noun phrase (*around the table*), it is a preposition, a separate entry. Many phrasal verbs use **around**, such as **turn around**, **look around**, and **hang around**. In British English **round** is often used for the circle, turning, and place senses: *turn round*, *show someone round*.",
  "learner_errors": [
    {
      "incorrect": "Let me show around you.",
      "correct": "Let me show you around.",
      "note": "With **show**, the person comes straight after the verb and **around** comes last: *show someone around*."
    },
    {
      "incorrect": "It costs around about twenty dollars.",
      "correct": "It costs around twenty dollars.",
      "note": "**Around** and **about** both mean *not exactly*, so one of them is enough."
    }
  ],
  "etymology": null,
  "see_also": [
    {
