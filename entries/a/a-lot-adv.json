  "synonym_discrimination": null,
  "usage_note": "**A lot** is common in speech and in most writing; in very formal writing, **much**, **very much**, or **often** is sometimes preferred. **Lots** is more informal and is used mainly before words that compare (*lots better*) and in *thanks lots*. Before a noun, use **a lot of** (see **lot** as a noun).",
  "learner_errors": [
    {
      "incorrect": "I a lot like this song.",
      "correct": "I like this song a lot.",
      "note": "**A lot** goes after the verb and its object."
    },
    {
      "incorrect": "I like it very.",
      "correct": "I like it a lot.",
      "note": "**Very** cannot stand alone after a verb; use **a lot** or **very much**."
    },
    {
      "incorrect": "Thanks alot.",
      "correct": "Thanks a lot.",
      "note": "**A lot** is always two words."
    }
  ],
