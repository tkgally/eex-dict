  "synonym_discrimination": null,
  "usage_note": "In American English a person **runs for** an office or **runs in** an election; in British English a person also **stands for** election. **Election** is countable for a single event (*an election*, *the elections*) and uncountable in the sense of being chosen (*since her election*).",
  "learner_errors": [
    {
      "incorrect": "The government will make an election next year.",
      "correct": "The government will hold an election next year.",
      "note": "Use **hold** or **have** with **election**, not **make**."
    },
    {
      "incorrect": "He won the elections of mayor.",
      "correct": "He won the election for mayor.",
      "note": "Say **the election for** a position, or **the mayoral election**."
    }
