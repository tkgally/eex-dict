    {
      "n": 1,
      "signpost": null,
      "definition": "used after words such as **someone**, **nothing**, **where**, and **who** to mean *other*, *different*, or *more*",
      "explanation": "**Else** comes after the word it changes, not before it: after words like **someone**, **anything**, **everybody**, and **nothing**, after question words (*who else*, *what else*, *where else*, *how else*), and after **little** and **much** (*there was little else to do*). The possessive adds **'s** to **else**: *someone else's coat*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [
          "not gradable"
        ],
        "patterns": []
      },
      "labels": {
