  "usage_note": "**During** is a preposition and is followed by a noun (*during the movie*); **while** is a conjunction and is followed by a clause with its own subject and verb (*while the movie was playing*).",
  "learner_errors": [
    {
      "incorrect": "I fell asleep during she was talking.",
      "correct": "I fell asleep while she was talking.",
      "note": "**During** takes a noun, not a clause; use **while** before a subject and verb."
    },
    {
      "incorrect": "We waited during two hours.",
      "correct": "We waited for two hours.",
      "note": "**During** names the period something happens in and answers **when**; **for** gives a length of time and answers **how long**."
    }
