  "usage_note": "**Due to** before a noun means *because of* (the preposition **due to**); **be due to** before a verb means *be expected to*: *The plane is due to land at noon*.",
  "learner_errors": [
    {
      "incorrect": "The homework is due to Friday.",
      "correct": "The homework is due on Friday.",
      "note": "A day or date after **due** takes **on**, or in American English no preposition (*due Friday*), never **to**."
    }
