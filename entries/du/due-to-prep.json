    {
      "n": 1,
      "signpost": null,
      "definition": "because of someone or something",
      "explanation": "**Due to** is common after **be** (*the delay was due to the weather*) and also at the start of a sentence. It is a little more formal than **because of** and is common in notices and news.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
