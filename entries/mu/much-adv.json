  "synonym_discrimination": null,
  "usage_note": "**Much** goes after the verb and its object, not between them: *I like tea very much*. Before an ordinary adjective, use **very**, not **much**: *very hot*, but *much hotter*.",
  "learner_errors": [
    {
      "incorrect": "I like very much football.",
      "correct": "I like football very much.",
      "note": "**Very much** goes after the object, not between the verb and the object."
    },
    {
      "incorrect": "It's much hot today.",
      "correct": "It's very hot today.",
      "note": "**Much** goes before comparatives (*much hotter*), not before ordinary adjectives."
    }
  ],
