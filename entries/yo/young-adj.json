  "synonym_discrimination": {
    "words": [
      "young-adj",
      "youthful-adj"
    ],
    "note": "**Young** says that someone has lived only a short time: *a young child*. **Youthful** describes the look, energy, or feeling of being young, often in someone who is not young, and is approving: *a youthful sixty-year-old*."
  },
  "usage_note": "**The young** means young people in general: *music for the young*. **Younger** and **youngest** often describe brothers and sisters: *my younger sister*, *the youngest child*. Age in years is given with **be** and **old**: *She is ten years old*.",
  "learner_errors": [
    {
      "incorrect": "My sister is more young than me.",
      "correct": "My sister is younger than me.",
      "note": "Use **younger** and **youngest**, not **more young** and **most young**."
    }
  ],
