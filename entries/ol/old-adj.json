  "synonym_discrimination": null,
  "usage_note": "Old can sound blunt when it describes a person. Older is gentler (an older woman, older people), and elderly is polite and a little formal. Age is given with be: she is ten, she is ten years old. The old means old people in general: care for the old.",
  "learner_errors": [
    {
      "incorrect": "I have ten years old.",
      "correct": "I am ten years old.",
      "note": "Age is given with be, not have."
    },
    {
      "incorrect": "a ten-years-old boy",
      "correct": "a ten-year-old boy",
      "note": "Before a noun the phrase is joined with hyphens and year has no s."
    },
    {
      "incorrect": "my old brother",
      "correct": "my older brother",
      "note": "My old brother would mean a former brother or, with affection, my dear brother; for age use older or big."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "English uses one word for a person's age, for things that are not new, for former things, and for long friendships; most languages need three or four words, and the age question (how old) is often asked with a verb meaning have.",
    "grammar": "Age is expressed with be, not have, and the noun years comes before old: she is ten years old, not she has ten years. Before a noun the pattern is a ten-year-old girl, with hyphens and no plural.",
    "culture": "In much of the English-speaking world it is felt to be rude to ask an adult's age; how old are you is asked of children. Older or elderly is used of people in polite speech.",
    "false_friends": null,
    "pronunciation": "The vowel is the long o of go (oʊ in American, əʊ in British), followed by l and d with no vowel between them."
  },
