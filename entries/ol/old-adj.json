  "synonym_discrimination": null,
  "usage_note": "**Old** can sound blunt when it describes a person. **Older** is gentler (*an older woman*, *older people*), and **elderly** is polite and a little formal. **The old** means old people in general: *care for the old*.",
  "learner_errors": [
    {
      "incorrect": "I have ten years old.",
      "correct": "I am ten years old.",
      "note": "Age is given with **be**, not **have**."
    },
    {
      "incorrect": "a ten-years-old boy",
      "correct": "a ten-year-old boy",
      "note": "Before a noun the phrase is joined with hyphens and **year** has no **s**."
    },
    {
      "incorrect": "my old brother",
      "correct": "my older brother",
      "note": "**Old** alone describes age in general, not who was born first; use **older** for a sibling."
    }
  ],
