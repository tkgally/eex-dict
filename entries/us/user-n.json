  "synonym_discrimination": null,
  "usage_note": "**User** is very common in computing and technology: *user name*, *user account*, *the user guide*. In a compound the thing used comes first: *a phone user*. With **of**, the thing used takes an article or is plural: *a user of the library*, *users of smartphones*.",
  "learner_errors": [
    {
      "incorrect": "The users of internet are increasing.",
      "correct": "The number of internet users is increasing.",
      "note": "Put the thing used before **user** (*internet users*), or use an article after **of** (*users of the internet*)."
    }
  ],
