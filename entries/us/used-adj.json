  "synonym_discrimination": null,
  "usage_note": "**Be used to** and **get used to** are followed by a noun or an *-ing* form: *I'm used to driving*, not *I'm used to drive*. Do not confuse them with **used to** before a base form, which talks about the past (*I used to drive to work*); see **[[used-to-modal|used to]]**.",
  "learner_errors": [
    {
      "incorrect": "I'm used to get up early.",
      "correct": "I'm used to getting up early.",
      "note": "After **be used to**, use an *-ing* form or a noun."
    },
    {
      "incorrect": "I used to the noise now.",
      "correct": "I'm used to the noise now.",
      "note": "Use **be used to** or **get used to**; **be** or **get** cannot be left out."
    }
  ],
