  "synonym_discrimination": null,
  "usage_note": "The noun and the verb are spelled the same but sound different: the noun ends with an **s** sound (*the use of it*), the verb with a **z** sound (*use it*). **It's no use** is followed by **-ing**: *It's no use trying*, not *no use to try*.",
  "learner_errors": [
    {
      "incorrect": "It's no use to try again.",
      "correct": "It's no use trying again.",
      "note": "After **no use**, use the **-ing** form."
    },
    {
      "incorrect": "This machine is very use.",
      "correct": "This machine is very useful.",
      "note": "**Use** is a noun; the adjective is **useful**."
    },
    {
      "incorrect": "Is this of any useful?",
      "correct": "Is this of any use?",
      "note": "After **of any**, use the noun **use**."
    }
  ],
