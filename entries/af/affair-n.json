  "synonym_discrimination": null,
  "usage_note": "In the plural, **affairs** usually means matters of public business (*foreign affairs*, *current affairs*, that is, news about politics and the world) or a person's private matters (*my financial affairs*). In the singular, *my affair* or *a private affair* means something that concerns only one person. **An affair** can also mean a secret sexual relationship (*have an affair*), so be careful in conversation.",
  "learner_errors": [
    {
      "incorrect": "I have many affairs to do today.",
      "correct": "I have a lot of things to do today.",
      "note": "**Affairs** means public or private matters in general, not tasks; for a list of jobs, use **things** or **tasks**."
    }
  ],
