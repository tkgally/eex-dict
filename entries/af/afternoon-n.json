  "adaptation": {
    "semantic": "\"afternoon\" runs from about midday until the evening, which starts around five or six o'clock or when it gets dark. Some languages divide the day at other times or have one word for the afternoon and the evening; translate by the clock time.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"afternoon\": the main stress is on the last part, *af-ter-NOON*."
  },
