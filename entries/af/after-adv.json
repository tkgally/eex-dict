  "synonym_discrimination": null,
  "usage_note": "As an adverb, **after** usually comes at the end of a phrase, often after a time word: *the day after*, *soon after*. Followed by a noun it is a preposition (*after lunch*), and followed by a clause it is a conjunction (*after we ate*); these are separate entries. At the start of a sentence, **afterward** (British **afterwards**) or **after that** is more usual than **after** alone.",
  "learner_errors": [
    {
      "incorrect": "After, we went to the park.",
      "correct": "Afterward, we went to the park.",
      "note": "At the start of a sentence, **afterward** or **after that** is more usual than **after** alone."
    }
  ],
