  "synonym_discrimination": null,
  "usage_note": "**Afraid**, **scared**, and **frightened** are close in meaning. **Scared** is the most common in speech; **frightened** and **scared** can both come before a noun (*a frightened child*, *a scared child*), but **afraid** cannot. Only **afraid** is used in the polite phrase *I'm afraid*.",
  "learner_errors": [
    {
      "incorrect": "I'm afraid from spiders.",
      "correct": "I'm afraid of spiders.",
      "note": "The preposition after **afraid** is **of**."
    },
    {
      "incorrect": "an afraid child",
      "correct": "a frightened child",
      "note": "**Afraid** is used only after a verb such as **be**; before a noun use **frightened** or **scared**."
    },
    {
      "incorrect": "I afraid to go out at night.",
      "correct": "I'm afraid to go out at night.",
      "note": "**Afraid** is an adjective, not a verb, so it needs **be**: *I am afraid*, *she was afraid*."
    }
  ],
  "etymology": null,
