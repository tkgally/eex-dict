  "synonym_discrimination": null,
  "usage_note": "**Affect** is nearly always a verb, meaning to influence or change something. A separate, specialized noun **affect** (an observable emotional state) belongs to psychology and psychiatry, not everyday use. The everyday noun that pairs with the verb **affect** is spelled **effect**.",
  "learner_errors": [
    {
      "incorrect": "The medicine has no affect.",
      "correct": "The medicine has no effect.",
      "note": "**Affect** is a verb; the everyday noun is **effect**."
    },
    {
      "incorrect": "It will effect our plans.",
      "correct": "It will affect our plans.",
      "note": "**Effect** is occasionally a formal verb meaning bring about (*effect change*), but the everyday verb meaning influence is **affect**."
    }
