      "incorrect": "In the end of the month I'll be on vacation.",
      "correct": "At the end of the month I'll be on vacation.",
      "note": "Use **at the end of** before a noun; **in the end** alone means finally."
    },
    {
      "incorrect": "The film has a happy end.",
      "correct": "The film has a happy ending.",
      "note": "The way a story or film finishes is its **ending**."
    }
