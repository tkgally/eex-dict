  "synonym_discrimination": {
    "words": [
      "end-n",
      "ending-n",
      "finish-n"
    ],
    "note": "**End** is the last part of something or the point where it stops (*the end of the film*, *the end of the war*). **Ending** is the way a story, a film, or a word ends (*a happy ending*, *a surprise ending*). **Finish** is mainly the end of a race or a competition (*a close finish*)."
  },
  "usage_note": null,
  "learner_errors": [
