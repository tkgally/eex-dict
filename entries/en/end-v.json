  "synonym_discrimination": {
    "words": [
      "end-v",
      "finish-v",
      "stop-v"
    ],
    "note": "**Finish** is used most for completing a task or activity, and can be followed by an **-ing** form: *I finished eating*. **End** is used for events, periods, and situations that reach their last point: *the war ended*; it is not followed by an **-ing** form. **Stop** means an action does not go on, even if it is not complete: *the rain stopped*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I ended reading the book last night.",
      "correct": "I finished reading the book last night.",
      "note": "**End** is not followed by an **-ing** form; use **finish**."
    },
    {
      "incorrect": "The concert ended in ten o'clock.",
      "correct": "The concert ended at ten o'clock.",
      "note": "Use **at** for a time; **end in** is for a result, such as *end in failure*."
    }
  ],
