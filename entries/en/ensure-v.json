  "synonym_discrimination": {
    "words": [
      "ensure-v",
      "insure-v",
      "assure-v"
    ],
    "note": "**Ensure** means make certain that something happens: *Ensure that the door is locked.* **Insure** means pay for protection against loss or damage: *We insured the car.* In American English **insure** is sometimes also used to mean **ensure**. **Assure** means tell someone firmly that something is true so that they stop worrying, and it takes the person as its object: *I assure you it's safe.*"
  },
  "usage_note": "In conversation people usually say *make sure*; **ensure** is more common in writing and in instructions.",
