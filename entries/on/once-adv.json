  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Once** for one time is used in the pattern *once a week*, *once a month*, with **a**; *once per week* is also correct but more formal. *Twice* means two times; from three on, English says *three times*, *four times*. **Once** that joins two clauses (*Once you finish, call me*) is a conjunction, in the entry **once** (conjunction). *Once upon a time*, the opening of children's stories, is in the entry for **time**.",
  "learner_errors": [
    {
      "incorrect": "I go there one time in a week.",
      "correct": "I go there once a week.",
      "note": "For frequency, use **once**, **twice**, or a number with **times**, and **a** before the period of time."
    },
    {
      "incorrect": "I have been to the zoo one time.",
      "correct": "I have been to the zoo once.",
      "note": "**One time** is possible in informal American English, but **once** is the usual word."
    }
  ],
