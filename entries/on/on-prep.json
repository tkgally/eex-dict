  "synonym_discrimination": {
    "words": [
      "at-prep",
      "in-prep",
      "on-prep"
    ],
    "note": "For place, **at** picks out a point (*at the door*), **in** a space with edges around it (*in the kitchen*), and **on** a surface or a line such as a street or a coast (*on the table*, *on the coast*). For time, **at** goes with clock times (*at six*), **on** with days and dates (*on Monday*), and **in** with longer periods such as months, years, and parts of the day (*in June*, *in the morning*)."
  },
  "usage_note": "**On** with no noun after it (*Put your coat on*) is an adverb, and **on** meaning *working* or *happening* (*The light is on*, *Is the party still on?*) is an adjective; this entry covers only the preposition. Phrasal verbs such as **depend on**, **get on**, and **go on** have their own entries.",
  "learner_errors": [
    {
      "incorrect": "I'll call you in Monday.",
      "correct": "I'll call you on Monday.",
      "note": "Days of the week and dates take **on**; **in** is for months and years."
    },
    {
      "incorrect": "We left on the morning.",
      "correct": "We left in the morning.",
      "note": "Parts of the day take **in**, but the part of a named day takes **on**: *on Monday morning*."
    },
    {
      "incorrect": "She is on the car.",
      "correct": "She is in the car.",
      "note": "A car or a taxi takes **in**; a bus, a train, or a plane takes **on**."
    }
  ],
  "etymology": null,
