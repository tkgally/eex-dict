  "adaptation": {
    "semantic": null,
    "grammar": "Many languages show this meaning with a verb form or a short particle; English needs the two-word pronoun after the verb or preposition: *they wrote to one another*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The stress falls on the middle part of **another**: *wun uh-NUTH-er*. The **th** is the sound of **this**, not of **thin**."
