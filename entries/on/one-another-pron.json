      "n": 1,
      "signpost": null,
      "definition": "used when each of two or more people or things does something to the other or others",
      "explanation": "**One another** is used only as an object, after a verb or a preposition, never as a subject, and the subject must be plural. The possessive is **one another's**.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
