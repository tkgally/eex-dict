  "synonym_discrimination": null,
  "usage_note": "**One another** and **each other** mean the same. Some writers keep **one another** for groups of more than two, but most people use the two freely; **one another** is a little more formal.",
  "learner_errors": [
    {
      "incorrect": "We often call us.",
      "correct": "We often call one another.",
      "note": "For an action that goes both ways, use **one another** or **each other**, not **us** or **ourselves**."
    }
  ],
