  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Only** is also an adjective (*the only child*, *my only chance*), in the entry **only** (adjective), and in informal speech a conjunction meaning *but* (*I'd come, only I'm busy*). Place **only** carefully in writing: *Only Kim saw the bird* (no one else saw it) and *Kim saw only the bird* (she saw nothing else) mean different things.",
  "learner_errors": [
    {
      "incorrect": "Only I have one brother.",
      "correct": "I have only one brother.",
      "note": "Put **only** just before the word it limits; *only I* means *no one else*."
    }
  ],
