  "word_family": [],
  "synonym_discrimination": {
    "words": [
      "big-adj",
      "large-adj",
      "great-adj"
    ],
    "note": "Big is the everyday word for size and also for importance: a big house, a big decision. Large is slightly more formal and is used mainly for size and amount; for importance, big is the usual word: a large amount, a large family, a large number. Great is used for size mainly in formal or literary writing (a great oak); in ordinary speech it means very good (a great idea) or very important (a great leader), and with feelings and uncountable nouns it means a lot of: great difficulty, great care."
  },
  "usage_note": "In speech big is used like an adverb in a few phrases: think big, win big, make it big. In careful writing, large is often preferred for amounts and numbers: a large amount of money, a large number of people; a big increase is normal.",
  "learner_errors": [
    {
      "incorrect": "a big number of people",
      "correct": "a large number of people",
      "note": "With number, amount, and quantity, large is the usual choice."
    },
    {
      "incorrect": "There was a big rain last night.",
      "correct": "There was heavy rain last night.",
      "note": "Rain, snow, wind, and traffic are usually heavy, not big."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Big covers physical size and importance; many languages use different words. For amounts and numbers English prefers large, and for weather heavy. The older sense (big brother) is a separate word in many languages.",
    "grammar": "The comparative and superlative double the g: bigger, biggest. Big is used both before a noun and after be.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The vowel is the short **i** of **sit**, and the final **g** is a full **g** sound with no vowel after it; it must not become **k**."
  },
