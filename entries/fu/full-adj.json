  "synonym_discrimination": null,
  "usage_note": "**Full of** takes a noun: *a box full of books*. **Full of** is the usual pattern; **full with** is rare. **Filled with** means the same and does take **with**: *a box filled with books*.",
  "learner_errors": [
    {
      "incorrect": "The bottle is full with water.",
      "correct": "The bottle is full of water.",
      "note": "The usual pattern is **full of**, or **filled with**."
    },
    {
      "incorrect": "I'm full of my homework.",
      "correct": "I'm busy with my homework.",
      "note": "**Full** does not mean busy with one task; use **busy with**."
    }
  ],
