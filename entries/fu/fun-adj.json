  "synonym_discrimination": {
    "words": [
      "fun-adj",
      "funny-adj"
    ],
    "note": "Something **fun** is enjoyable: you like doing it (*a fun party*). Something **funny** makes you laugh (*a funny story*). A party can be fun without being funny, and a joke can be funny without the evening being fun."
  },
  "usage_note": "**Fun** before a noun (*a fun day*) is common in speech and informal writing. After **be**, as in *Skiing is fun* and *It was a lot of fun*, this dictionary treats it as the noun; that use is shown at **fun** (noun). The forms **funner** and **funnest** are increasingly common in informal speech, especially American, but many people consider them wrong; **more fun** and **most fun** are safe everywhere.",
  "learner_errors": [
    {
      "incorrect": "The trip was very funny.",
      "correct": "The trip was a lot of fun.",
      "note": "To mean enjoyable, use **fun**; **funny** means it made you laugh."
    },
    {
      "incorrect": "This is the funnest game.",
      "correct": "This is the most fun game.",
      "note": "**More fun** and **most fun** are safe everywhere; **funnest** is informal and many people dislike it."
    }
  ],
