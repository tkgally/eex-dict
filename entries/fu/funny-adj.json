  "synonym_discrimination": {
    "words": [
      "funny-adj",
      "fun-adj"
    ],
    "note": "Something **funny** makes you laugh (*a funny joke*). Something **fun** is enjoyable (*a fun day out*). Saying *the party was funny* means people laughed, or that it was strange."
  },
  "usage_note": "Because sense 1 and sense 2 can be confused, speakers sometimes make clear which one they mean: *Do you mean funny ha-ha or funny strange?* *Very funny!* said in a flat voice means the speaker is not amused.",
  "learner_errors": [
    {
      "incorrect": "We had a funny time at the party.",
      "correct": "We had a fun time at the party.",
      "note": "To mean enjoyable, use **fun**; **funny** means it made you laugh, or it was strange."
    }
  ],
