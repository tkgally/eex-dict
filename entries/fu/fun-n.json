  "synonym_discrimination": {
    "words": [
      "fun-n",
      "funny-adj"
    ],
    "note": "Something that is **fun** is enjoyable: *The trip was fun*, *We had fun*. Something **funny** makes you laugh: *a funny story*. A party can be fun without being funny. **Funny** can also mean strange: *a funny noise*."
  },
  "usage_note": "As a noun, **fun** is uncountable: *a lot of fun*, never *funs*. It is common after **be**: *Skiing is fun*. In informal English **fun** is also used as an adjective before a noun (*a fun day*); that use is shown at **fun** (adjective).",
  "learner_errors": [
    {
      "incorrect": "The party was very funny.",
      "correct": "The party was a lot of fun.",
      "note": "If you mean enjoyable, use **fun**; **funny** means it made you laugh."
    },
    {
      "incorrect": "We had many funs on holiday.",
      "correct": "We had a lot of fun on vacation.",
      "note": "**Fun** is uncountable."
    },
    {
      "incorrect": "They made fun with him.",
      "correct": "They made fun of him.",
      "note": "The phrase is **make fun of someone**."
    }
  ],
