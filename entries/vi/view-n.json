  "synonym_discrimination": {
    "words": [
      "view-n",
      "opinion-n"
    ],
    "note": "**Opinion** is the most general word for what you think: *In my opinion, it's too late*. **View** is a little more formal and is often used for considered beliefs on a subject: *her views on education*. **Point of view** is a way of looking at something from a particular position: *from a child's point of view*."
  },
  "usage_note": "A **view** in the sense of what you see is often **of** a place: *a view of the mountains*. A **view** in the sense of opinion is **on** or **about** a subject: *my views on the matter*.",
  "learner_errors": [
    {
      "incorrect": "According to my view, it's a mistake.",
      "correct": "In my view, it's a mistake.",
      "note": "Use **in my view**; *according to* is used with other people or sources, not with *my*."
    },
    {
      "incorrect": "The room has a nice view to the river.",
      "correct": "The room has a nice view of the river.",
      "note": "A view is **of** a place, not *to* it."
    }
  ],
