  "usage_note": "You **pay** someone a visit (*pay a visit to your grandmother*), or are **on** a visit. A visit is **to** a place and **from** a person: *a visit to the museum*, *a visit from a friend*.",
  "learner_errors": [
    {
      "incorrect": "I did a visit to the museum.",
      "correct": "I visited the museum.",
      "note": "Use the verb **visit**, or say **pay a visit**; do not use **do** with the noun."
    },
    {
      "incorrect": "Thank you for your visit in my house.",
      "correct": "Thank you for your visit to my house.",
      "note": "A visit is **to** a place."
