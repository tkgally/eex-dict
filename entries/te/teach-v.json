  "learner_errors": [
    {
      "incorrect": "He learned me English.",
      "correct": "He taught me English.",
      "note": "**Teach** is for the person who gives the lesson; **learn** is for the person who receives it."
    },
    {
      "incorrect": "She teached us to cook.",
      "correct": "She taught us to cook.",
      "note": "The past tense and past participle of **teach** are **taught**."
    },
    {
      "incorrect": "Can you teach me the way to the station?",
      "correct": "Can you tell me the way to the station?",
      "note": "For directions, use **tell** or **show**, not **teach**."
