  "synonym_discrimination": null,
  "usage_note": "Notice the two patterns: a person **benefits from** something (*Children benefit from reading*), and a thing **benefits** a person, with no preposition (*Reading benefits children*). The past form is **benefited** in American English; British English uses **benefited** or **benefitted**.",
  "learner_errors": [
    {
      "incorrect": "She benefited of the extra lessons.",
      "correct": "She benefited from the extra lessons.",
      "note": "The preposition after **benefit** is **from**."
    },
    {
      "incorrect": "The plan benefits to the whole town.",
      "correct": "The plan benefits the whole town.",
      "note": "When something helps someone, **benefit** takes a direct object with no **to**."
    }
  ],
