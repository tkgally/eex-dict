  "usage_note": "In the sense *act in a particular way*, **behave** is usually followed by an adverb (*behave badly*, *behave strangely*), not an adjective. Without an adverb, it means *be good*: *Please behave!*",
  "learner_errors": [
    {
      "incorrect": "He behaved very bad in class.",
      "correct": "He behaved very badly in class.",
      "note": "**Behave** is followed by an adverb, such as **badly** or **well**, not an adjective."
    },
    {
      "incorrect": "Behave you!",
      "correct": "Behave yourself!",
      "note": "When **behave** has an object, it is a reflexive pronoun: **yourself**, **himself**, and so on."
    }
  ],
