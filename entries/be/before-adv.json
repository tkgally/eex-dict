  "synonym_discrimination": null,
  "usage_note": "**Before** is also a preposition (*before lunch*) and a conjunction (*before you go*), separate entries; this entry covers only its use alone, with no noun or clause after it. **Ago** counts back from now (*two days ago*), while **before** counts back from another time in the past (*two days before*).",
  "learner_errors": [
    {
      "incorrect": "I saw this film two weeks before.",
      "correct": "I saw this film two weeks ago.",
      "note": "To count back from now, use **ago**; **before** counts back from another time in the past."
    }
  ],
  "etymology": null,
  "see_also": [
