  "synonym_discrimination": {
    "words": [
      "either-adv",
      "too-adv",
      "also-adv",
      "neither-adv"
    ],
    "note": "Use **too** or **also** to add a positive statement (*Kim likes tea, and Sam does too*). Use **either** at the end of a negative clause to add a negative statement (*Kim doesn't like tea, and Sam doesn't either*). Use **neither** at the start, with the verb before the subject, for the same meaning (*and neither does Sam*)."
  },
  "usage_note": null,
