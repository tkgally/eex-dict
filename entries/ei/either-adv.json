  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "used after a negative statement to say that a second negative statement is also true",
      "explanation": "**Either** comes at the end of a negative clause that agrees with a negative statement just made: *I can't swim.* *I can't either.* In positive sentences, use **too** or **also** instead: *I like it too*; *I don't like it either*. A short informal reply is *Me neither*, and in American English also *Me either*; the more formal reply is *Neither can I* or *Neither do I*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [
          "not gradable"
        ],
        "patterns": []
      },
      "labels": {
