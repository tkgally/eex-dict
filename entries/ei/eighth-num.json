  "synonym_discrimination": null,
  "usage_note": "**Eighth** is written **8th** in short form. It usually comes after **the** or a word such as **his** (*the eighth floor*, *his eighth birthday*), but fixed phrases such as *eighth place* and *eighth prize* usually have no **the**. *An eighth* meaning one of eight equal parts (*an eighth of an inch*) is a noun, which has its own entry.",
  "learner_errors": [
    {
      "incorrect": "the eight of May",
      "correct": "the eighth of May",
      "note": "Dates use the ordinal number: *the eighth of May* or *May eighth*."
    }
  ],
