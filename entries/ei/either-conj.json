    {
      "n": 1,
      "signpost": "either ... or",
      "definition": "used before the first of two possibilities joined by **or**, to introduce a choice between them",
      "explanation": "**Either** pairs with **or** to join two words, phrases, or clauses that are grammatically alike: two nouns, two verbs, or two whole clauses. In a negative sentence, the same pair still shows a choice between two things, both refused: *I don't like either tea or coffee* means neither one.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
        "domain": [],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "You can have either tea or coffee.",
          "note": null,
          "pattern": null
        },
        {
          "text": "Either come in or close the door.",
          "note": null,
          "pattern": null
        },
        {
