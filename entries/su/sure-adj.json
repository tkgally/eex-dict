  "synonym_discrimination": {
    "words": [
      "sure-adj",
      "certain-adj",
      "positive-adj"
    ],
    "note": "**Sure** is the usual word in conversation: *I'm sure you're right.* **Certain** is a little more formal, and only **certain** is used after **it is**: *It is certain that he will come*, not *It is sure that*. **Positive** is stronger and informal, used when a person is completely without doubt: *I'm positive I saw her.* Only **sure** is used in **make sure** and **be sure to**."
  },
  "usage_note": "**Sure** as a reply meaning yes (*Sure, I'll help*) and **sure** meaning really in American speech (*It sure is cold*) are adverb uses; see the adverb **sure**. The adverb **surely** is often used to show surprise or to ask someone to agree (*Surely you're not leaving?*), so it is not a simple replacement for **certainly**.",
  "learner_errors": [
    {
      "incorrect": "I'm sure for that.",
      "correct": "I'm sure about that.",
      "note": "Use **sure about** or **sure of** something, not **sure for**."
    },
    {
      "incorrect": "I'm sure to be right.",
      "correct": "I'm sure I'm right.",
      "note": "**Sure to** means that something will happen; to say you have no doubt, use **sure** with a clause."
    }
  ],
