  "synonym_discrimination": {
    "words": [
      "surprise-v",
      "amaze-v",
      "astonish-v",
      "shock-v"
    ],
    "note": "**Surprise** is the general word for anything unexpected: *The question surprised me*. **Amaze** and **astonish** are stronger, for something that is very hard to believe: *Her progress amazed us*. **Shock** is for something unexpected and bad or upsetting: *The news shocked everyone*."
  },
  "usage_note": "**Surprise** is very often used in the passive or through the adjectives **surprised** and **surprising**: *I was surprised to see him there*; *The result was surprising*.",
  "learner_errors": [
    {
      "incorrect": "I was surprising when I heard the news.",
      "correct": "I was surprised when I heard the news.",
      "note": "Use **surprised** for how a person feels and **surprising** for the thing that causes the feeling."
    },
    {
      "incorrect": "I was surprised of the price.",
      "correct": "I was surprised at the price.",
      "note": "After **surprised**, use **at** or **by**, not **of**."
    }
  ],
