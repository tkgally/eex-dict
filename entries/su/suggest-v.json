  "synonym_discrimination": {
    "words": [
      "suggest-v",
      "recommend-v",
      "propose-v"
    ],
    "note": "**Suggest** is the general word for offering an idea: *I suggest we wait*. **Recommend** is used when you advise something because you think it is good, often from experience: *I recommend the fish*. **Propose** is more formal and is used for plans put forward in meetings: *She proposed a new schedule*."
  },
  "usage_note": "After **suggest**, the **that** clause often uses the base form of the verb, especially in American English: *I suggest that he wait*. **Should** is also possible: *I suggest that he should wait*. British English also uses the ordinary present: *I suggest that he waits*.",
  "learner_errors": [
    {
      "incorrect": "I suggest you to go by train.",
      "correct": "I suggest that you go by train.",
      "note": "**Suggest** is not followed by an object and a **to** infinitive. Use a **that** clause or an **-ing** form."
    },
    {
      "incorrect": "She suggested me a good book.",
      "correct": "She suggested a good book to me.",
      "note": "**Suggest** does not take the person as a first object; use **to** before the person."
    },
    {
      "incorrect": "She suggested me to see a doctor.",
      "correct": "She suggested that I see a doctor.",
      "note": "Put the person inside a **that** clause, or use **advise someone to do something**."
    },
    {
      "incorrect": "He suggested to go home.",
      "correct": "He suggested going home.",
      "note": "After **suggest**, use an **-ing** form or a **that** clause, not a **to** infinitive."
    }
  ],
