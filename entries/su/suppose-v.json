  "synonym_discrimination": {
    "words": [
      "suppose-v",
      "guess-v",
      "assume-v"
    ],
    "note": "**Suppose** is common in speech for a belief you are not sure about: *I suppose he's busy*. **Guess** is similar and more informal, especially in American English: *I guess so*. **Assume** means accept something as true without checking it, often before you act: *I assumed the store was open*."
  },
  "usage_note": "With **suppose**, as with **think** and **believe**, English often puts the negative on the first verb: *I don't suppose he'll come* shows doubt that he will come. *I suppose he won't come* is also correct and sounds more like a conclusion.",
  "learner_errors": [
    {
      "incorrect": "You are suppose to be here at nine.",
      "correct": "You are supposed to be here at nine.",
      "note": "Write the **-d**: **supposed to**, even though it is not heard."
    },
    {
      "incorrect": "Supposed you won, what would you do?",
      "correct": "Suppose you won, what would you do?",
      "note": "To imagine a situation, use **suppose** or **supposing**, not **supposed**."
    }
  ],
