  "synonym_discrimination": {
    "words": [
      "surely-adv",
      "certainly-adv"
    ],
    "note": "**Certainly** says that something is true, with no doubt: *It will certainly rain*. **Surely** often shows that the speaker believes something but wants the listener to agree, or is surprised: *Surely it won't rain on your wedding day?*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "\"Can you help me?\" \"Surely.\"",
      "correct": "\"Can you help me?\" \"Of course.\"",
      "note": "**Surely** is not normally used as a reply meaning yes; say *Of course*, *Certainly*, or, informally, *Sure*."
    }
