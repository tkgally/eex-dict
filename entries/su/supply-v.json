  "synonym_discrimination": {
    "words": [
      "supply-v",
      "provide-v"
    ],
    "note": "**Provide** is the general word for giving what is needed: *provide help*, *provide a service*. **Supply** is used especially for goods, food, water, and power given regularly and in large amounts, often as a business: *They supply the stores with bread*."
  },
  "usage_note": "**Supply** is common in the passive: *Water is supplied by the city*. Both patterns are normal: *supply bread to stores* and *supply stores with bread*. The noun **supply** (*a supply of water*; *food supplies*) is more common than the verb in everyday speech.",
  "learner_errors": [
    {
      "incorrect": "The company supplies computers the schools.",
      "correct": "The company supplies computers to schools.",
      "note": "Use **supply something to someone** or **supply someone with something**."
    },
    {
      "incorrect": "They supplied us of fresh water.",
      "correct": "They supplied us with fresh water.",
      "note": "With the person as the object, use **with** before the thing."
    }
  ],
