  "synonym_discrimination": {
    "words": [
      "suggestion-n",
      "advice-n",
      "proposal-n"
    ],
    "note": "A **suggestion** is an idea you offer, often a small or informal one (*a suggestion for dinner*). **Advice** is an opinion about what someone should do; it is uncountable (*some advice*, *a piece of advice*). A **proposal** is a more formal plan, often written, that a group must accept or reject (*a proposal for a new road*)."
  },
  "usage_note": null,
