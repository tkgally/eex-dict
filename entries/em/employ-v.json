  "synonym_discrimination": {
    "words": [
      "employ-v",
      "hire-v"
    ],
    "note": "**Employ** usually describes a lasting situation: *the company employs fifty people*. **Hire** describes the moment of giving someone a job, and is the more common everyday word in American English: *we hired two new people last week*. **Hire** is also used for paying someone to do one short job: *hire a lawyer*."
  },
