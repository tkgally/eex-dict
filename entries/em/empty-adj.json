  "synonym_discrimination": {
    "words": [
      "empty-adj",
      "vacant-adj"
    ],
    "note": "**Empty** is the everyday word for a place or container with nothing or nobody in it (*an empty room*, *an empty glass*). **Vacant** is more formal and is used for a room, seat, house, or job that nobody is using or doing at the moment (*a vacant apartment*, *a vacant position*)."
  },
