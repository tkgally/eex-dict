  "synonym_discrimination": {
    "words": [
      "raise-v",
      "rise-v",
      "lift-v"
    ],
    "note": "**Raise** always has an object: *Raise your hand*, *They raised prices*. **Rise** never has one: *The sun rises*, *Prices rose*. **Lift** is used mainly for physically picking something up, often something heavy: *Can you help me lift this box?*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Prices have raised a lot this year.",
      "correct": "Prices have risen a lot this year.",
      "note": "**Raise** needs an object. When something goes up by itself, use **rise** (**rose**, **risen**)."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"raise\": always takes an object (*raise prices*). The verb with no object is **rise** (*prices rise*). Many languages use one verb, or the same verb with a reflexive word, for both.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"raise\" ends in a **z** sound; **race** ends in an **s** sound. The difference changes the word."
  },
