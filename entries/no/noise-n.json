    {
      "incorrect": "There are many noises on this street.",
      "correct": "There is a lot of noise on this street.",
      "note": "For sound in general, **noise** is uncountable; use the plural only for separate, particular sounds."
    },
    {
      "incorrect": "The children are doing a lot of noise.",
      "correct": "The children are making a lot of noise.",
      "note": "The verb with **noise** is **make**, not **do**."
