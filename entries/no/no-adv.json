    {
      "n": 1,
      "signpost": null,
      "definition": "not at all, or not any",
      "explanation": "Used before a comparative (*no better*, *no bigger*), before **different**, and in **no longer**. It makes the sentence negative by itself, so the verb takes no **not**. Before a number or an amount, **no more than** means *only*, and **no less than** means *as much as*, often to show surprise: *no less than fifty people*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [
          "not gradable"
        ],
        "patterns": []
      },
      "labels": {
