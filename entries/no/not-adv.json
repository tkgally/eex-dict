  "synonym_discrimination": null,
  "usage_note": "With **think**, **believe**, **expect**, and **suppose**, English usually makes the first verb negative: *I don't think he's coming* is more natural than *I think he isn't coming*. In standard English, **not** is not normally used together with **no**, **never**, **nothing**, or **nobody** in the same clause.",
  "learner_errors": [
    {
      "incorrect": "I not like it.",
      "correct": "I don't like it.",
      "note": "With an ordinary verb, use **do not** or **don't** before it."
    },
    {
      "incorrect": "I think he is not coming.",
      "correct": "I don't think he's coming.",
      "note": "With **think**, English usually puts the negative on **think**."
    },
    {
      "incorrect": "Is not she coming?",
      "correct": "Isn't she coming?",
      "note": "In a question, use the short form **isn't** before the subject, or *Is she not coming?* in formal speech."
    }
  ],
