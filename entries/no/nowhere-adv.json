  "synonym_discrimination": null,
  "usage_note": "**Nowhere** is negative, so a sentence with it does not take **not** as well: *There was nowhere to sit*, or *There wasn't anywhere to sit*. At the start of a sentence, mostly in writing, it puts a helping verb before the subject: *Nowhere else can you find such food*. The idiom *in the middle of nowhere* is in the entry for **middle**, and *get nowhere* also in **get**.",
  "learner_errors": [
    {
      "incorrect": "I don't have nowhere to go.",
      "correct": "I have nowhere to go.",
      "note": "**Nowhere** is already negative; use it with a positive verb, or say **not anywhere**."
    },
    {
      "incorrect": "I went to nowhere.",
      "correct": "I went nowhere.",
      "note": "After a verb such as **go**, no **to** goes before **nowhere**."
    }
  ],
