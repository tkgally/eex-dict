  "synonym_discrimination": null,
  "usage_note": "**No** makes a sentence negative by itself; do not also add **not** to the verb: say *I have no money*, not *I don't have no money*, which is a double negative and not standard English. **No** used to answer a question (*Are you coming? No.*) and **no** used as an adverb before a comparative (*no better than before*) belong to separate entries.",
  "learner_errors": [
    {
      "incorrect": "I don't have no time.",
      "correct": "I have no time.",
      "note": "**Don't** already contains the negative **not**; adding **no** as well produces a double negative."
    },
    {
      "incorrect": "There is not milk.",
      "correct": "There is no milk.",
      "note": "Before a noun with no other negative word, **no** is used, not **not**."
    }
  ],
