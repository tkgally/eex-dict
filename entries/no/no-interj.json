  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "In speech, **nope** is a very informal form, and **nah** is informal too. To an offer, *No, thank you* or *No, thanks* is more polite than *No* alone. **No** is often followed by a short answer that repeats the helping verb: *No, I'm not*, *No, she doesn't*. **No** before a noun (*no money*) and before a comparative (*no better*) belongs to separate entries.",
  "learner_errors": [
    {
      "incorrect": "\"Didn't you go?\" \"No, I went.\"",
      "correct": "\"Didn't you go?\" \"Yes, I went.\"",
      "note": "With a positive fact, the answer is **yes**, even after a negative question."
    },
    {
      "incorrect": "\"Do you smoke?\" \"No, I don't smoke not.\"",
      "correct": "\"Do you smoke?\" \"No, I don't.\"",
      "note": "The short answer repeats only the helping verb, with **not** once: *No, I don't*."
    }
  ],
