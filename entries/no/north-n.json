  "synonym_discrimination": null,
  "usage_note": "**In the north of** a place means inside it (*in the north of the country*); **to the north of** a place means outside it, beyond its northern edge (*the farms to the north of the city*). The noun takes **the** after **in** and **to**; for *drive north*, without **the**, see the adverb. Write **the North**, with a capital letter, when people mean a region with its own way of life, such as the northern part of England.",
  "learner_errors": [
    {
      "incorrect": "They live on the north of the island.",
      "correct": "They live in the north of the island.",
      "note": "For a part inside a place, use **in**, not **on**."
    },
    {
      "incorrect": "The village is ten miles to north.",
      "correct": "The village is ten miles to the north.",
      "note": "After **to** and **in**, the noun needs **the**."
    }
