  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "added to an adjective or adverb, usually a short one, to make its superlative form, meaning most",
      "explanation": "It is used with adjectives of one syllable, with two-syllable adjectives ending in **y** (*happiest*, *easiest*), and with some others such as *quietest* and *simplest*; most other longer adjectives use **most** instead (*the most expensive*). A final single consonant after a single vowel letter is doubled (*hottest*), **y** after a consonant becomes **i** (*happiest*), and a final **e** just adds **st** (*nicest*). A few forms are irregular: *best*, *worst*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
