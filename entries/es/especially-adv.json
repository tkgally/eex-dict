  "synonym_discrimination": {
    "words": [
      "especially-adv",
      "specially-adv",
      "particularly-adv"
    ],
    "note": "Use **especially** or **particularly** to pick out one thing from a group (*I like fruit, especially apples*). Before an adjective to mean *very*, **particularly** is common in any sentence, while **especially** is most natural after **not** (*not especially hot*) or for a strong point (*an especially cold winter*). For *for one purpose*, **specially** is common and **especially** is also correct: *a dress specially made for the wedding*. **Particularly** is a little more formal."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Especially I like apples.",
      "correct": "I especially like apples.",
      "note": "**Especially** does not usually begin a sentence before the subject; put it before the verb or before the word it picks out."
    }
  ],
