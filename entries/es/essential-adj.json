  "synonym_discrimination": {
    "words": [
      "necessary-adj",
      "essential-adj",
      "vital-adj"
    ],
    "note": "**Necessary** is the everyday word for something that is needed: *Is it necessary to bring a passport?* **Essential** is stronger and means that you cannot manage without it: *Warm clothes are essential.* **Vital** means much the same as **essential** and is often used when a lot depends on something: *Your help is vital to the plan.*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Water is essential to live.",
      "correct": "Water is essential for life.",
      "note": "Use **essential for** or **essential to** with a noun; the pattern with **to** and a verb needs **it** first: *It is essential to drink water.*"
    }
  ],
