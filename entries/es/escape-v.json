  "synonym_discrimination": {
    "words": [
      "escape-v",
      "avoid-v",
      "flee-v"
    ],
    "note": "**Escape** means getting away from something that holds you, threatens you, or is unpleasant: *escape from prison*, *escape the heat*; with an injury or a punishment it means you were lucky not to suffer it: *he escaped injury*. **Avoid** means keeping away from something before it happens, often on purpose: *avoid the busy roads*. **Flee** means running away fast, often from danger or war, and is more formal: *thousands fled the city*."
  },
  "usage_note": "**Escape from** a place or a person (*escape from prison*) is the usual pattern for getting free; without **from**, the object is often something bad you did not suffer (*escape injury*, *escape the worst of the storm*). Both *escape the city* and *escape from the city* are possible when you mean leaving it for a rest.",
  "learner_errors": [
    {
      "incorrect": "He escaped to do his homework.",
      "correct": "He avoided doing his homework.",
      "note": "To keep away from a task on purpose, use **avoid** + **-ing**; **escape** is for getting free from something that holds or threatens you."
    },
    {
      "incorrect": "She escaped from injury.",
      "correct": "She escaped injury.",
      "note": "With injury, death, or punishment, the usual pattern is a direct object without **from**."
    }
  ],
  "etymology": null,
