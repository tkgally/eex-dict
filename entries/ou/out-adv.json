  "synonym_discrimination": null,
  "usage_note": "Before a noun, **out** is usually followed by **of** (*out of the house*), in the entry **out** (preposition). Many phrasal verbs use **out** with a meaning that is hard to guess, such as **find out**, **work out**, **run out**, and **give out**; each has its own entry.",
  "learner_errors": [
    {
      "incorrect": "He went out the house.",
      "correct": "He went out of the house.",
      "note": "In careful English, **out** needs **of** before a noun; **out the door** and **out the window** are common in American speech."
    }
  ],
