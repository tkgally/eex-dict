  "synonym_discrimination": {
    "words": [
      "outside-adv",
      "outdoors-adv",
      "out-adv"
    ],
    "note": "**Outside** is the general word for *not in a building* and also for *just out of a room*: *Wait outside*. **Outdoors** means only *in the open air*, often for activities: *We spent the day outdoors*. **Out** often means *away from home*, not just out of the building: *She's out* means she has gone somewhere."
  },
  "usage_note": "**Outside** with a noun after it (*outside the house*) is a preposition, in the entry **outside** (preposition). With no noun after it, as here, it is an adverb, and no **to** or **at** goes before it: *go outside*, *wait outside*.",
  "learner_errors": [
    {
      "incorrect": "Let's go to outside.",
      "correct": "Let's go outside.",
      "note": "**Outside** is an adverb here, so no **to** goes before it."
    },
    {
      "incorrect": "He is waiting at outside.",
      "correct": "He is waiting outside.",
      "note": "Do not put **at** before **outside**."
    }
  ],
