  "synonym_discrimination": {
    "words": [
      "almost-adv",
      "nearly-adv"
    ],
    "note": "**Almost** and **nearly** usually mean the same: *almost ready*, *nearly ready*. **Almost** is much more usual before **no**, **nothing**, **never**, and **any**: *almost nothing*, *almost no time*. **Nearly** is the usual word after **not**, where *not nearly* means *far from*: *not nearly enough money*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Almost of the students passed.",
      "correct": "Almost all of the students passed.",
      "note": "**Almost** cannot go straight before **of**; say **almost all of** or **almost every**."
    },
    {
      "incorrect": "Almost students like music.",
      "correct": "Most students like music.",
      "note": "Before a plural noun, use **most** or **almost all**."
