  "synonym_discrimination": {
    "words": [
      "also-adv",
      "too-adv",
      "as-well-adv"
    ],
    "note": "**Also** usually goes before the main verb or after **be**: *She also plays tennis*, *She is also a teacher*. **Too** and **as well** go at the end of the clause: *She plays tennis too*. **As well** is more common in British English. In negative sentences, use **either** at the end: *She doesn't play tennis either*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I don't like coffee also.",
      "correct": "I don't like coffee either.",
      "note": "In negative sentences, use **either** at the end."
    },
    {
      "incorrect": "She also is a doctor.",
      "correct": "She is also a doctor.",
      "note": "**Also** comes after **be** but before other main verbs."
    }
  ],
