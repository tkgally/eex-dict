  "synonym_discrimination": null,
  "usage_note": "**Always** usually goes before the main verb (*I always walk*) but after **be** and after the first helping verb (*She is always late*, *I have always wanted to go*). In commands it comes first: *Always lock the door*.",
  "learner_errors": [
    {
      "incorrect": "I go always to school by bus.",
      "correct": "I always go to school by bus.",
      "note": "**Always** goes before the main verb."
    },
    {
      "incorrect": "Always I get up at seven.",
      "correct": "I always get up at seven.",
      "note": "In a statement, **always** does not usually come first; put it before the main verb."
    }
  ],
