  "synonym_discrimination": null,
  "usage_note": "**Alike** comes after a verb such as **be** or **look**, never before a noun: *the twins look alike*. Before a noun, use **similar**: *two similar houses*. As an adverb, **alike** means *in the same way* (*treat everyone alike*) or *both* (*children and adults alike*); see that entry.",
  "learner_errors": [
    {
      "incorrect": "They are alike twins.",
      "correct": "They are twins who look alike.",
      "note": "**Alike** is not used before a noun; use **similar** there or put **alike** after the verb."
    }
