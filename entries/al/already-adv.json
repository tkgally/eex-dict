  "synonym_discrimination": {
    "words": [
      "already-adv",
      "yet-adv",
      "still-adv"
    ],
    "note": "**Already** says that something has happened, often sooner than expected: *I've already finished*. **Yet** is used in questions and negatives about something that is expected to happen: *Have you finished yet?*, *I haven't finished yet*. **Still** says that something is continuing: *I'm still working*."
  },
  "usage_note": "In American English **already** is common with the simple past (*I already ate*); British English usually uses the present perfect (*I've already eaten*). **All ready**, two words, means *completely ready*: *We're all ready to go*.",
  "learner_errors": [
    {
      "incorrect": "I have finished my homework yet.",
      "correct": "I have already finished my homework.",
      "note": "In positive statements, use **already**; **yet** is for questions and negatives."
    }
  ],
