  "synonym_discrimination": null,
  "usage_note": "Use **disappointed in** for a person whose behavior has let you down (*disappointed in my brother*) and usually **disappointed with** or **by** for a thing or a result (*disappointed with the hotel*). The adjective is often followed by a to-infinitive (*disappointed to learn*) or a that-clause (*disappointed that nobody came*).",
  "learner_errors": [
    {
      "incorrect": "The film was very disappointed.",
      "correct": "The film was very disappointing.",
      "note": "**Disappointed** describes how a person feels; **disappointing** describes the thing that causes the feeling."
    },
    {
      "incorrect": "I was disappointed of the result.",
      "correct": "I was disappointed with the result.",
      "note": "Use **with**, **by**, or **in**, not **of**."
    }
  ],
