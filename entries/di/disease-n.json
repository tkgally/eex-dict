  "synonym_discrimination": {
    "words": [
      "disease-n",
      "illness-n",
      "sickness-n"
    ],
    "note": "A **disease** is a particular condition with a name and a cause, and plants and animals get diseases too: *heart disease*, *a disease of the skin*. **Illness** is the state of being ill, or a time when you are ill: *she missed a week of school through illness*. **Sickness** is close to **illness**; it is common in fixed phrases and is also used for the feeling that you are going to vomit: *travel sickness*."
  },
  "usage_note": "**Disease** is uncountable for disease in general (*the fight against disease*) and in many names (*heart disease*). It is countable for one particular kind: *a rare disease*, *childhood diseases*.",
  "learner_errors": [
    {
      "incorrect": "He has a heart's disease.",
      "correct": "He has heart disease.",
      "note": "A body part before **disease** works like an adjective, with no **'s** and usually no **a**: *heart disease*, *lung disease*."
    },
    {
      "incorrect": "My brother is disease.",
      "correct": "My brother is sick.",
      "note": "**Disease** is a noun. To say how a person is, use **sick** or **ill**."
    }
  ],
