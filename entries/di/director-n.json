  "synonym_discrimination": null,
  "usage_note": "In a company, **director** often means one of the top people; a **manager** is usually in charge of a team or a department. In American English, **director** is also a common job title for the head of a department (*director of sales*). In British English, the head of a company is often the **managing director**.",
  "learner_errors": [
    {
      "incorrect": "He is director in a bank.",
      "correct": "He is a director at a bank.",
      "note": "With **be**, a job that many people have takes **a**. The article is often left out before a title that one person holds: *she is director of sales*."
    }
  ],
