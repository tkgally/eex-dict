  "synonym_discrimination": null,
  "usage_note": "When you talk about the meal in general, **dinner** takes no **a** or **the**: *have dinner*, *what's for dinner?* With an adjective, **a** is used (*a lovely dinner*), and **the** is used for a particular dinner already known (*the dinner was excellent*). Some speakers, in parts of Britain and elsewhere, use **dinner** for a main meal in the middle of the day and call the evening meal **tea** or **supper**.",
  "learner_errors": [
    {
      "incorrect": "We had a dinner at eight.",
      "correct": "We had dinner at eight.",
      "note": "For the meal in general, **dinner** takes no **a**: *have dinner*."
    },
    {
      "incorrect": "What do you want for the dinner?",
      "correct": "What do you want for dinner?",
      "note": "When you mean the meal in general, no **the** in *for dinner*, *at dinner*, *after dinner*."
    }
  ],
