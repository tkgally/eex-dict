  "synonym_discrimination": null,
  "usage_note": "**Die**, **dead**, and **death** are easy to mix up: **die** is the verb (*he died last year*), **dead** is the adjective (*he is dead*), and **death** is the noun (*after his death*). Many people use gentler words, such as **pass away**, when they talk about someone they knew.",
  "learner_errors": [
    {
      "incorrect": "He is died.",
      "correct": "He is dead.",
      "note": "**Died** is the past of the verb; to describe the state, use the adjective **dead**."
    },
    {
      "incorrect": "She died by cancer.",
      "correct": "She died of cancer.",
      "note": "An illness or a cause inside the body follows **of** or **from**, not **by**."
    },
    {
      "incorrect": "He was died in the war.",
      "correct": "He died in the war.",
      "note": "**Die** takes no object and is never passive."
    }
  ],
