  "synonym_discrimination": null,
  "usage_note": "**Different from** is the most common form and is correct everywhere. **Different than** is common in American English, both before a clause (*different than I expected*) and before a noun; **different to** is common in British English.",
  "learner_errors": [
    {
      "incorrect": "My bag is different with yours.",
      "correct": "My bag is different from yours.",
      "note": "After **different**, use **from** (or **than** or **to**), not **with**."
    },
    {
      "incorrect": "Life here is very different of my country.",
      "correct": "Life here is very different from life in my country.",
      "note": "Use **from**, not **of**, and compare like with like: life with life."
    }
  ],
