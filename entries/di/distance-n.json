  "synonym_discrimination": null,
  "usage_note": "To ask about distance, English usually says **How far...?**: *How far is it to the station?* *What's the distance...?* is possible but sounds more formal. In everyday speech **a long way** is more common than **a long distance**: *it's a long way to the beach*.",
  "learner_errors": [
    {
      "incorrect": "How much distance is it to the station?",
      "correct": "How far is it to the station?",
      "note": "To ask about distance, use **How far...?**."
    },
    {
      "incorrect": "The station is in a short distance.",
      "correct": "The station is a short distance away.",
      "note": "No preposition comes before **a short distance**; add **away** or **from** a place."
    }
  ],
