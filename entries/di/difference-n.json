  "synonym_discrimination": null,
  "usage_note": "Use **between** before the things you compare (*the difference between cats and dogs*) and **in** before the quality that is not the same (*a difference in age*, *a difference in size*). **Make a difference** means *have an effect*; **make no difference** means *not matter*.",
  "learner_errors": [
    {
      "incorrect": "There is a big difference of price.",
      "correct": "There is a big difference in price.",
      "note": "Use **in** before the quality that is not the same."
    },
    {
      "incorrect": "What is the difference among these two words?",
      "correct": "What is the difference between these two words?",
      "note": "Use **between** for the things you compare."
    },
    {
      "incorrect": "It doesn't make difference.",
      "correct": "It doesn't make any difference.",
      "note": "**Make a difference** needs **a**, **any**, **no**, or another word before **difference**."
    }
  ],
