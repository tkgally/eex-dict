  "synonym_discrimination": null,
  "usage_note": "Say **in the direction of**, not **to the direction of**: *walk in the direction of the lake*. Movement *in this direction*, *in the opposite direction*, or *in the wrong direction* also takes **in**; informal American English sometimes leaves it out (*go that direction*). To ask how to get somewhere, use the plural: *ask for directions*.",
  "learner_errors": [
    {
      "incorrect": "He went to the direction of the park.",
      "correct": "He went in the direction of the park.",
      "note": "Use **in**, not **to**, before **the direction of**."
    },
    {
      "incorrect": "Can you tell me the direction to the station?",
      "correct": "Can you give me directions to the station?",
      "note": "To ask how to get somewhere, use the plural **directions**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "Movement toward a direction takes **in** in English (*go in this direction*, *in the direction of the lake*), where many languages use a word meaning *to* or *toward*.",
