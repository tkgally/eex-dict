  "synonym_discrimination": null,
  "usage_note": "In sense 2, **difficulty** is uncountable: *I had difficulty sleeping*, with no **a**. The pattern is **have difficulty doing something**, sometimes with **in** before the **-ing** form. **Have trouble doing something** means the same and is less formal.",
  "learner_errors": [
    {
      "incorrect": "I have difficulty to understand him.",
      "correct": "I have difficulty understanding him.",
      "note": "After **have difficulty**, use the **-ing** form, or **with** and a noun."
    },
    {
      "incorrect": "I had a difficulty finding a job.",
      "correct": "I had difficulty finding a job.",
      "note": "In this pattern, **difficulty** is uncountable and takes no **a**."
    }
  ],
