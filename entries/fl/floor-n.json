  "synonym_discrimination": null,
  "usage_note": "In American English, the **first floor** is the one at street level, and the **second floor** is above it. In British English, the floor at street level is the **ground floor**, and the **first floor** is the one above it. The word **story** (British **storey**) is used to say how tall a building is: *a ten-story building*.",
  "learner_errors": [
    {
      "incorrect": "My apartment is in the third floor.",
      "correct": "My apartment is on the third floor.",
      "note": "Use **on** with a floor of a building."
    },
    {
      "incorrect": "The cup fell on the ground in the kitchen.",
      "correct": "The cup fell on the floor in the kitchen.",
      "note": "Inside a building, the surface you walk on is the **floor**. **Ground** is used outside."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages use one word for the **floor** inside a building and the **ground** outside. English keeps them apart.",
    "grammar": null,
    "culture": "Floors are numbered differently: in American English the **first floor** is at street level; in British English it is the floor above the **ground floor**. Check which system the text uses.",
