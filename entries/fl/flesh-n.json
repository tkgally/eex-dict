  "synonym_discrimination": {
    "words": [
      "flesh-n",
      "meat-n"
    ],
    "note": "**Meat** is the flesh of animals when it is used as food: *buy some meat*. **Flesh** is the soft part of any body, living or dead, and of a fruit: *a cut in the flesh*, *the flesh of a peach*. As food, **flesh** is used mainly for fish, or in a formal or scientific way."
  },
  "usage_note": "**Flesh** is uncountable: *some flesh*, *a lot of flesh*, never *a flesh* or *fleshes*. The idiom *your own flesh and blood*, meaning a member of your family, is in the entry for **blood**. The phrasal verb **flesh out** (*flesh out a plan*) means add details.",
  "learner_errors": [
    {
      "incorrect": "I don't eat flesh.",
      "correct": "I don't eat meat.",
      "note": "For food from animals, say **meat**; **flesh** as food sounds strange or very formal."
    }
  ],
