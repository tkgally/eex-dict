  "synonym_discrimination": {
    "words": [
      "flavor-n",
      "taste-n"
    ],
    "note": "**Taste** is the general word, both for the sense in your mouth and for what a food is like: *This milk has a strange taste*. **Flavor** is used for the particular taste of a food, and for the kinds of taste a product comes in: *a rich flavor*; *What flavor of ice cream do you want?*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "What taste of ice cream do you want?",
      "correct": "What flavor of ice cream do you want?",
      "note": "For the kinds of taste a food comes in, use **flavor**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages have one word for both **taste** and **flavor**. English usually uses **flavor** for the kinds a food comes in (*ice cream flavors*), where **taste** would be unusual.",
