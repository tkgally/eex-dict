  "synonym_discrimination": null,
  "usage_note": "In a restaurant, the server asks *Can I take your order?* and you **order** your food (the verb). For a request for goods, you **place** an order. *In order to* is more formal than *to* alone; use it to make a purpose very clear or at the start of a sentence: *In order to apply, fill out this form*.",
  "learner_errors": [
    {
      "incorrect": "I made an order for a new phone.",
      "correct": "I placed an order for a new phone.",
      "note": "With a request for goods, use **place** an order, or simply the verb **order**, not **make**."
    },
    {
      "incorrect": "She went to the bank in order to getting money.",
      "correct": "She went to the bank in order to get money.",
      "note": "**In order to** is followed by the base form of a verb."
    }
  ],
