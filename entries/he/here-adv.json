  "usage_note": "**Here** is not used after **to**: say *come here*, not *come to here*. It can follow other prepositions: *from here*, *near here*, *in here*.",
  "learner_errors": [
    {
      "incorrect": "Please come to here.",
      "correct": "Please come here.",
      "note": "**Here** already includes the idea of *to*; no preposition is needed after verbs of movement."
    },
    {
      "incorrect": "Here is the keys.",
      "correct": "Here are the keys.",
      "note": "The verb agrees with the noun that follows: *here is* + singular, *here are* + plural."
    }
