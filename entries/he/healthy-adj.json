  "synonym_discrimination": {
    "words": [
      "healthy-adj",
      "well-adj",
      "fit-adj"
    ],
    "note": "**Healthy** means in good condition in general (*a healthy baby*) and also good for you (*healthy food*). **Well** is used after verbs like **feel**, **be**, and **look** to say that a person is not ill (*I don't feel well*); it is not usual before a noun. **Fit** means strong because you exercise (*fit enough to run a long way*)."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm not healthy today.",
      "correct": "I don't feel well today.",
      "note": "To say how you feel now, **well** is the usual word; **healthy** describes the condition of your body in general."
    }
  ],
