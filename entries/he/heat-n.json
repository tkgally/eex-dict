  "synonym_discrimination": {
    "words": [
      "heat-n",
      "warmth-n",
      "temperature-n"
    ],
    "note": "**Heat** is great or strong hotness: *the heat of the desert*. **Warmth** is pleasant, gentle hotness: *the warmth of the fire*. **Temperature** is the measure of how hot or cold something is, in degrees: *The temperature is 30 degrees*, never *the heat is 30 degrees*."
  },
  "usage_note": "In sense 3, **heat** for the system that warms a house is American; British English says **heating**: *turn the heating on*. Both say **central heating**.",
  "learner_errors": [
    {
      "incorrect": "I can't stand the hot in summer.",
      "correct": "I can't stand the heat in summer.",
      "note": "**Hot** is the adjective; the noun is **heat**."
    },
    {
      "incorrect": "The heat today is 35 degrees.",
      "correct": "The temperature today is 35 degrees.",
      "note": "A number of degrees is a **temperature**, not a **heat**."
    }
  ],
