  "synonym_discrimination": {
    "words": [
      "help-v",
      "assist-v"
    ],
    "note": "**Help** is the everyday word: *Can you help me move this table?* **Assist** is more formal and is used in work, official, and medical situations: *Nurses assist the doctor during the operation.*"
  },
  "usage_note": "**Help** can be followed by a base form with or without **to**: *She helped me (to) find a job.* The form without **to** is more common, especially in American English. The shout *Help!* when you are in danger is the interjection **help**.",
  "learner_errors": [
    {
      "incorrect": "Can you help me for my homework?",
      "correct": "Can you help me with my homework?",
      "note": "The task you get help in takes **with**."
    },
    {
      "incorrect": "He helped me carrying the bags.",
      "correct": "He helped me carry the bags.",
      "note": "After **help someone**, use the base form, with or without **to**, not the -ing form."
    },
    {
      "incorrect": "I can't help to laugh.",
      "correct": "I can't help laughing.",
      "note": "**Can't help** in this meaning takes the -ing form."
    }
