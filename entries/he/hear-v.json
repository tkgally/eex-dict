  "adaptation": {
    "semantic": "\"hear\": some languages use one verb for both **hear** and **listen**. In English **hear** is about noticing a sound, and **listen** is about paying attention.",
    "grammar": "\"hear\": after *hear someone*, use the base form or the -ing form, never **to**: *I heard him leave*, *I heard him leaving*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"hear\": the past form **heard** does not sound like **hear** with **-d** added; it rhymes with **bird**."
  },
