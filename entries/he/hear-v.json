  "synonym_discrimination": {
    "words": [
      "hear-v",
      "listen-v"
    ],
    "note": "You **hear** a sound whether you try to or not: *I heard a car outside.* You **listen** when you pay attention on purpose, and **listen** takes **to** before an object: *I listened to the radio all evening.*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I am hearing music from next door.",
      "correct": "I can hear music from next door.",
      "note": "For sounds, **hear** is not used in the continuous; use **can hear**."
    },
    {
      "incorrect": "I like hearing to the radio.",
      "correct": "I like listening to the radio.",
      "note": "**Hear** never takes **to**; for music or the radio, use **listen to**."
    }
  ],
