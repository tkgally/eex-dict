  "synonym_discrimination": {
    "words": [
      "put-on-phrv",
      "wear-v",
      "dress-v"
    ],
    "note": "**Put on** is the action of getting clothes onto your body (*Put on your coat*). **Wear** is having them on (*She is wearing a red coat*). **Dress** usually has no object and means putting on all your clothes (*I got up and dressed*), or it takes a person as its object (*dress the baby*)."
  },
  "usage_note": null,
