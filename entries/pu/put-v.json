  "synonym_discrimination": {
    "words": [
      "put-v",
      "place-v",
      "set-v"
    ],
    "note": "**Put** is the everyday word and fits almost any situation: *Put your bag here*. **Place** is more formal and suggests care: *He placed the glass carefully on the table*. **Set** often means putting something down in its proper position: *She set the tray on the table*."
  },
