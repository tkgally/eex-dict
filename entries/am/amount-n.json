  "adaptation": {
    "semantic": null,
    "grammar": "\"amount\" goes with uncountable nouns; with plural nouns, **number** is the safe choice: *an amount of water*, *a number of cups*. Where one word covers both, choose by the noun that follows.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"amount\": stress on the second syllable, *uh-MOUNT*."
  },
