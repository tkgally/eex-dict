  "synonym_discrimination": {
    "words": [
      "amount-n",
      "number-n",
      "quantity-n"
    ],
    "note": "In careful English, **amount** goes with uncountable nouns: *the amount of sugar*. **Number** goes with plural nouns: *the number of cars*. **Amount** with a plural noun is heard in speech, but many people think it is wrong. **Quantity** can go with both and is more formal, common in business and science: *large quantities of paper*."
  },
  "usage_note": "**Amount of** is used with uncountable nouns (*an amount of money*); with plural nouns, **number of** is the safe choice (*a number of people*), since many people object to **amount** there. **A large amount of** is more formal than **a lot of**.",
  "learner_errors": [
    {
      "incorrect": "There was a large amount of people.",
      "correct": "There was a large number of people.",
      "note": "In careful English, use **number** with plural nouns and **amount** with uncountable ones."
    }
  ],
