  "synonym_discrimination": {
    "words": [
      "opportunity-n",
      "chance-n",
      "possibility-n"
    ],
    "note": "An **opportunity** is a good time or situation for doing something you want to do: *a great opportunity to travel*. **Chance** means the same and is less formal: *I never got the chance to thank her*; it can also mean how likely something is. A **possibility** is something that may happen or may be true, not a good moment that you can use: *There's a possibility of rain*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I had the possibility to study abroad.",
      "correct": "I had the opportunity to study abroad.",
      "note": "For a good chance that someone has, English uses **opportunity** or **chance**; a **possibility** is something that may happen."
    },
    {
      "incorrect": "I didn't have opportunity to visit her.",
      "correct": "I didn't have the opportunity to visit her.",
      "note": "**Opportunity** in this use needs **the**, **an**, or another determiner."
    }
