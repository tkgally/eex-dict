  "synonym_discrimination": {
    "words": [
      "opinion-n",
      "view-n"
    ],
    "note": "**Opinion** is the everyday word for what you think about something: *What's your opinion?* **View** is a little more formal and is often used for beliefs that a person has thought about carefully, especially in the plural: *her political views*. You can say *in my opinion* or *in my view*, but not *in my views*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "According to my opinion, the plan won't work.",
      "correct": "In my opinion, the plan won't work.",
      "note": "**According to** introduces what other people or sources say; for your own opinion, say *in my opinion*."
    },
    {
      "incorrect": "In my opinion, I think the plan is good.",
      "correct": "In my opinion, the plan is good.",
      "note": "*In my opinion* and *I think* say the same thing; use one of them."
    }
