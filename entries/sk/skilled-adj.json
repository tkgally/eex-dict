  "synonym_discrimination": {
    "words": [
      "skilled-adj",
      "skillful-adj"
    ],
    "note": "**Skilled** usually describes the training and experience needed for a job: *a skilled worker*, *skilled labor*. **Skillful** describes how well someone does something, and is common with actions as well as people: *a skillful pass*, *a skillful driver*. Use **skilled**, not **skillful**, for kinds of work: *skilled jobs*."
  },
  "usage_note": null,
