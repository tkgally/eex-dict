  "synonym_discrimination": {
    "words": [
      "journey-n",
      "trip-n",
      "travel-n",
      "voyage-n"
    ],
    "note": "A **trip** is the everyday word for going somewhere and coming back, often for a short time or for pleasure: *a business trip*, *a trip to the beach*. A **journey** is the act of going from one place to another, often a long way: *a long train journey*. **Travel** is uncountable and means traveling in general: *Travel is expensive*. A **voyage** is a long journey by sea or in space."
  },
  "usage_note": "In American English, **trip** is more usual than **journey** for ordinary travel, and **journey** is used especially for long or difficult travel. In British English, **journey** is an everyday word: *How was your journey?*",
  "learner_errors": [
    {
      "incorrect": "We had a nice travel to the coast.",
      "correct": "We had a nice journey to the coast.",
      "note": "**Travel** is uncountable; for one act of traveling, use **journey** or **trip**."
    },
    {
      "incorrect": "They did a long journey across the desert.",
      "correct": "They made a long journey across the desert.",
      "note": "The usual verbs are **make** or **go on**, not **do**."
    }
  ],
