  "synonym_discrimination": {
    "words": [
      "job-n",
      "work-n",
      "task-n"
    ],
    "note": "**Work** in the meaning of paid work is uncountable: *I have a lot of work*, *She goes to work at eight*. **Job** is countable and means one position that you are paid for: *He has two jobs*. A **task** is one particular piece of work, often one that you are given: *My first task was to check the list*."
  },
  "usage_note": "To ask about someone's job, people usually say *What do you do?* or *What do you do for a living?*. *What is your job?* is correct but can sound direct.",
  "learner_errors": [
    {
      "incorrect": "I'm looking for a work.",
      "correct": "I'm looking for a job.",
      "note": "**Work** meaning paid work is uncountable, so it cannot follow **a**. Use **a job**, or *I'm looking for work*."
    },
    {
      "incorrect": "She makes her job very well.",
      "correct": "She does her job very well.",
      "note": "The verb with **job** is **do**, not **make**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**Job** is countable but **work** in the same meaning is uncountable: *a job*, *two jobs*, but *some work*, never *a work* for paid work. Many languages use one countable word for both.",
