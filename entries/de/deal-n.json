  "synonym_discrimination": null,
  "usage_note": "**A great deal of** and **a good deal of** go with uncountable nouns (*a great deal of money*); with plural nouns use **a great many**, **many**, or **a lot of** (*a lot of people*, not *a great deal of people*). *It's a deal!* is an informal way to say you accept an offer.",
  "learner_errors": [
    {
      "incorrect": "A great deal of people came.",
      "correct": "A great many people came.",
      "note": "**A great deal of** goes with uncountable nouns; for plural nouns use **a great many** or **a lot of**."
    },
    {
      "incorrect": "I got a good deal of this phone.",
      "correct": "I got a good deal on this phone.",
      "note": "A good price is **a good deal on** something; **a good deal of** means a large amount."
    }
