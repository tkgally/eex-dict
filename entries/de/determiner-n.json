        ],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "In \"my old car,\" the determiner is \"my.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "A singular countable noun usually needs a determiner: \"a dog,\" not \"dog.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "Numbers such as \"two\" and \"three\" can also be determiners.",
          "note": null,
          "pattern": null
        }
