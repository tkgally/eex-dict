  "senses": [
    {
      "n": 1,
      "signpost": "grammar",
      "definition": "a word such as **the**, **a**, **this**, **some**, **every**, or **my** that comes before a noun to show which thing is meant or how many",
      "explanation": "A **determiner** comes first in a noun phrase, before any adjectives: *the big house*, *some fresh bread*. Usually only one is used at a time, so English says *my car* or *the car*, not *the my car*.",
      "grammar": {
        "countability": "countable",
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
