  "synonym_discrimination": null,
  "usage_note": "**Dead** is the adjective for the state; **die** is the verb for the event, and **death** is the noun: *He died last year*, *he has been dead for a year*, *after his death*. In *dead tired* and *dead right*, **dead** is an adverb, with its own entry.",
  "learner_errors": [
    {
      "incorrect": "He was died last year.",
      "correct": "He died last year.",
      "note": "For the event, use the verb **died**; **dead** describes the state after it."
    },
    {
      "incorrect": "My grandfather is died.",
      "correct": "My grandfather is dead.",
      "note": "After **be**, use the adjective **dead**: *She is dead*, *They have been dead for years*."
    }
  ],
  "etymology": null,
