  "synonym_discrimination": null,
  "usage_note": "**Delay** is used for anything that happens later than planned, such as trains, flights, traffic, deliveries, and replies: *sorry for the delay* is common when you answer a message slowly.",
  "learner_errors": [
    {
      "incorrect": "I'm sorry for my delay to the meeting.",
      "correct": "I'm sorry I'm late for the meeting.",
      "note": "For a person who arrives after the arranged time, **be late** is the usual expression."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"delay\": some languages use one word both for a person being late and for a train being delayed. In English a person who arrives after the arranged time is usually **late**; **delay** is used for events, journeys, and processes.",
