  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**With** always comes before the object: *deal with it*, never *deal it with*. The passive keeps **with** at the end: *It has been dealt with*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The past form **dealt** rhymes with **felt**; the vowel is short, not the long sound of **deal**."
