  "synonym_discrimination": {
    "words": [
      "decide-v",
      "choose-v"
    ],
    "note": "**Decide** is about reaching a conclusion, often about what to do: *We decided to leave early*. **Choose** is about picking one thing from a set: *She chose the blue dress*. With a to-infinitive, **decide** is much more usual: *He decided to study law*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I decided going home.",
      "correct": "I decided to go home.",
      "note": "**Decide** is followed by a to-infinitive, not an **-ing** form."
    },
    {
      "incorrect": "We decided about the date of the party.",
      "correct": "We decided on the date of the party.",
      "note": "Use **decide on** when you choose one thing from several possibilities."
    }
  ],
