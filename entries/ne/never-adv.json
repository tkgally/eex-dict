  "synonym_discrimination": null,
  "usage_note": "**Never** usually goes before the main verb (*I never drink coffee*), after **be** (*He's never late*), and after the first helping verb (*I have never been there*). It already makes the sentence negative, so the verb takes no **not**. At the start of a sentence, in formal or literary use, it is followed by a helping verb and then the subject: *Never have I seen such a thing*.",
  "learner_errors": [
    {
      "incorrect": "I don't never eat meat.",
      "correct": "I never eat meat.",
      "note": "**Never** is already negative; do not add **not**."
    },
    {
      "incorrect": "I have been never there.",
      "correct": "I have never been there.",
      "note": "**Never** goes after the first helping verb, before the main verb."
    }
  ],
