  "synonym_discrimination": null,
  "usage_note": "Before **week**, **month**, **year**, and the days of the week, **next** has no **the**: *next Monday* is the coming one. *The next week* means the seven days after now or after a time already named. **Next** is also an adverb (*What happens next?*) and part of the preposition **next to**; those uses are shown at their own entries.",
  "learner_errors": [
    {
      "incorrect": "I will see you the next week.",
      "correct": "I will see you next week.",
      "note": "For the coming week, month, or year, say **next** with no **the**."
    }
  ],
