    {
      "n": 1,
      "signpost": "not necessary",
      "definition": "used in negatives and questions to say whether something is necessary",
      "explanation": "The modal **need** is followed by the base form of a verb without **to**, and has no **-s** after **he**, **she**, or **it**: *he need not come*. The negative is **need not** or **needn't**. It is used mainly in negatives and questions, and with words like **no one** and **only**.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": [
          "verb + bare infinitive"
        ]
      },
