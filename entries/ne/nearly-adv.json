  "synonym_discrimination": {
    "words": [
      "nearly-adv",
      "almost-adv"
    ],
    "note": "Both mean *not quite*, and in most sentences either is fine: *nearly ready*, *almost ready*. Only **almost** is usual before negative words such as **never**, **nobody**, and **nothing** (*almost nobody came*). Usually only **nearly** follows **very** and **not** (*very nearly*, *not nearly enough*)."
  },
  "usage_note": "**Nearly** usually goes before the main verb (*I nearly missed it*), after **be** (*It's nearly time*), or before a number or a word such as **all** or **every** (*nearly twenty people*).",
  "learner_errors": [
    {
      "incorrect": "I nearly never eat meat.",
      "correct": "I almost never eat meat.",
      "note": "Before **never**, **nobody**, or **nothing**, use **almost**, not **nearly**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"nearly\" means \"almost\", not \"in a near way\" or \"closely\". Learners sometimes use it for distance; for distance, English uses \"near\".",
