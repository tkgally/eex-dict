  "synonym_discrimination": {
    "words": [
      "near-adj",
      "close-adj",
      "nearby-adj"
    ],
    "note": "After a verb, **near** and **close** both mean a short distance away: *The station is near*, *The station is close*. For a place close by, use **nearby** or **nearest** before a noun, not plain **near**: *a nearby park*, *the nearest park*; fixed phrases such as *the near future* and *a near miss* are different uses. For people and feelings, use **close**: *a close friend*, not *a near friend*."
  },
  "usage_note": "**Near** is also a preposition (*near the station*) and an adverb (*Come near*); this entry covers only the adjective. **Near** and **nearer** can be followed by **to** (*nearer to the door*), though the form without **to** is more common.",
  "learner_errors": [
    {
      "incorrect": "We had dinner at a near restaurant.",
      "correct": "We had dinner at a nearby restaurant.",
      "note": "For a place close by, plain **near** is not usual before a noun; say **nearby**, or **nearest** for the closest one."
    },
    {
      "incorrect": "She is my near friend.",
      "correct": "She is my close friend.",
      "note": "For friends and relationships, use **close**; **near** in this meaning is used only for relatives, and it is formal."
    }
  ],
