  "synonym_discrimination": {
    "words": [
      "sick-adj",
      "ill-adj",
      "unwell-adj"
    ],
    "note": "In American English, **sick** is the usual word for having an illness: *I'm sick*. In British English, **ill** is more usual after a verb (*She's ill*), and **sick** often means feeling that food will come up (*I feel sick*). Before a noun, **sick** is common in both varieties (*a sick child*), though **ill** is also used, especially after an adverb (*seriously ill patients*). **Unwell** is more formal and polite: *He has been unwell for some time*."
  },
  "usage_note": "**The sick** means sick people as a group: *caring for the sick*. **Carsick**, **seasick**, and **airsick** describe feeling sick while traveling.",
  "learner_errors": [
    {
      "incorrect": "I feel sickness today.",
      "correct": "I feel sick today.",
      "note": "After **feel**, use the adjective **sick**; **sickness** is a noun."
    },
    {
      "incorrect": "I'm sick from waiting.",
      "correct": "I'm sick of waiting.",
      "note": "When you are bored or annoyed, the preposition is **of**."
    }
  ],
