  "synonym_discrimination": null,
  "usage_note": "**Sit down** describes the movement (*she sat down*); **sit** alone usually describes the position (*she was sitting by the window*). In informal British English, *she was sat* is also used for the position, but it is not standard in American English. You **sit on** a chair, a bench, or the floor, but **sit in** an armchair, a car, or a room.",
  "learner_errors": [
    {
      "incorrect": "Please seat.",
      "correct": "Please sit down.",
      "note": "**Seat** needs an object (*seat the guests*) or the passive (*please be seated*); to ask someone to sit, say *sit down*."
    },
    {
      "incorrect": "She was sitting on the car when I called.",
      "correct": "She was sitting in the car when I called.",
      "note": "Inside a car, a room, or an armchair, use **in**; **on** means on top of it."
    },
    {
      "incorrect": "He sitted by the window.",
      "correct": "He sat by the window.",
      "note": "The past tense and past participle are **sat**."
    }
  ],
  "etymology": null,
