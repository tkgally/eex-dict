  "synonym_discrimination": {
    "words": [
      "similar-adj",
      "same-adj",
      "alike-adj"
    ],
    "note": "**The same** means not different at all: *We have the same phone.* **Similar** means almost the same: *We have similar phones.* **Alike** means similar too, but it comes after the verb, never before a noun: *The two phones are alike*, not *alike phones*."
  },
  "usage_note": "Use **to** after **similar** before the thing you compare with: *similar to mine*. Use **in** for the way two things are alike: *similar in size*.",
  "learner_errors": [
    {
      "incorrect": "My answer is similar with yours.",
      "correct": "My answer is similar to yours.",
      "note": "The preposition after **similar** is **to**."
    },
    {
      "incorrect": "Her dress is similar as mine.",
      "correct": "Her dress is similar to mine.",
      "note": "Use **similar to**; **as** goes with **the same**: *the same as mine*."
    }
  ],
