  "synonym_discrimination": {
    "words": [
      "pair-n",
      "couple-n"
    ],
    "note": "A **pair** is two things that are used together (*a pair of shoes*) or one thing with two parts (*a pair of scissors*); two people working together are also a **pair**: *Work in pairs*. A **couple** is usually two people in a romantic relationship, or, informally, about two: *a couple of days*."
  },
  "usage_note": "After **a pair of**, the verb is usually singular: *This pair of shoes is new*. When **pair** means two people, the verb can be plural, especially in British English: *The pair were seen leaving together*.",
  "learner_errors": [
    {
      "incorrect": "I bought a new pants.",
      "correct": "I bought a new pair of pants.",
      "note": "Words such as **pants**, **jeans**, **scissors**, and **glasses** are plural; count them with **a pair of**."
    },
    {
      "incorrect": "She has a pair of new sock.",
      "correct": "She has a pair of new socks.",
      "note": "The noun after **a pair of** is plural."
    }
  ],
