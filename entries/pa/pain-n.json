  "synonym_discrimination": {
    "words": [
      "pain-n",
      "ache-n"
    ],
    "note": "**Pain** is the general word, for any feeling of being hurt, from slight to very strong, sudden or lasting: *a sharp pain in my foot*. An **ache** is a dull pain that goes on for some time, often in a muscle: *an ache in my legs*. **-ache** also forms words for common pains: *headache*, *toothache*, *stomachache*."
  },
  "usage_note": "**Pain** is uncountable for pain in general (*She was in pain*) and countable for one particular feeling in one place (*a pain in my side*). For some parts of the body English uses a word ending in **-ache**: *a headache*, *a toothache*.",
  "learner_errors": [
    {
      "incorrect": "My head is paining.",
      "correct": "My head hurts.",
      "note": "In most varieties of English a part of the body **hurts** or **aches**; **pain** as a verb is rare."
    }
  ],
