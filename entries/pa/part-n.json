  "synonym_discrimination": {
    "words": [
      "part-n",
      "piece-n",
      "section-n"
    ],
    "note": "A **part** is any of the things that make up a whole, separate or not: *part of the problem*, *the first part of the movie*. A **piece** is a part that has been cut or broken off, or one single item: *a piece of cake*. A **section** is a part that is clearly separate from the others, especially in a building, a document, or a group: *the sports section of the newspaper*."
  },
  "usage_note": "**Part of** often has no **a** before it when it means some of something: *I spent part of the day reading*. **A part of** is also possible, especially for one member of a group: *She feels a part of the team*. With a singular or uncountable noun after **of**, the verb is singular: *Part of the cake was eaten*.",
  "learner_errors": [
    {
      "incorrect": "I took part of the competition.",
      "correct": "I took part in the competition.",
      "note": "**Take part** is followed by **in**."
    },
    {
      "incorrect": "Most part of the students passed.",
      "correct": "Most of the students passed.",
      "note": "Say **most of**, not **most part of**."
    }
  ],
