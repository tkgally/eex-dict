  "usage_note": "You **pay** a person or a bill, but you **pay for** the thing you buy: *I paid the waiter*, *I paid the bill*, *I paid for the meal*.",
  "learner_errors": [
    {
      "incorrect": "I paid the dinner.",
      "correct": "I paid for the dinner.",
      "note": "Use **pay for** before the thing you buy."
    },
    {
      "incorrect": "Please pay attention on the road.",
      "correct": "Please pay attention to the road.",
      "note": "The phrase is **pay attention to**."
    }
