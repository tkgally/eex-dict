      "pronunciation": null,
      "examples": [
        {
          "text": "The past participle of \"go\" is \"gone.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "Learners have to learn the irregular past participles one by one.",
          "note": null,
          "pattern": null
        },
