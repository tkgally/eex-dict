  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "a person who is not named or not known, or whose identity does not matter",
      "explanation": "**Someone** is most common in positive statements: *someone called for you*. In questions and negatives, **anyone** is usual when the answer could be no one: *did anyone see my keys?*, *I didn't see anyone*. **Someone** stays natural in questions that expect the answer yes, and in offers and requests: *did someone call?*, *could someone help me?*",
      "grammar": {
        "countability": null,
        "transitivity": null,
