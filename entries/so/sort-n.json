  "synonym_discrimination": {
    "words": [
      "sort-n",
      "kind-n",
      "type-n"
    ],
    "note": "**Sort** and **kind** mean the same and are both common in speech: *what sort of music?*; **sort** is a little more informal and more usual in British English. **Type** is more usual in formal and technical writing: *a new type of engine*."
  },
  "usage_note": "In careful writing, **sort of** is followed by a noun without **a**: *what sort of car*. With a plural, *these sorts of problems* is the careful form; *these sort of problems* is common in speech, but many people think it is wrong. **Sort of** as a phrase (*I'm sort of tired*) is informal and belongs in speech, not in serious writing.",
  "learner_errors": [
    {
      "incorrect": "They sell all sort of things.",
      "correct": "They sell all sorts of things.",
      "note": "After **all**, use the plural **sorts**."
    },
    {
      "incorrect": "I'm a sort of tired.",
      "correct": "I'm sort of tired.",
      "note": "Meaning *a little*, the phrase is **sort of** with no **a**."
    }
  ],
