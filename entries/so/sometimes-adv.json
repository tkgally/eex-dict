  "synonym_discrimination": null,
  "usage_note": "**Sometimes** can go at the start of a sentence, before the main verb, after **be**, or at the end: *Sometimes I'm late*, *I'm sometimes late*, *I'm late sometimes*. Do not confuse it with **sometime**, which means *at a time that is not known*: *Call me sometime*.",
  "learner_errors": [
    {
      "incorrect": "Sometime I go swimming after work.",
      "correct": "Sometimes I go swimming after work.",
      "note": "For *at some times*, the word ends in **-s**: **sometimes**."
    },
    {
      "incorrect": "I eat sometimes meat.",
      "correct": "I sometimes eat meat.",
      "note": "**Sometimes** does not go between a verb and its object; put it before the main verb, or at the start or the end."
    }
