  "synonym_discrimination": {
    "words": [
      "some-det",
      "any-det"
    ],
    "note": "Some goes in positive statements and in offers and requests: I have some money; would you like some cake? Any goes in questions and negatives: do you have any money? I do not have any money. In a positive statement, any means it does not matter which: take any seat."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I don't have some money.",
      "correct": "I don't have any money.",
      "note": "After not, use any, not some."
    },
    {
      "incorrect": "Do you have some brothers or sisters?",
      "correct": "Do you have any brothers or sisters?",
      "note": "A question that really asks takes any; some is kept for an offer or a request, or when you expect the answer yes: Would you like some tea?"
    },
    {
      "incorrect": "some of people",
      "correct": "some people",
      "note": "Some of is used only before the, my, this, and pronouns: some of the people, some of them."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "The amount sense (some milk) and the unknown-one sense (some man called) are often different words in other languages, and the first often has no translation at all: I need some milk is simply I need milk.",
    "grammar": "Some marks an unstated amount and shifts to any in questions and negatives, a change many languages do not make: I have some money; do you have any money? Before the, my, this, or a pronoun, use some of: some of my friends.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Weak səm for the amount sense (some milk, some people); strong sʌm when some means an unknown one or not all, and when it is stressed or stands alone."
  },
