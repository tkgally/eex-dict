  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "a person who is not named or not known, or whose identity does not matter",
      "explanation": "**Somebody** is most common in positive statements: *somebody called for you*. In questions and negatives, **anybody** is usual when the answer could be nobody: *did anybody see my keys?*, *I didn't see anybody*. **Somebody** stays natural in questions that expect the answer yes, and in offers and requests: *did somebody call?*, *could somebody help me?*",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
