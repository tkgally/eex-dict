  "word_family": [],
  "synonym_discrimination": {
    "words": [
      "so-adv",
      "very-adv",
      "such-det"
    ],
    "note": "**Very** and **so** both go before an adjective alone: *very tired*, *so tired*. **So** sounds stronger and more emotional, and it can lead to a result: *so tired that I fell asleep*. Before a noun, with or without an adjective, use **such**: *such a long day*, *such nice people*."
  },
  "usage_note": "This entry covers **so** before an adjective or an adverb and **so** standing for words already said. **So** joining two clauses (*It rained, so we stayed in*) is a conjunction, a separate entry.",
  "learner_errors": [
    {
      "incorrect": "It was so nice day.",
      "correct": "It was such a nice day.",
      "note": "Before an adjective with a noun, use **such a**, not **so**."
    },
    {
      "incorrect": "\"Is she coming?\" \"I think it.\"",
      "correct": "\"Is she coming?\" \"I think so.\"",
      "note": "After **think** or **hope**, use **so** to stand for the idea already said."
    },
    {
      "incorrect": "\"I like tea.\" \"So I do.\"",
      "correct": "\"I like tea.\" \"So do I.\"",
      "note": "To agree with a positive statement, put the helping verb before the subject: *So do I*, *So am I*."
    }
  ],
