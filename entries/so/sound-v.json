  "synonym_discrimination": null,
  "usage_note": "In the first two senses **sound** is a linking verb. It is followed by an adjective (*sounds good*), by **like** and a noun (*sounds like a good idea*), or by **as if** or **as though** and a clause. In informal American speech, **sounds like** is also used before a clause (*Sounds like you had fun*).",
  "learner_errors": [
    {
      "incorrect": "Your plan sounds well.",
      "correct": "Your plan sounds good.",
      "note": "**Sound** as a linking verb is followed by an adjective, not an adverb."
    },
    {
      "incorrect": "It sounds that he is busy.",
      "correct": "It sounds as if he is busy.",
      "note": "Use **as if**, **as though**, or **like**, not **that**, after **it sounds**."
    }
  ],
