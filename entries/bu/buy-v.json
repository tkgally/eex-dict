  "synonym_discrimination": null,
  "usage_note": "**Buy** takes two patterns for the person who gets the thing: *buy someone something* (*I bought her a coat*) or *buy something for someone* (*I bought a coat for her*). The person you get it from takes **from**: *I bought it from a friend*. The price takes **for**: *I bought it for ten dollars*.",
  "learner_errors": [
    {
      "incorrect": "He buyed a new phone.",
      "correct": "He bought a new phone.",
      "note": "The past tense is irregular: **bought**, not **buyed**."
    },
    {
      "incorrect": "I brought a new car last week.",
      "correct": "I bought a new car last week.",
      "note": "**Bought**, with no **r**, is the past of **buy**; **brought** is the past of **bring**."
    },
    {
      "incorrect": "She bought to me a present.",
      "correct": "She bought me a present.",
      "note": "With two objects there is no **to**; or say *She bought a present for me*."
    }
  ],
  "etymology": null,
