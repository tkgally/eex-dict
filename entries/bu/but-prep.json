    {
      "n": 1,
      "signpost": null,
      "definition": "except; not including",
      "explanation": "This **but** is used after words like **all**, **every**, **everyone**, **nothing**, **no one**, **anything**, and **nobody**, and after question words such as **who** and **what**. After **do**, a verb that follows **but** takes the base form: *do nothing but wait*, *what could I do but say yes?*",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
