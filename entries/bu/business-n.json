  "synonym_discrimination": {
    "words": [
      "business-n",
      "company-n",
      "firm-n"
    ],
    "note": "**Business** is the general word for any organization that sells goods or services, from a small shop to a large bank: *a family business*. **Company** often suggests a larger, formally organized business with a name: *She works for a software company*. **Firm** is used especially for a business that sells a professional service: *a law firm*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm going to the city for a business.",
      "correct": "I'm going to the city on business.",
      "note": "When **business** means work, it is uncountable; a work trip is *on business*."
    },
    {
      "incorrect": "She has many businesses to do today.",
      "correct": "She has a lot of things to do today.",
      "note": "For tasks, use **work** or **things to do**; **businesses** means companies."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "**business** covers trade in general (*business is good*), a single company (*a small business*), and a personal matter (*that's my business*). Many languages use different words for these; check the sense before translating.",
    "grammar": "In the trade sense **business** is uncountable: *We do a lot of business with them*. The plural **businesses** usually means companies; for tasks, use **work** or **things to do**.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "**business** has two syllables, *BIZ-nuhss*: the **i** after the **s** is silent, and the **u** sounds like the **i** of **sit**."
  },
