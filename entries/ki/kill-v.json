  "synonym_discrimination": {
    "words": [
      "kill-v",
      "murder-v"
    ],
    "note": "**Kill** is the general word for causing death, on purpose or not, and it can be used about people, animals, plants, illness, and accidents: *the frost killed the flowers*. **Murder** is only used when a person kills another person on purpose and against the law: *he was accused of murdering his neighbor*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "He was killed by a car accident.",
      "correct": "He was killed in a car accident.",
      "note": "Use **in** with an event such as an accident or a war; **by** goes with the thing or person that caused the death: *killed by a falling tree*."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"kill\" has many uses that are not about death (senses 3 to 6: pain, anger, time, and machines). A translator should not use a word for *cause death* in those senses.",
