  "synonym_discrimination": {
    "words": [
      "kind-n",
      "sort-n",
      "type-n"
    ],
    "note": "**Kind** and **sort** mean the same and are both common in speech: *what kind of music?*; **sort** is more usual in British English and a little more informal. **Type** is more usual in formal and technical writing: *a new type of engine*."
  },
  "usage_note": "In careful writing, **kind of** is followed by a noun without **a**: *what kind of car*; *what kind of a car* is heard in informal speech. With a plural, *these kinds of problems* is the careful form; *these kind of problems* is common in speech but many people think it is wrong. For **kind** meaning friendly and generous, see the adjective.",
  "learner_errors": [
    {
      "incorrect": "They sell all kind of things.",
      "correct": "They sell all kinds of things.",
      "note": "After **all**, use the plural **kinds**."
    },
    {
      "incorrect": "What kind of a music do you like?",
      "correct": "What kind of music do you like?",
      "note": "Do not use **a** after **kind of** before an uncountable noun."
    }
  ],
