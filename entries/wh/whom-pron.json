        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "Whom did you invite to the wedding?",
          "note": null,
          "pattern": null
        },
        {
          "text": "To whom should I address the letter?",
          "note": null,
          "pattern": null
        },
