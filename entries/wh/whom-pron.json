  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "the object form of **who**",
      "explanation": "**Whom** is used, mainly in formal writing, to ask about or refer to a person as the object of a verb or right after a preposition. Directly after a preposition, careful English uses **whom**: *the person to whom I spoke*. Elsewhere, as an object relative pronoun, **whom** can often be left out altogether: *the person I spoke to*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
