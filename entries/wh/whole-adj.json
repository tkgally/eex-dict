  "synonym_discrimination": {
    "words": [
      "whole-adj",
      "all-det",
      "entire-adj"
    ],
    "note": "**Whole** comes after **the**, **a**, or a word like **my**, and goes with a singular noun: *the whole day*, *my whole life*. **All** comes before these words, or with no word at all: *all the money*, *all day*. **Entire** means the same as **whole** but is a little stronger and more formal: *the entire building*."
  },
  "usage_note": "**The whole** goes before a singular noun: *the whole class*. Before a plural noun, **all** is more usual (*all the classes*), but *whole families* and *whole cities* are possible when they mean complete families or cities. Before a name or a pronoun use **the whole of**: *the whole of it* (see the noun).",
  "learner_errors": [
    {
      "incorrect": "Whole the day it rained.",
      "correct": "It rained the whole day.",
      "note": "**Whole** comes after **the**; **all** comes before it: *all day*."
    },
    {
      "incorrect": "The whole people were happy.",
      "correct": "All the people were happy.",
      "note": "Use **all** with a plural noun meaning every one of a group."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**Whole** follows the article (*the whole day*), while **all** goes before it (*all the time*); learners often put the two words in the wrong order.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "**Whole** sounds exactly the same as **hole**; the **w** is not spoken."
  },
