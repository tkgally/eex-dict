  "synonym_discrimination": {
    "words": [
      "rich-adj",
      "wealthy-adj",
      "well-off-adj"
    ],
    "note": "**Rich** is the general word: *a rich family*. **Wealthy** means the same but sounds a little more formal: *wealthy investors*. **Well off** means having enough money to live comfortably, usually less than **rich**: *They're not rich, but they're well off*."
  },
  "usage_note": "**The rich** means rich people as a group and takes a plural verb: *The rich are getting richer*.",
  "learner_errors": [
    {
      "incorrect": "Carrots are rich of vitamins.",
      "correct": "Carrots are rich in vitamins.",
      "note": "The preposition after **rich** in this sense is **in**."
    },
    {
      "incorrect": "He wants to become a rich.",
      "correct": "He wants to become rich.",
      "note": "**Rich** is an adjective, so it takes no **a**; say **a rich man** or **a rich person** if you need a noun."
    }
  ],
