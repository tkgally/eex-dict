  "synonym_discrimination": {
    "words": [
      "rise-v",
      "raise-v"
    ],
    "note": "**Rise** has no object: something rises by itself: *Prices rose*. **Raise** has an object: someone raises something: *The shop raised its prices*. The past forms are different too: **rose**, **risen** against **raised**."
  },
