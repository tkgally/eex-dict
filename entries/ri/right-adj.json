  "synonym_discrimination": {
    "words": [
      "right-adj",
      "correct-adj"
    ],
    "note": "**Right** is the everyday word for an answer or a fact that is not wrong: *You're right*. **Correct** means the same but sounds a little more formal and careful, and is common in instructions and tests: *Choose the correct answer*. **Right** is the usual word for what is fair or morally good: *the right thing to do*."
  },
  "usage_note": "**Right** is also an adverb (*turn right*, *right now*) and a noun (*on the right*, *human rights*); these are separate entries. **That's right** is a common way to agree with what someone has said.",
  "learner_errors": [
    {
      "incorrect": "You have right.",
      "correct": "You're right.",
      "note": "In English a person **is** right; do not use **have**."
    },
    {
      "incorrect": "She is right person for this job.",
      "correct": "She is the right person for this job.",
      "note": "Before a noun in the suitable sense, **right** almost always follows **the**."
    }
  ],
