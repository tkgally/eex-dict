  "synonym_discrimination": null,
  "usage_note": "**Shout at** someone usually means you are angry with them: *don't shout at the children*. **Shout to** someone means you speak loudly so that they can hear you from far away: *she shouted to her friend across the field*.",
  "learner_errors": [
    {
      "incorrect": "He shouted to me because I broke the window.",
      "correct": "He shouted at me because I broke the window.",
      "note": "Angry shouting is **shout at** someone; **shout to** someone is to be heard from far away."
    },
    {
      "incorrect": "She shouted me to come back.",
      "correct": "She shouted to me to come back.",
      "note": "**Shout** needs **to** or **at** before the person: *shouted to me* to be heard, *shouted at me* in anger."
    }
  ],
