  "synonym_discrimination": {
    "words": [
      "shake-v",
      "tremble-v",
      "shiver-v"
    ],
    "note": "**Shake** is the general word for quick movements, on purpose or not: *shake the bottle*, *my hands were shaking*. **Tremble** is for small movements of the body you cannot control, often from fear or strong feeling: *her lips trembled*. **Shiver** is for shaking because you are cold, or sometimes afraid: *we stood shivering at the bus stop*."
  },
  "usage_note": "In English-speaking countries, shaking your head usually means *no* or shows disapproval, sadness, or surprise, and nodding means *yes*; head movements do not mean the same everywhere. *Shake hands* is a common way to greet someone in a formal or business meeting.",
  "learner_errors": [
    {
      "incorrect": "He shaked my hand.",
      "correct": "He shook my hand.",
      "note": "The past tense is **shook** and the past participle is **shaken**."
    },
    {
      "incorrect": "We shook our hands.",
      "correct": "We shook hands.",
      "note": "In the greeting, say **shake hands** with no possessive; *shake someone's hand* is also correct."
    }
  ],
