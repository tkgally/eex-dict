  "synonym_discrimination": {
    "words": [
      "shy-adj",
      "timid-adj",
      "embarrassed-adj"
    ],
    "note": "**Shy** describes someone who is nervous with other people, especially new people: *a shy child*. **Timid** is wider and describes someone who is easily frightened and lacks courage in general: *too timid to complain*. **Embarrassed** describes how you feel after something makes you look silly: *I was embarrassed when I fell over*."
  },
  "usage_note": "**-shy** is added to some nouns to mean *not liking* or *avoiding* something: *camera-shy* (not liking to be photographed), *work-shy* (not wanting to work).",
  "learner_errors": [
    {
      "incorrect": "I'm shame to speak in front of the class.",
      "correct": "I'm too shy to speak in front of the class.",
      "note": "**Shame** is a noun; for this feeling, use the adjective **shy**, often with **too**."
    }
  ],
