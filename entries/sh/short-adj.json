  "synonym_discrimination": {
    "words": [
      "short-adj",
      "brief-adj"
    ],
    "note": "**Short** is the everyday word for length, height, and time: *a short walk*, *a short meeting*. **Brief** is used only for time or for something said or written, and sounds a little more formal: *a brief visit*, *a brief statement*."
  },
  "usage_note": "For people, **short** describes height; for a person who is not fat, use **thin** or **slim**. **Shortly** does not mean *in a short way*; it means *soon*: *I'll be there shortly*.",
  "learner_errors": [
    {
      "incorrect": "I have short of money.",
      "correct": "I'm short of money.",
      "note": "Use **be short of something**, not **have short of**."
    }
  ],
