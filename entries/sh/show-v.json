  "synonym_discrimination": null,
  "usage_note": "The past participle is usually **shown** (*I have shown him the report*); **showed** is also used (*has showed*) but is less common. In the passive, **shown** is much more usual: *the film was shown on TV*. With two objects there is no **to** before the person: *show me the photos*; with **to**, the thing comes first: *show the photos to me*.",
  "learner_errors": [
    {
      "incorrect": "Show to me your ticket, please.",
      "correct": "Show me your ticket, please.",
      "note": "The person comes directly after **show**, with no **to**; or say *show your ticket to me*."
    },
    {
      "incorrect": "Can you show me where is the station?",
      "correct": "Can you show me where the station is?",
      "note": "After **show someone where**, **how**, or **what**, use normal statement word order."
    }
  ],
