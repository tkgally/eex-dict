  "synonym_discrimination": null,
  "usage_note": "**Go shopping** is the everyday way to talk about the activity: *let's go shopping*. **Do the shopping** means buying food and things for the home. American English uses **store** for the place, but the verb is **shop** everywhere.",
  "learner_errors": [
    {
      "incorrect": "I went to shopping yesterday.",
      "correct": "I went shopping yesterday.",
      "note": "**Go** + **-ing** for activities has no **to**: *go shopping*, *go swimming*."
    },
    {
      "incorrect": "She shoped all day.",
      "correct": "She shopped all day.",
      "note": "The **p** is doubled: **shopped**, **shopping**."
    }
  ],
