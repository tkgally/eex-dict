  "synonym_discrimination": {
    "words": [
      "shadow-n",
      "shade-n"
    ],
    "note": "**Shade** is an area out of the sun, usually pleasant and cooler: *sit in the shade*. **Shadow** is the dark shape that something makes when it blocks light (*the shadow of the tree*), or a dark area where it is hard to see (*in the shadows*). On a hot day you rest in the shade, not in the shadow."
  },
  "usage_note": null,
