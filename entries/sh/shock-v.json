  "synonym_discrimination": null,
  "usage_note": "The person who feels the shock is usually the subject of a passive verb or of the adjective **shocked**: *I was shocked*. The thing that causes it is **shocking**: *the news was shocking*. After **shocked**, use **by** or **at** before a noun, or a to-infinitive: *shocked at the price*, *shocked to see him*. For electricity (sense 3), **get a shock** is more common in everyday speech: *I got a shock from the lamp*.",
  "learner_errors": [
    {
      "incorrect": "I was shocking when I heard the news.",
      "correct": "I was shocked when I heard the news.",
      "note": "The person who feels it is **shocked**; the thing that causes it is **shocking**."
    },
    {
      "incorrect": "We were shocked of the price.",
      "correct": "We were shocked by the price.",
      "note": "After **shocked**, use **by** or **at**, not **of**."
    }
  ],
