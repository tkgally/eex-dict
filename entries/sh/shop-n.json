  "synonym_discrimination": {
    "words": [
      "shop-n",
      "store-n"
    ],
    "note": "In American English, **store** is the general word for a place that sells things (*a grocery store*, *a department store*); **shop** is used mainly for a small place that sells one kind of thing (*a coffee shop*, *a gift shop*). In British English, **shop** is the general word, and **store** is used mainly for a very large shop (*a department store*)."
  },
