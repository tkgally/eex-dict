  "synonym_discrimination": {
    "words": [
      "shame-n",
      "pity-n"
    ],
    "note": "**It's a shame** and **it's a pity** mean the same and are both very common: *It's a shame you missed the show*, *It's a pity you missed the show*. Only **shame** also names the bad feeling of having done wrong: *a sense of shame*."
  },
  "usage_note": "**A shame** (sense 3) has nothing to do with guilt: *It's a shame* means *I am sorry about it* or *it is disappointing*, and it is polite and very common. The feeling in sense 1 takes no **a**: *feel shame*. To talk about your own feeling, the adjective **ashamed** is more usual: *I'm ashamed of myself*.",
  "learner_errors": [
    {
      "incorrect": "I felt a big shame.",
      "correct": "I felt very ashamed.",
      "note": "For your own feeling, use the adjective **ashamed**; the noun for the feeling takes no **a**."
    },
    {
      "incorrect": "It's shame that you missed it.",
      "correct": "It's a shame that you missed it.",
      "note": "In the meaning *something you are sorry about*, **shame** needs **a**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"a shame\" in *it's a shame* means *it is sad or disappointing*, with no idea of guilt; many languages use a different word for this than for the feeling of shame.",
