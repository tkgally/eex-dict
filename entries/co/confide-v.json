  "synonym_discrimination": null,
  "usage_note": "With **confide**, the person told never comes directly after the verb: it follows **to** (*confide something to someone*, *confide to someone that...*) or **in** (*confide in someone*).",
  "learner_errors": [
    {
      "incorrect": "She confided me her secret.",
      "correct": "She confided her secret to me.",
      "note": "**Confide** cannot take two objects; the person comes after **to**."
    },
    {
      "incorrect": "He confided me that he was leaving.",
      "correct": "He confided to me that he was leaving.",
      "note": "Before a that-clause, the person still needs **to**."
    },
    {
      "incorrect": "I can confide to her.",
      "correct": "I can confide in her.",
      "note": "To mean *trust someone with private things*, use **confide in**."
    }
  ],
