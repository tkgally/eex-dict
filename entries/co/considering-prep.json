  "synonym_discrimination": {
    "words": [
      "considering-prep",
      "given-prep"
    ],
    "note": "Both mean taking a fact into account. **Given** usually gives a reason for what follows (*Given the rain, we stayed at home*). **Considering** often brings in a fact that makes the result surprising (*She played well, considering her injury*)."
  },
  "usage_note": "**Considering that** before a full clause is the conjunction (*considering that she had no training*). Standing alone at the end of a sentence, it is an adverb (*She did quite well, considering*).",
  "learner_errors": [
    {
      "incorrect": "Considering of the price, the hotel was good.",
      "correct": "Considering the price, the hotel was good.",
      "note": "No preposition follows **considering**."
    }
  ],
