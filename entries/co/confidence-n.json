  "synonym_discrimination": null,
  "usage_note": "The preposition after **confidence** depends on the meaning: **confidence in** someone or something you trust (*confidence in the doctor*), and **confidence that** something will happen. Feeling sure of yourself is just **confidence** or **self-confidence**.",
  "learner_errors": [
    {
      "incorrect": "I have confidence to my teacher.",
      "correct": "I have confidence in my teacher.",
      "note": "Trust in a person takes **in**, not **to**."
    },
    {
      "incorrect": "She has a big confidence.",
      "correct": "She has a lot of confidence.",
      "note": "In these senses **confidence** is uncountable: no **a**. Say *a lot of confidence* or *great confidence*."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"confidence\" covers trust in yourself, trust in others, and trust that a secret will be kept; many languages use different words for these.",
    "grammar": "\"confidence\" is uncountable in its main senses: *a lot of confidence*, not *a confidence*. It takes **in** for trust: *confidence in her*.",
