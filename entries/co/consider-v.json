  "synonym_discrimination": null,
  "usage_note": "**Consider** is followed by an **-ing** form, not a **to**-infinitive, when it means *think about doing something*: *consider moving*. In the sense *have an opinion*, **to be** after the object is often left out: *I consider him (to be) honest*.",
  "learner_errors": [
    {
      "incorrect": "I'm considering to buy a new car.",
      "correct": "I'm considering buying a new car.",
      "note": "After **consider** use the **-ing** form, not **to** plus a verb."
    }
  ],
