  "synonym_discrimination": {
    "words": [
      "come-v",
      "go-v"
    ],
    "note": "Use **come** for movement toward the place where the speaker or the listener is, or will be, and **go** for movement to some other place. When someone calls you, you usually say *I'm coming*, not *I'm going*. When you invite someone, say *Can you come to my party?*"
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm going! (answering someone who called you)",
      "correct": "I'm coming!",
      "note": "When you move toward the person who is calling you, English usually uses **come**."
    },
    {
      "incorrect": "He has came home.",
      "correct": "He has come home.",
      "note": "The past participle of **come** is **come**; **came** is only the past tense."
    }
  ],
