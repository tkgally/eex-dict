  "synonym_discrimination": {
    "words": [
      "country-n",
      "nation-n",
      "state-n"
    ],
    "note": "**Country** is the everyday word for a land with its own government (*travel to another country*). **Nation** puts the people first, as a group with one history and culture, and is more formal (*the whole nation was proud*). **State** is more formal and treats a country as a political unit with one government (*a member state*, *a new state*); in some countries a **state** is also one part of the country with its own government."
  },
