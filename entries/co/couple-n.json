  "synonym_discrimination": {
    "words": [
      "couple-n",
      "pair-n"
    ],
    "note": "**A pair** is two things that belong together and are used as one (*a pair of shoes*), or one thing with two parts (*a pair of scissors*). **A couple of** often means *two or three* in everyday speech (*a couple of minutes*). For two people in a relationship, use **couple**: *a married couple*."
  },
  "usage_note": "**A couple of** is less exact than **two**: *a couple of days* can mean two or three days. Use **two** when the exact number matters.",
  "learner_errors": [
    {
      "incorrect": "I waited couple of minutes.",
      "correct": "I waited a couple of minutes.",
      "note": "**Couple** in this sense always needs **a** in front."
    },
    {
      "incorrect": "There were a couple of person at the door.",
      "correct": "There were a couple of people at the door.",
      "note": "**A couple of** is followed by a plural noun."
    }
  ],
  "etymology": null,
