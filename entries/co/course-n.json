  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Of course** as an answer is polite and friendly when someone asks for permission or help (*Of course you can*). As an answer to a question of fact, it can suggest that the question was not necessary, so some listeners hear it as rude. **Yes**, **sure**, or a short answer such as *Yes, I do* are safer.",
  "learner_errors": [
    {
      "incorrect": "I'm taking a course of English.",
      "correct": "I'm taking a course in English.",
      "note": "A course of lessons is usually **in** a subject (**on** is also used for a topic); **a course of** is for medicine or treatment."
    },
    {
      "incorrect": "We had a three courses meal.",
      "correct": "We had a three-course meal.",
      "note": "Before a noun, the number and **course** are joined with a hyphen and **course** stays singular."
    }
  ],
  "etymology": null,
