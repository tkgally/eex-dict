  "synonym_discrimination": {
    "words": [
      "cook-v",
      "make-v"
    ],
    "note": "Use **cook** when food is heated: *cook pasta*, *cook dinner*. Use **make** for any food or drink that is prepared, heated or not: *make a salad*, *make a sandwich*, *make coffee*. **Make dinner** and **cook dinner** are both common."
  },
