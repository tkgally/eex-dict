  "synonym_discrimination": null,
  "usage_note": "**According to** passes a claim on and keeps a little distance from it: *According to the report, sales went up* tells the reader where the claim comes from, not that the writer is sure it is true.",
  "learner_errors": [
    {
      "incorrect": "According to me, the film is too long.",
      "correct": "In my opinion, the film is too long.",
      "note": "**According to** reports what other people or sources say; for your own view, use *in my opinion* or *I think*."
    },
    {
      "incorrect": "According the news, the road is closed.",
      "correct": "According to the news, the road is closed.",
      "note": "The phrase always includes **to**."
    },
    {
      "incorrect": "According to the doctor, he says I need rest.",
      "correct": "According to the doctor, I need rest.",
      "note": "**According to** already shows who said it, so do not add **says**."
    }
  ],
