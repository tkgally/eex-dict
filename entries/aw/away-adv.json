  "synonym_discrimination": null,
  "usage_note": "A distance or a length of time goes before **away**: *two miles away*, *a week away*. **Away** meaning *not here* (*she is away this week*) is the usual word for a trip; **absent** is more formal and is used mainly for school and work. Many phrasal verbs use **away**, such as **give away**, **throw away**, and **get away**.",
  "learner_errors": [
    {
      "incorrect": "The station is two kilometers far from here.",
      "correct": "The station is two kilometers away.",
      "note": "After a measured distance use **away**; **far** is used without a number: *Is it far?*"
    },
    {
      "incorrect": "He went away from home two weeks.",
      "correct": "He went away from home for two weeks.",
      "note": "To say how long someone stayed away, use **for** before the length of time."
    }
  ],
  "etymology": null,
