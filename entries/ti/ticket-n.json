  "synonym_discrimination": null,
  "usage_note": "In American English, a ticket for a trip to a place and back is a **round-trip ticket**; in British English it is a **return ticket**. A ticket for one direction only is **one-way** (American) or **single** (British). A ticket is **for** an event or a trip and **to** a place: *a ticket for the game*, *a ticket to Paris*.",
  "learner_errors": [
    {
      "incorrect": "I bought a ticket of the concert.",
      "correct": "I bought a ticket for the concert.",
      "note": "A ticket is **for** an event or **to** a place, not **of** it."
    }
  ],
