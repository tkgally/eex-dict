  "synonym_discrimination": {
    "words": [
      "effect-n",
      "result-n",
      "consequence-n"
    ],
    "note": "A **result** is what you get at the end of a process or an action (*the results of the test*). An **effect** is a change that something causes in someone or something (*the effect of coffee on sleep*). A **consequence** is a result that follows from an action, often a bad one that someone must accept (*face the consequences*)."
  },
  "usage_note": "Learners often mix up **effect** and **affect**, which sound almost the same. **Effect** is usually a noun (*have an effect on someone*); **affect** is a verb (*it affects someone*). **Effect** is also a formal verb meaning to make a change happen (*effect a change*), but this use is rare.",
  "learner_errors": [
    {
      "incorrect": "The weather has a big affect on my mood.",
      "correct": "The weather has a big effect on my mood.",
      "note": "The noun is **effect**; **affect** is a verb: *the weather affects my mood*."
    },
    {
      "incorrect": "This medicine has no effect to me.",
      "correct": "This medicine has no effect on me.",
      "note": "Say **an effect on** someone or something."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"effect\" takes **on** before the person or thing that changes: *an effect on prices*, not *an effect to prices* or *an effect for prices*.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"effect\" and \"affect\" sound almost the same in everyday speech: stress on the second part, *ih-FEKT*. Learners must tell them apart by grammar, not by sound."
  },
