  "synonym_discrimination": null,
  "usage_note": "**Its** never takes an apostrophe. **It's**, with an apostrophe, is a different word: the short form of **it is** or **it has**. Reading the sentence with **it is** in full is a quick check: *The dog wagged its tail* cannot become *the dog wagged it is tail*, so no apostrophe is needed.",
  "learner_errors": [
    {
      "incorrect": "The company lost it's biggest client.",
      "correct": "The company lost its biggest client.",
      "note": "The possessive **its** has no apostrophe; **it's** means **it is** or **it has**."
    }
