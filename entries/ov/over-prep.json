  "synonym_discrimination": {
    "words": [
      "above-prep",
      "over-prep"
    ],
    "note": "Both can mean higher than something: *a light above the door*, *a light over the door*. Use **over** when something covers another thing or moves across it (*a blanket over the bed*, *jump over the wall*), and **above** for levels on a scale (*above zero*, *above average*). With numbers and ages both mean *more than*, but **over** is more common in speech: *over a hundred people*."
  },
  "usage_note": "**Over** with no noun after it (*Come over tomorrow*, *He fell over*) is an adverb, and **over** meaning *finished* (*The game is over*) is an adjective; this entry covers only the preposition. Phrasal verbs such as **get over**, **look over**, and **take over** have their own entries.",
  "learner_errors": [
    {
      "incorrect": "The book is over the table.",
      "correct": "The book is on the table.",
      "note": "For something resting on top of a surface, use **on**; **over** is usually higher, without touching."
    },
    {
      "incorrect": "I have over than twenty cousins.",
      "correct": "I have over twenty cousins.",
      "note": "**Over** already means *more than*; do not add **than** after it."
    }
  ],
