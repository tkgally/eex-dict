  "synonym_discrimination": null,
  "usage_note": "**Over** with a noun after it (*over the bridge*) is a preposition, in the entry **over** (preposition); **over** after **be** meaning *finished* (*The game is over*) is an adjective. Many phrasal verbs use **over**, such as **get over**, **take over**, and **look over**; each has its own entry. *All over* (everywhere) is in the entry for **all** (adverb).",
  "learner_errors": [
    {
      "incorrect": "Children over 12 years and over pay.",
      "correct": "Children over 12 pay.",
      "note": "Use **over** once: *over 12* or *12 and over*, not both."
    },
    {
      "incorrect": "Can you come to over my house?",
      "correct": "Can you come over to my house?",
      "note": "**Over** goes after the verb and before **to** + the place."
    }
  ],
