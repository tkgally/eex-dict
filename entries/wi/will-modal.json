  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Will** and **going to** both talk about the future, but they are not identical: **going to** is common for a plan already made before speaking (*I'm going to visit my parents this weekend*), while **will** more often marks a decision made at the moment of speaking, a promise, or a simple prediction. In fast speech, **will** almost always contracts to **'ll** after a pronoun (*I'll*, *we'll*, *they'll*).",
  "learner_errors": [
    {
      "incorrect": "I will to call you tomorrow.",
      "correct": "I will call you tomorrow.",
      "note": "A modal such as **will** is followed by the base form of a verb without **to**."
    },
    {
      "incorrect": "When she will arrive, we will start.",
      "correct": "When she arrives, we will start.",
      "note": "**Will** is not normally used in a **when** or **if** clause about the future; use the present tense there instead (an exception is **will** showing willingness: *if you will just sign here*)."
    }
  ],
