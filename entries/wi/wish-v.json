  "synonym_discrimination": {
    "words": [
      "wish-v",
      "hope-v",
      "want-v"
    ],
    "note": "**Hope** is for something that is possible: *I hope you pass the exam*. **Wish** with a clause is for something that is not true or not likely, and the verb goes back in time: *I wish I were taller*. **Want** is the everyday word for what you would like to have or do: *I want a new phone*; **wish to** is a formal way of saying it."
  },
  "usage_note": "In formal English, **were** is used after **wish** with every subject: *I wish I were taller*. **Was** is common in everyday speech: *I wish I was taller*.",
  "learner_errors": [
    {
      "incorrect": "I wish you will pass the exam.",
      "correct": "I hope you pass the exam.",
      "note": "Use **hope** for something that may happen; **wish** with a clause is for things that are not true."
    },
    {
      "incorrect": "I wish I can swim.",
      "correct": "I wish I could swim.",
      "note": "After **wish**, use a past form such as **could**, **had**, or **were**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Some languages use one verb for **wish** and **hope**. English uses **hope** for what is possible and **wish** for what is not true or not likely.",
    "grammar": "\"wish\" is followed by a past form even when it is about now: *I wish I knew* means *I do not know*. Many languages use a present or a special verb form here.",
