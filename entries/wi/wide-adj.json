  "synonym_discrimination": {
    "words": [
      "wide-adj",
      "broad-adj"
    ],
    "note": "**Wide** is the more common word for distance from side to side: *a wide road*, *a wide door*. **Broad** is used especially of the body and of land (*broad shoulders*, *a broad valley*), and also means general rather than detailed: *a broad outline of the plan*."
  },
  "usage_note": "**Wide** is also an adverb (*open your mouth wide*, *wide awake*, *wide open*); that is a separate entry. A measurement comes before the adjective: *ten meters wide*.",
  "learner_errors": [
    {
      "incorrect": "The road has ten meters wide.",
      "correct": "The road is ten meters wide.",
      "note": "Use **be**, then the number, then **wide**."
    },
    {
      "incorrect": "The wideness of the room is four meters.",
      "correct": "The width of the room is four meters.",
      "note": "The noun is **width**."
    }
  ],
