  "usage_note": "**With** is never followed by a clause beginning with **that**. Phrasal verbs such as **deal with**, **put up with**, and **come up with** have their own entries.",
  "learner_errors": [
    {
      "incorrect": "She is married with a doctor.",
      "correct": "She is married to a doctor.",
      "note": "**Married** takes **to** before the husband or wife; **married with children** means *married and having children*."
    },
    {
      "incorrect": "He cut the paper by scissors.",
      "correct": "He cut the paper with scissors.",
      "note": "**With** names the tool; **by** is used for the person who does the action or for a method such as *by hand*."
    },
    {
      "incorrect": "I'm agree with you.",
      "correct": "I agree with you.",
      "note": "**Agree** is a verb, so it needs no **am** before it."
    }
  ],
