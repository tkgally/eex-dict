  "synonym_discrimination": {
    "words": [
      "try-v",
      "attempt-v"
    ],
    "note": "**Try** is the everyday word: *I tried to fix it*. **Attempt** is more formal and often suggests that the thing is hard or did not work: *He attempted to climb the wall but fell*."
  },
  "usage_note": "**Try to do** something means make an effort to do something that may be hard: *I tried to open the window, but it was stuck*. **Try doing** something means do it to see what happens: *Try opening the window; the room might get cooler*. In informal speech, **try and** is also used for **try to**: *Try and be quiet*.",
  "learner_errors": [
    {
      "incorrect": "I will try my best to not be late.",
      "correct": "I will try my best not to be late.",
      "note": "The usual order is **not** before **to**: *try not to*."
    },
    {
      "incorrect": "I tried to eat sushi and I liked it.",
      "correct": "I tried sushi and I liked it.",
      "note": "To test something new, use **try** with a noun or an **-ing** form; **try to** means make an effort."
    }
  ],
