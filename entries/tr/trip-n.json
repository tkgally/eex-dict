  "synonym_discrimination": null,
  "usage_note": "A **trip** is often fairly short and usually means visiting a place for a reason: *a trip to the beach*, *a business trip*. People **take** or **go on** a trip; *make a trip* is used for one journey to a place, often a short practical one: *I made three trips to the car to carry the bags*.",
  "learner_errors": [
    {
      "incorrect": "We did a trip to the lake.",
      "correct": "We took a trip to the lake.",
      "note": "Say **take** a trip or **go on** a trip, not *do* a trip."
    },
    {
      "incorrect": "I went to a trip to the city.",
      "correct": "I went on a trip to the city.",
      "note": "You go **on** a trip, and the place comes after **to**."
    }
  ],
