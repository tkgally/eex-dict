  "synonym_discrimination": {
    "words": [
      "travel-n",
      "trip-n",
      "journey-n",
      "tour-n"
    ],
    "note": "**Travel** is the general activity and is uncountable: *I love travel*, *air travel*. A **trip** is one time you go somewhere and come back: *a business trip*, *a trip to the beach*. A **journey** is the act of going from one place to another, often a long one: *a long train journey*. A **tour** is a trip that visits several places, or a visit around one place: *a tour of the old town*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "How was your travel?",
      "correct": "How was your trip?",
      "note": "**Travel** is uncountable; one time you go somewhere is a **trip** or a **journey**."
    },
    {
      "incorrect": "We had a nice travel to the mountains.",
      "correct": "We had a nice trip to the mountains.",
      "note": "Do not say *a travel*; say *a trip* or *a journey*."
