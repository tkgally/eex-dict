  "synonym_discrimination": {
    "words": [
      "trouble-n",
      "problem-n",
      "difficulty-n"
    ],
    "note": "**Problem** is the everyday countable word: *a problem*, *two problems*, *What's the problem?* **Trouble** is usually uncountable and often follows **have**: *We had some trouble with the car*, *I have trouble sleeping*. **Difficulty** is a little more formal, and often says how hard something is to do: *She walks with difficulty*."
  },
  "usage_note": null,
