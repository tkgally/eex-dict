  "synonym_discrimination": null,
  "usage_note": "You **cast** your vote (*cast your vote early*). A group **has**, **holds**, or **takes** a vote on something (*hold a vote on the plan*), and **puts** something **to a vote**. **Win** or **lose a vote** usually means the result of a whole vote.",
  "learner_errors": [
    {
      "incorrect": "We made a vote about the plan.",
      "correct": "We had a vote on the plan.",
      "note": "Use **have**, **hold**, or **take** a vote, and say **a vote on** a subject."
    },
    {
      "incorrect": "He gave his vote to the election.",
      "correct": "He voted in the election.",
      "note": "The verb **vote** is usually simpler: *vote in an election*, *vote for someone*."
    }
