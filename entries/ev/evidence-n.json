  "synonym_discrimination": {
    "words": [
      "evidence-n",
      "proof-n"
    ],
    "note": "**Evidence** is anything that helps show something is true; it can be weak or strong (*there is some evidence that coffee helps*). **Proof** is evidence that leaves no doubt (*we have proof that he was there*). You can have evidence without proof."
  },
  "usage_note": "**Evidence** takes a singular verb (*the evidence is clear*). Use **evidence of** before a noun (*evidence of damage*), **evidence for** before an idea or claim (*evidence for the theory*), and **evidence that** before a clause.",
  "learner_errors": [
    {
      "incorrect": "The police found many evidences.",
      "correct": "The police found a lot of evidence.",
      "note": "**Evidence** is uncountable and has no plural."
    },
    {
      "incorrect": "This is an important evidence.",
      "correct": "This is an important piece of evidence.",
      "note": "**Evidence** cannot follow **a** or **an**; use **a piece of evidence**."
    }
  ],
