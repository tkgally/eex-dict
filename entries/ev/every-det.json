    {
      "n": 1,
      "signpost": "each one",
      "definition": "used before a singular noun to mean all the members of a group, with no exception, especially when the group is large or general",
      "explanation": "**Every** treats a group as a series with no gaps: *every day* means each day without exception. It is common with time words (*every morning*, *every year*) and with numbers to show how often something happens (*every third day*). It is never followed directly by **of**; for that meaning use **every one of** or **each of**.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
