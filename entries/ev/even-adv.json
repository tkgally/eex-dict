    {
      "n": 1,
      "signpost": "surprising",
      "definition": "used to say that something is surprising, or more than you would expect",
      "explanation": "**Even** goes before the word or phrase that is surprising: before a subject (*Even Sam laughed*), before the main verb or after **be** (*He didn't even try*; *She was even late for her own party*), or before a phrase (*even in summer*). **Not even** adds that the smallest thing did not happen: *I didn't even get a reply*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [
          "not gradable"
        ],
        "patterns": []
      },
