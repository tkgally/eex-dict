  "synonym_discrimination": {
    "words": [
      "number-n",
      "amount-n"
    ],
    "note": "Use **number** with plural nouns for things you can count: *a large number of chairs*. Use **amount** with uncountable nouns: *a large amount of money*. In everyday speech **amount** is sometimes heard with plural nouns, but in careful writing **number** is the correct choice."
  },
  "usage_note": "Before a figure, **number** is often shortened to **No.** (plural **Nos.**), and, especially in American English, written **#**: *Room No. 6*, *apartment #6*.",
  "learner_errors": [
    {
      "incorrect": "The number of tourists are growing.",
      "correct": "The number of tourists is growing.",
      "note": "**The number of** takes a singular verb; **a number of** takes a plural one."
    },
    {
      "incorrect": "A big amount of people came.",
      "correct": "A large number of people came.",
      "note": "Use **number** for people and other things you can count, and **large** rather than **big** with it."
    }
