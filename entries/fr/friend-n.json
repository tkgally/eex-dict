  "synonym_discrimination": null,
  "usage_note": "**My friend** is common, especially before a name (*my friend Ana*). **A friend of mine** (or **of yours**, **of hers**) makes it clear that this is one of several friends: *a friend of mine told me*. **Friend** does not usually mean a romantic partner; that is a **boyfriend** or **girlfriend**.",
  "learner_errors": [
    {
      "incorrect": "I made friend with her at school.",
      "correct": "I made friends with her at school.",
      "note": "The phrase is **make friends with someone**, with plural **friends**."
    },
    {
      "incorrect": "She is a friend of me.",
      "correct": "She is a friend of mine.",
      "note": "After **a friend of**, use **mine**, **yours**, **his**, or a name with **'s**."
    }
  ],
