  "synonym_discrimination": {
    "words": [
      "freedom-n",
      "liberty-n"
    ],
    "note": "**Freedom** is the general word: *I love the freedom of living alone*. **Liberty** is more formal and is used mostly about rights in law and politics: *the liberty of the people*. In everyday speech, use **freedom**."
  },
  "usage_note": "**Freedom** is usually uncountable: *They want freedom*, not *a freedom*. The plural **freedoms** is used for particular rights: *basic freedoms*. Say **freedom of** for a right (*freedom of speech*) and **freedom from** for being without something bad (*freedom from fear*).",
  "learner_errors": [
    {
      "incorrect": "We want a freedom.",
      "correct": "We want freedom.",
      "note": "In general use **freedom** is uncountable and takes no **a**."
    },
    {
      "incorrect": "She wants freedom of pain.",
      "correct": "She wants freedom from pain.",
      "note": "Use **freedom from** for being without something bad."
    }
  ],
