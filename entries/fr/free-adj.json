  "synonym_discrimination": null,
  "usage_note": "**Free** in sense 1 does not mean *without anything*: *a free coffee* is a coffee you do not pay for, but *coffee-free* or *free of coffee* means without coffee. After a verb, as in *Children travel free*, **free** is an adverb; that use is shown at **free** (adverb).",
  "learner_errors": [
    {
      "incorrect": "They gave it to me freely.",
      "correct": "They gave it to me for free.",
      "note": "To mean *without paying*, use **for free**; **freely** means *without limits* or *willingly*."
    }
  ],
