  "synonym_discrimination": null,
  "usage_note": "**In front of** (a preposition) means close to the forward side of someone or something: *She stood in front of the house*. **At the front of** means in the forward part of something: *I sat at the front of the bus* (inside it). For something on the other side of a road or a room, English uses **opposite** or **across from**, not **in front of**.",
  "learner_errors": [
    {
      "incorrect": "I sat in the front of him at the concert.",
      "correct": "I sat in front of him at the concert.",
      "note": "Before a person or thing, the preposition is **in front of**, with no **the**."
    },
    {
      "incorrect": "The bank is in front of the station, across the street.",
      "correct": "The bank is opposite the station, across the street.",
      "note": "For something on the other side of a street, use **opposite** or **across from**."
    }
  ],
