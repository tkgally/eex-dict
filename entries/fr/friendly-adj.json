  "synonym_discrimination": null,
  "usage_note": "**Friendly** ends in **-ly** but is an adjective, not an adverb. The adverb **friendlily** exists but is rare; say *in a friendly way*: *She smiled at me in a friendly way*.",
  "learner_errors": [
    {
      "incorrect": "He talked to me very friendly.",
      "correct": "He talked to me in a very friendly way.",
      "note": "**Friendly** is an adjective; after a verb, use **in a friendly way**."
    },
    {
      "incorrect": "She is friendly for everyone.",
      "correct": "She is friendly to everyone.",
      "note": "Use **friendly to** or **friendly toward** a person."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Sense 4 is mainly used in compounds such as *user-friendly*; many languages need a phrase such as *easy to use* or *good for*.",
    "grammar": "**Friendly** looks like an adverb because it ends in **-ly**, but it is an adjective; the adverb meaning is expressed with *in a friendly way*.",
