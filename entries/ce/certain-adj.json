  "synonym_discrimination": {
    "words": [
      "certain-adj",
      "sure-adj"
    ],
    "note": "**Sure** and **certain** both mean having no doubt. **Sure** is more common in speech: *I'm sure he's right*; **certain** is a little more formal: *I am certain of it*. In fixed phrases, **sure** is more usual: *make sure*, *Sure!* as a reply. Only **certain** can mean particular: *certain people*."
  },
  "usage_note": "The subject matters with **certain to**. *He is certain to win* means that other people are sure he will win. *He is certain that he will win* means that he himself believes it.",
  "learner_errors": [
    {
      "incorrect": "I'm certain about that he will come.",
      "correct": "I'm certain that he will come.",
      "note": "Before a clause, use **that** or nothing, not **about that**."
    }
  ],
