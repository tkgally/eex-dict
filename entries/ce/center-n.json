  "synonym_discrimination": {
    "words": [
      "center-n",
      "middle-n"
    ],
    "note": "**Center** is used for the point or area in the very middle of a space or shape: *the center of the circle*, *the city center*. **Middle** is more general and can be a line, an area, or a time: *the middle of the road*, *the middle of the night*. For times, **middle** is the normal word."
  },
  "usage_note": "**Center** is the American spelling; British English writes **centre**, in this sense and in names such as *a sports centre*.",
  "learner_errors": [
    {
      "incorrect": "The hotel is in center of the city.",
      "correct": "The hotel is in the center of the city.",
      "note": "Say **the center of** a place; **center** needs **the** here."
    },
    {
      "incorrect": "We arrived in the center of the night.",
      "correct": "We arrived in the middle of the night.",
      "note": "For a time, English normally uses **middle**, not **center**."
    }
  ],
