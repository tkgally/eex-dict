  "synonym_discrimination": null,
  "usage_note": "To say how heavy someone or something is, the verb **weigh** is much more usual than the noun: *She weighs 50 kilos* sounds more natural than *Her weight is 50 kilos*. Body weight is often given in pounds in the United States, in kilos in most other places, and sometimes in **stone** in Britain.",
  "learner_errors": [
    {
      "incorrect": "I want to lose my weight.",
      "correct": "I want to lose weight.",
      "note": "**Lose weight** and **gain weight** take no possessive."
    },
    {
      "incorrect": "The box is five kilos weight.",
      "correct": "The box weighs five kilos.",
      "note": "Use the verb **weigh**, or say *five kilos in weight*."
    }
  ],
