  "adaptation": {
    "semantic": "Some languages use different verbs for clothes, glasses, jewelry, hats, and makeup. English uses **wear** for all of them, and also for a hairstyle, a perfume, and a look on your face.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"wear\" sounds the same as **where**, not like **ear**."
