  "synonym_discrimination": {
    "words": [
      "wear-v",
      "put-on-phrv",
      "dress-v"
    ],
    "note": "**Wear** describes a state, the clothes being on your body: *She's wearing a coat*. **Put on** describes the action of getting clothes onto your body: *Put on your coat; it's cold*. **Dress** means put clothes on yourself or on someone else, and does not take the clothes as its object: *I dressed quickly*, *dress the baby*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Wait, I need to wear my shoes first.",
      "correct": "Wait, I need to put on my shoes first.",
      "note": "Use **put on** for the action of getting dressed; **wear** is for having clothes on."
    },
    {
      "incorrect": "She dressed a red dress.",
      "correct": "She wore a red dress.",
      "note": "**Dress** does not take the clothes as its object; use **wear** or **was dressed in**."
    }
  ],
