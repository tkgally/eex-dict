  "synonym_discrimination": null,
  "usage_note": "In writing, **well** at the start of a sentence is usually followed by a comma: *Well, I suppose so.* Written dialogue uses it to make speech sound natural; formal writing rarely uses it.",
  "learner_errors": [
    {
      "incorrect": "Well, the first reason is that prices are rising.",
      "correct": "The first reason is that prices are rising.",
      "note": "Spoken **well** is usually out of place in an essay or a report; leave it out in formal writing."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Other languages have their own spoken pause words with the same jobs; translate by function (thinking, accepting, surprise, impatience), not with the word for **good** or **healthy**.",
    "grammar": "**Well** as a spoken filler stands outside the sentence, usually first, and is usually followed by a comma in writing. Do not confuse it with the adverb **well** (*she sings well*) or the adjective **well** (*I am well*).",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Often drawn out, *weeell*, when the speaker is thinking; short and sharp, *well!*, for surprise or impatience. The vowel is the short **e** of **bed**."
  },
