  "synonym_discrimination": null,
  "usage_note": "**Well** meaning *healthy* (*I don't feel well*) is an adjective, and **well** at the start of what you say (*Well, I'm not sure*) is an interjection; both have their own entries. Before a noun, **well** joins a past participle with a hyphen (*a well-known writer*); after a verb, there is usually no hyphen (*The writer is well known*).",
  "learner_errors": [
    {
      "incorrect": "She speaks English very good.",
      "correct": "She speaks English very well.",
      "note": "To say how someone does something, use the adverb **well**, not the adjective **good**."
    },
    {
      "incorrect": "I know very well her.",
      "correct": "I know her very well.",
      "note": "**Well** goes after the object, not between the verb and the object."
    }
  ],
