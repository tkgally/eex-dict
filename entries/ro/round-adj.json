  "synonym_discrimination": {
    "words": [
      "round-adj",
      "circular-adj"
    ],
    "note": "**Round** is the everyday word and is used both for flat shapes and for shapes like a ball: *a round table*, *a round stone*. **Circular** is a little more formal and is used mostly for flat shapes or paths: *a circular route*."
  },
  "usage_note": "**Round** is also a preposition and an adverb, mainly in British English (*round the corner*, *turn round*), where American English usually says **around**; these are separate entries. **A round trip** is a trip to a place and back again.",
  "learner_errors": [
    {
      "incorrect": "The table is circle.",
      "correct": "The table is round.",
      "note": "**Circle** is a noun; to describe the shape, use the adjective **round**."
    }
  ],
