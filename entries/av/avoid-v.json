  "synonym_discrimination": null,
  "usage_note": "**Avoid** is followed by an -ing form, never a to-infinitive: *avoid going*, not *avoid to go*. It is about what you do or what happens to you: *avoid upsetting her*, *avoid an accident*. To stop another person from doing something, use **prevent** or **stop**: *The fence stops the dog from running away*.",
  "learner_errors": [
    {
      "incorrect": "Try to avoid to eat too much sugar.",
      "correct": "Try to avoid eating too much sugar.",
      "note": "After **avoid**, use the **-ing** form of a verb, not a to-infinitive."
    },
    {
      "incorrect": "The fence avoids the dog from running away.",
      "correct": "The fence stops the dog from running away.",
      "note": "To keep someone else from doing something, use **stop** or **prevent**, not **avoid**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"avoid\" takes an -ing form: *avoid going out*. It is not followed by a to-infinitive, or by **from** before an -ing form.",
    "culture": null,
    "false_friends": "In some languages a similar verb means *stop someone else from doing something*. English **avoid** is about what you do or what happens to you; to stop other people, use **prevent** or **stop**.",
    "pronunciation": null
  },
