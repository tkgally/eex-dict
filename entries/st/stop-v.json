  "synonym_discrimination": {
    "words": [
      "stop-v",
      "quit-v",
      "cease-v"
    ],
    "note": "**Stop** is the general word: *Stop talking*. **Quit** is informal and is used for ending a habit or leaving a job: *He quit smoking*; *She quit her job*. **Cease** is formal and is used in official language: *The factory ceased production*."
  },
  "usage_note": "**Stop** followed by an **-ing** form means end an activity: *He stopped smoking* (he no longer smokes). **Stop** followed by a **to** infinitive means stop one thing in order to do another: *He stopped to smoke* (he paused so that he could smoke).",
  "learner_errors": [
    {
      "incorrect": "I stopped to smoke last year.",
      "correct": "I stopped smoking last year.",
      "note": "To end a habit, use **stop** with an **-ing** form. **Stop to do** means pause in order to do it."
    },
    {
      "incorrect": "Nothing can stop me to go.",
      "correct": "Nothing can stop me from going.",
      "note": "Use **stop someone from doing something**, not a **to** infinitive."
    },
    {
      "incorrect": "The bus stoped at the station.",
      "correct": "The bus stopped at the station.",
      "note": "Double the **p** before **-ed** and **-ing**: **stopped**, **stopping**."
    }
  ],
  "etymology": null,
