  "synonym_discrimination": {
    "words": [
      "stay-v",
      "remain-v"
    ],
    "note": "**Stay** is the everyday word: *Stay here*. **Remain** is more formal and common in writing and announcements: *Please remain seated*. Only **stay** is used for living somewhere as a visitor: *We stayed at a hotel*."
  },
  "usage_note": "To ask a visitor where they are sleeping during a trip, English says *Where are you staying?*, not *Where are you living?*. **Live** is for your home; **stay** is for a time away from home, for example as a guest or at a hotel.",
  "learner_errors": [
    {
      "incorrect": "I stayed in my friend for a week.",
      "correct": "I stayed with my friend for a week.",
      "note": "You stay **with** a person, or **at** someone's house."
    },
    {
      "incorrect": "Stay calmly and listen.",
      "correct": "Stay calm and listen.",
      "note": "When **stay** means *continue to be*, it is followed by an adjective, not an adverb."
    }
  ],
