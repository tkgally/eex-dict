  "synonym_discrimination": null,
  "usage_note": "In the sense of workers, **staff** is a group noun. British English often uses a plural verb (*the staff are friendly*); American English more often uses a singular verb (*the staff is friendly*). For one person, say **a member of staff** (mainly British) or **a staff member**, not **a staff**. The music sense is **stave** in British English.",
  "learner_errors": [
    {
      "incorrect": "She is a staff at the hotel.",
      "correct": "She is a member of staff at the hotel.",
      "note": "One person is **a member of staff** or **a staff member**; **staff** means the whole group."
    },
    {
      "incorrect": "The staffs were very friendly.",
      "correct": "The staff were very friendly.",
      "note": "For the people who work in one place, **staff** has no **-s**."
    }
  ],
  "etymology": null,
