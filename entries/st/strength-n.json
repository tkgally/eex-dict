  "synonym_discrimination": {
    "words": [
      "strength-n",
      "force-n",
      "power-n"
    ],
    "note": "**Strength** is the power in your body or mind, or how much something can hold without breaking (*the strength of a rope*). **Force** is the power of a movement, a push, or a hit (*the force of the wind*). **Power** is the ability to do something or to control people and events (*the power of the government*), and also energy that drives machines."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I didn't have the force to lift it.",
      "correct": "I didn't have the strength to lift it.",
      "note": "The power in your body is **strength**; **force** is the power of a push or a hit."
    },
    {
      "incorrect": "Her greatest strenght is patience.",
      "correct": "Her greatest strength is patience.",
      "note": "The spelling is **ng** and then **th**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"strength\": many languages have one word that covers **strength**, **force**, and **power**; choose by sense. The countable sense (*one of her strengths*) is often a different word from the physical one.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"strength\": the **ngth** ending is hard for many learners. A light *k* sound before the **th** is common, and *strenth* is also heard, but the **th** must not become **t** or **s**."
  },
