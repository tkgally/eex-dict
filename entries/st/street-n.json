  "synonym_discrimination": {
    "words": [
      "street-n",
      "road-n",
      "avenue-n"
    ],
    "note": "A **road** is any way built for cars between places, in or out of a town (*the road to the coast*). A **street** is a road in a town or city, usually with buildings along it (*a street of small shops*). An **avenue** is a street in a town, often a wide one, and the word is common in street names (*She lives on Pine Avenue*)."
  },
  "usage_note": "In a street name, **Street** begins with a capital letter (*Elm Street*); in written addresses it is often shortened to **St.** (*12 Elm St.*).",
  "learner_errors": [
    {
      "incorrect": "She lives in Elm Street.",
      "correct": "She lives on Elm Street.",
      "note": "In American English, use **on** with the name of a street; British English often uses **in** as well."
    }
