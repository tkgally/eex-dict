  "synonym_discrimination": null,
  "usage_note": "**Story** and **history** are different words in English: a **story** is a description of events, often invented; **history** is the real past, or a description or study of it. A floor or level of a building is also spelled **story** in American English (*a three-story house*; British **storey**); that is a separate word with its own entry.",
  "learner_errors": [
    {
      "incorrect": "My grandmother told me a history about a dragon.",
      "correct": "My grandmother told me a story about a dragon.",
      "note": "A **story** tells events for others to enjoy; **history** is the real past."
    },
    {
      "incorrect": "He said me a story.",
      "correct": "He told me a story.",
      "note": "You **tell** someone a story; you do not **say** it to them."
    }
  ],
