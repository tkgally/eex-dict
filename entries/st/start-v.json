  "synonym_discrimination": {
    "words": [
      "start-v",
      "begin-v",
      "commence-v"
    ],
    "note": "**Start** and **begin** are often both possible: *It started/began to rain*. **Start** is the usual word for machines (*start the car*), and is much more common than **begin** for creating something (*start a business*); **begin** is a little more formal. **Commence** is very formal and is used for official events: *The ceremony will commence at noon*."
  },
  "usage_note": "**Start** can be followed by a **to** infinitive or an **-ing** form with little difference in meaning: *start to cry* or *start crying*. After a continuous form of **start**, the **to** infinitive is usual, because two **-ing** forms together sound awkward: *It's starting to rain*. American English also uses **start over** for *start again*.",
  "learner_errors": [
    {
      "incorrect": "The car does not begin.",
      "correct": "The car won't start.",
      "note": "Use **start**, not **begin**, for engines and machines."
    },
    {
      "incorrect": "I started to working here in May.",
      "correct": "I started working here in May.",
      "note": "After **start**, use either an **-ing** form or a **to** infinitive, not both."
    }
  ],
