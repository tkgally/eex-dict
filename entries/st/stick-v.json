      "note": "The past tense and past participle are **stuck**."
    },
    {
      "incorrect": "Stick the poster at the wall.",
      "correct": "Stick the poster on the wall.",
      "note": "Things are stuck **on** or **to** a surface, not **at** it."
    }
  ],
