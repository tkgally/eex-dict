  "synonym_discrimination": {
    "words": [
      "study-v",
      "learn-v"
    ],
    "note": "**Learn** means get knowledge or a skill: *I learned to swim last summer*. **Study** means spend time trying to learn, often at school or from books: *I studied French for three years, but I didn't learn much*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I learned hard for the exam.",
      "correct": "I studied hard for the exam.",
      "note": "**Study** is the effort you make; **learn** is getting the knowledge or skill. Use **study hard**, not **learn hard**."
    },
    {
      "incorrect": "I'm studying to the test.",
      "correct": "I'm studying for the test.",
      "note": "You study **for** an exam or a test."
    },
    {
      "incorrect": "I study at the university English.",
      "correct": "I study English at the university.",
      "note": "Put the subject right after **study**, then the place."
    }
  ],
