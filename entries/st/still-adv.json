  "synonym_discrimination": {
    "words": [
      "still-adv",
      "yet-adv",
      "already-adv"
    ],
    "note": "**Still** says that something continues: *He's still asleep*. **Yet** is used in questions and negatives about something expected that has not happened: *Has he woken up yet?* **Already** says that something happened earlier than expected: *He's already awake*."
  },
  "usage_note": "**Still** meaning not moving (*Sit still*, *The water was still*) is an adjective; see the adjective **still**.",
  "learner_errors": [
