      "incorrect": "I still not finished.",
      "correct": "I still haven't finished.",
      "note": "In a negative, **still** goes before the helping verb and **not**: *I still haven't...*"
    },
    {
      "incorrect": "She lives still here.",
      "correct": "She still lives here.",
      "note": "**Still** goes before the main verb, not after it."
