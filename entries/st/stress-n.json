  "synonym_discrimination": {
    "words": [
      "stress-n",
      "pressure-n",
      "strain-n"
    ],
    "note": "**Pressure** is what people or events put on you (*pressure to finish on time*). **Stress** is the worried, tense feeling it causes (*suffer from stress*). **Strain** is the tiring effect that stress or hard work has over time, often on a relationship or on a part of the body (*the strain of looking after a sick parent*)."
  },
  "usage_note": "A person who feels stress is **stressed**; a thing that causes stress is **stressful**: *I'm stressed because my job is stressful.*",
  "learner_errors": [
    {
      "incorrect": "I have many stresses at work.",
      "correct": "I'm under a lot of stress at work.",
      "note": "In ordinary use, **stress** is uncountable: say **a lot of stress**."
    },
    {
      "incorrect": "My job is very stressed.",
      "correct": "My job is very stressful.",
      "note": "A thing that causes stress is **stressful**; a person who feels it is **stressed**."
    }
