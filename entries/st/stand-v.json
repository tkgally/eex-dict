  "synonym_discrimination": {
    "words": [
      "stand-v",
      "bear-v",
      "tolerate-v"
    ],
    "note": "**Can't stand** is the usual way to say in speech that you dislike something very much: *I can't stand loud music*. **Bear** is similar and is common with pain and bad news, often before a **to** infinitive: *I can't bear to watch*. **Tolerate** is formal and means accept something that you do not like without complaining: *The school will not tolerate bad behavior*."
  },
  "usage_note": "For the movement from sitting to standing, **stand up** is more common than **stand** alone. In British English, *I was stood at the door* is heard in informal speech, but *I was standing at the door* is the standard form.",
  "learner_errors": [
    {
      "incorrect": "I can't stand to the noise.",
      "correct": "I can't stand the noise.",
      "note": "In the sense of *accept*, **stand** takes a direct object, with no preposition."
    },
    {
      "incorrect": "I'm not standing this any more.",
      "correct": "I can't stand this any more.",
      "note": "In the sense of *accept*, use **can't stand**, not a continuous form."
    },
    {
      "incorrect": "She standed up and left.",
      "correct": "She stood up and left.",
      "note": "The past tense and past participle are **stood**."
    }
  ],
