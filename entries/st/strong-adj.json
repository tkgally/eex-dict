  "synonym_discrimination": {
    "words": [
      "strong-adj",
      "powerful-adj"
    ],
    "note": "Use **strong** for a body that can lift heavy things and for things that do not break easily: *a strong man*, *a strong bag*. **Powerful** is more usual for machines, for people who control others, and for things that have a big effect: *a powerful engine*, *a powerful leader*. Both are used for a big effect: *strong medicine*, *powerful medicine*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "There was strong rain all night.",
      "correct": "There was heavy rain all night.",
      "note": "Rain, snow, and traffic are **heavy**; wind is **strong**."
    },
    {
      "incorrect": "She is strong at English.",
      "correct": "She is good at English.",
      "note": "Use **good at** for a skill; **strong in** is used for a subject: *strong in English*."
    }
  ],
