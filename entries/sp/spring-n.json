  "usage_note": "A season takes **in** (*in spring*, *in the spring*), but no preposition after **this**, **last**, **next**, or **every**: *last spring*, not *in last spring*. The season is written with a small letter **s**.",
  "learner_errors": [
    {
      "incorrect": "We got married on spring.",
      "correct": "We got married in the spring.",
      "note": "Use **in** with a season, not **on** or **at**."
    },
    {
      "incorrect": "I will visit you in next spring.",
      "correct": "I will visit you next spring.",
      "note": "No preposition before **next spring**, **last spring**, or **this spring**."
    }
  ],
