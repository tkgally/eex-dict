  "synonym_discrimination": null,
  "usage_note": "Speak is a little more formal than talk. You speak to someone (or, especially in American English, with someone) when you have something to say to them; you talk with someone when the two of you have a conversation. On the phone, May I speak to Ana? is the polite request, and This is Ana speaking is the polite answer.",
  "learner_errors": [
    {
      "incorrect": "I speak well English.",
      "correct": "I speak English well.",
      "note": "An adverb does not come between speak and its object."
    },
    {
      "incorrect": "She spoke me about the plan.",
      "correct": "She spoke to me about the plan.",
      "note": "The person spoken to takes to or with after speak."
    },
    {
      "incorrect": "It was a small victory, so to say.",
      "correct": "It was a small victory, so to speak.",
      "note": "The fixed phrase is so to speak."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Speak and talk are usually one verb in other languages. English prefers speak for the ability to use words or a language, for addressing a group, and for a serious or formal contact (speak to the manager), and talk for a conversation between people (we talked all night).",
    "grammar": "The person spoken to takes to or with: speak to me, not speak me. A language is a direct object: speak English. Adverbs follow the object: speak English well. Speak never reports words with a that-clause; use say or tell.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The past tense spoke and the past participle spoken have the vowel of go. The ea of speak has the vowel of see, as in speech, not the vowel of bread."
  },
