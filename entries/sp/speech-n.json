  "synonym_discrimination": {
    "words": [
      "speech-n",
      "talk-n",
      "lecture-n"
    ],
    "note": "A **speech** is formal and often given at a special event: *a wedding speech*. A **talk** is less formal and usually gives information about one subject: *a talk on local history*. A **lecture** is a long talk that teaches a subject, especially at a college or university: *a lecture on economics*."
  },
  "usage_note": "In grammar, **direct speech** gives the exact words that someone said, and **reported speech** gives them in your own words. **Freedom of speech** is the right to say what you think in public. A **part of speech** is one of the classes of words in grammar, such as noun or verb; for *a figure of speech*, see **figure**.",
  "learner_errors": [
    {
      "incorrect": "She did a speech at the party.",
      "correct": "She gave a speech at the party.",
      "note": "Use **give** or **make** with **speech**, not **do** or **say**."
    }
  ],
