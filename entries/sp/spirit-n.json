  "synonym_discrimination": {
    "words": [
      "spirit-n",
      "soul-n",
      "ghost-n"
    ],
    "note": "**Soul** and **spirit** both name the part of a person that is not the body. **Soul** is used more in religion and for the deepest feelings: *pray for his soul*. **Spirit** is used more for a person's courage and mood: *her spirit was not broken*. A **ghost** is the spirit of a dead person that some people believe they can see: *the house has a ghost*."
  },
  "usage_note": "In the sense of mood, **spirits** is plural and takes no **a**: *in high spirits*, *her spirits rose*. For strong alcohol, **spirits** is used in both American and British English; in everyday American speech **liquor** or **hard liquor** is also common. Whisky, vodka, and gin are spirits; beer and wine are not.",
  "learner_errors": [
    {
      "incorrect": "She is in a good spirit today.",
      "correct": "She is in good spirits today.",
      "note": "For a mood, use the plural **spirits** with no **a**."
    }
  ],
