  "synonym_discrimination": {
    "words": [
      "error-n",
      "mistake-n"
    ],
    "note": "**Mistake** is the everyday word: *I made a mistake*. **Error** is more formal and common in official, technical, and written language: *a calculation error*, *human error*. The messages a computer program shows report an **error**."
  },
  "usage_note": "You **make** an error, not **do** an error. **Error** is countable for one mistake (*an error*, *two errors*) and uncountable in *human error*. For something done without meaning to, say **by mistake** in everyday speech and **in error** in formal writing; **by error** is not used.",
  "learner_errors": [
    {
      "incorrect": "I did an error in the test.",
      "correct": "I made an error in the test.",
      "note": "The verb is **make**: **make an error**, **make a mistake**."
    },
    {
      "incorrect": "He deleted the file by error.",
      "correct": "He deleted the file by mistake.",
      "note": "Say **by mistake** or, formally, **in error**; **by error** is not used."
    }
  ],
