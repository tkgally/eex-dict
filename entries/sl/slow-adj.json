  "synonym_discrimination": {
    "words": [
      "slow-adj",
      "slowly-adv"
    ],
    "note": "**Slow** is the adjective: *a slow car*, *The car is slow.* **Slowly** is the usual adverb: *Drive slowly.* In informal speech, **slow** is also used as an adverb after some verbs (*Go slow*, *Drive slow*), but **slowly** is safer in writing."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Please speak more slow.",
      "correct": "Please speak more slowly.",
      "note": "In careful speech and writing, use the adverb **slowly** after a verb."
    },
    {
      "incorrect": "The internet is very slowly today.",
      "correct": "The internet is very slow today.",
      "note": "After **be**, use the adjective **slow**."
    }
  ],
