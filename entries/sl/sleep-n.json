  "synonym_discrimination": null,
  "usage_note": "**Sleep** is uncountable for rest in general (*I need sleep*), but **a sleep** is one period of it (*a short sleep*). For the moment you start sleeping, English says **go to sleep** or **fall asleep**; the verb **sleep** describes the whole time you are asleep.",
  "learner_errors": [
    {
      "incorrect": "I slept at eleven last night.",
      "correct": "I went to sleep at eleven last night.",
      "note": "To say when you started sleeping, use **go to sleep** or **fall asleep**."
    },
    {
      "incorrect": "I had a good sleeping last night.",
      "correct": "I had a good sleep last night.",
      "note": "The noun is **sleep**: *a good sleep*, *a good night's sleep*."
    }
  ],
