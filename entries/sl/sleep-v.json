  "synonym_discrimination": null,
  "usage_note": "For the moment you start sleeping, use **go to sleep** or **fall asleep**: *I fell asleep at eleven*. For going to your bed, use **go to bed**. To describe the state with **be**, use **asleep**: *the children are asleep*.",
  "learner_errors": [
    {
      "incorrect": "I slept at midnight last night.",
      "correct": "I went to bed at midnight last night.",
      "note": "To say when you went to bed or started sleeping, use **go to bed**, **go to sleep**, or **fall asleep**; *I slept at midnight* sounds as if you were already asleep then."
    },
    {
      "incorrect": "I sleeped late on Sunday.",
      "correct": "I slept late on Sunday.",
      "note": "The past tense and past participle are **slept**."
    },
    {
      "incorrect": "The baby is sleep.",
      "correct": "The baby is asleep.",
      "note": "After **be**, use the adjective **asleep**, or say *the baby is sleeping*."
    }
  ],
