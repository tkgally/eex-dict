  "synonym_discrimination": null,
  "usage_note": "**First** is written **1st** in short form (*the 1st of May*). It usually comes after **the** or a word such as **my** or **her** (*the first day*, *her first job*), but not in some fixed phrases such as *first prize* and *first place*. **First** after a verb (*She came first*, *First, mix the flour*) is an adverb, which has its own entry.",
  "learner_errors": [
    {
      "incorrect": "I read the two first chapters.",
      "correct": "I read the first two chapters.",
      "note": "Put **first** before the number: *the first two*, *the first three*."
    },
    {
      "incorrect": "It's the first time I come here.",
      "correct": "It's the first time I've been here.",
      "note": "After *it's the first time*, use **have** + past participle, not the simple present."
    }
