  "synonym_discrimination": {
    "words": [
      "fire-n",
      "flame-n",
      "blaze-n"
    ],
    "note": "**Fire** is the general word for burning: *a fire in the kitchen*. A **flame** is one bright moving tongue of burning gas that you can see: *the flame of a candle*. A **blaze** is a large fire that burns strongly, a word often used in news reports: *Firefighters fought the blaze for hours*."
  },
  "usage_note": "**Fire** is uncountable when you talk about burning in general (*Fire is dangerous*) and countable for one event or one fire made on purpose (*There was a fire in the factory*; *Let's light a fire*). People shout *Fire!* to warn others that a building is burning.",
  "learner_errors": [
    {
      "incorrect": "The house is in fire.",
      "correct": "The house is on fire.",
      "note": "Something that is burning is **on fire**, not **in fire**."
    },
    {
      "incorrect": "Someone put fire to the car.",
      "correct": "Someone set fire to the car.",
      "note": "Use **set fire to something** or **set something on fire**."
    },
    {
      "incorrect": "Turn down the fire under the soup.",
      "correct": "Turn down the heat under the soup.",
      "note": "For a stove, English usually says **heat** or **burner**, not **fire**."
    }
  ],
