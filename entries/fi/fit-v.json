  "synonym_discrimination": {
    "words": [
      "fit-v",
      "suit-v",
      "match-v"
    ],
    "note": "**Fit** is about size and shape: *The jacket fits you*. **Suit** is about whether something looks good on someone or is right for them: *Blue suits you*. **Match** is about two things that look good together or are the same: *Your shoes match your bag*."
  },
