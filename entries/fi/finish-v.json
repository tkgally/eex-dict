  "synonym_discrimination": {
    "words": [
      "finish-v",
      "end-v",
      "complete-v"
    ],
    "note": "**Finish** is the everyday word for stopping because something is done: *I've finished my work*. **End** is usual for events, stories, and periods that stop (*the war ended*) and for stopping something on purpose (*end a friendship*). **Complete** is more formal and stresses that every part is done: *complete the form*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I finished to read the book.",
      "correct": "I finished reading the book.",
      "note": "**Finish** is followed by the -ing form of a verb, never by **to** and a verb."
    }
  ],
