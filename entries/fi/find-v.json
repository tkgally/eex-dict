  "synonym_discrimination": {
    "words": [
      "find-v",
      "find-out-phrv",
      "discover-v"
    ],
    "note": "**Find** is used for things and people you look for: *I found my phone*. **Find out** is used for facts and information you learn: *I found out where she lives*. **Discover** is a little more formal and is used especially for facts or places that nobody knew about before, or for something you learn by surprise: *They discovered a new island*; *She discovered that he had lied*. It is not usual for things you lost."
  },
  "usage_note": "**Find** is the result of looking; **look for** is the action. *I looked for my keys for an hour and finally found them*. Do not use **find** in the continuous for searching: say *I'm looking for my glasses*, not *I'm finding my glasses*.",
  "learner_errors": [
    {
      "incorrect": "I find difficult to sleep.",
      "correct": "I find it difficult to sleep.",
      "note": "When the adjective is followed by a to-infinitive, **it** is needed after **find**."
    },
    {
      "incorrect": "I found out my keys under the bed.",
      "correct": "I found my keys under the bed.",
      "note": "Use **find** for objects; **find out** is for information."
    },
    {
      "incorrect": "I'm finding my glasses. Have you seen them?",
      "correct": "I'm looking for my glasses. Have you seen them?",
      "note": "**Look for** is the search; **find** is its successful end."
    }
  ],
  "etymology": null,
