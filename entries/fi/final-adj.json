  "synonym_discrimination": {
    "words": [
      "final-adj",
      "last-adj"
    ],
    "note": "**Final** and **last** both mean *at the end*: *the final day*, *the last day*. **Final** stresses that nothing more will follow, so it is common for results and decisions: *the final result*. Only **last** means *the most recent*: *last week*."
  },
  "usage_note": "**Final** in sense 1 comes only before a noun. To say *at the end* without a noun, use **finally** or **in the end**: *Finally, we won*.",
  "learner_errors": [
    {
      "incorrect": "At the final, we won the game.",
      "correct": "In the end, we won the game.",
      "note": "**Final** is an adjective here; use **in the end** or **finally**."
    },
    {
      "incorrect": "I saw her final week.",
      "correct": "I saw her last week.",
      "note": "Use **last** for the most recent week, month, or year."
    }
  ],
