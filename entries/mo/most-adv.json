  "synonym_discrimination": null,
  "usage_note": "**Most** is never used together with an **-est** form: say **biggest** or **most beautiful**, not both. Without **the**, *a most interesting idea* means *a very interesting idea*, not the most interesting of all.",
  "learner_errors": [
    {
      "incorrect": "She is the most tallest girl in the class.",
      "correct": "She is the tallest girl in the class.",
      "note": "**Tallest** is already the superlative; do not add **most**."
    },
    {
      "incorrect": "This is most important thing.",
      "correct": "This is the most important thing.",
      "note": "Before a noun, the superlative with **most** needs **the**."
    }
