  "synonym_discrimination": {
    "words": [
      "money-n",
      "cash-n",
      "currency-n",
      "fund-n"
    ],
    "note": "Money is the general word. Cash is coins and paper notes, as opposed to cards or bank transfers: pay in cash. Currency is the money system of a particular country: foreign currency. Funds, in the plural, is a formal word for money available for a purpose: the school lacks funds."
  },
  "usage_note": "Money is uncountable: some money, a lot of money, how much money, and a singular verb. To count, name the unit or the sum: two dollars, three coins, a sum of money. The plural monies (or moneys) appears only in legal and financial documents, meaning separate sums.",
  "learner_errors": [
    {
      "incorrect": "I have many moneys.",
      "correct": "I have a lot of money.",
      "note": "Money is uncountable and has no ordinary plural."
    },
    {
      "incorrect": "How many money do you need?",
      "correct": "How much money do you need?",
      "note": "Uncountable nouns take much, not many."
    },
    {
      "incorrect": "The money are on the table.",
      "correct": "The money is on the table.",
      "note": "Money takes a singular verb."
    }
  ],
  "etymology": null,
