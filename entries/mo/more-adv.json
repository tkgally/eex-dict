  "synonym_discrimination": null,
  "usage_note": "**More** is never used together with an **-er** form: say **better** or **more careful**, not both. Before a comparative, **much**, **a lot**, and **far** make it stronger: *much more expensive*, *far better*.",
  "learner_errors": [
    {
      "incorrect": "This one is more better.",
      "correct": "This one is better.",
      "note": "**Better** is already the comparative; do not add **more**."
    },
    {
      "incorrect": "My bag is more big than yours.",
      "correct": "My bag is bigger than yours.",
      "note": "Most one-syllable adjectives add **-er** instead of using **more**."
    },
    {
      "incorrect": "I don't live there no more.",
      "correct": "I don't live there any more.",
      "note": "Standard English uses one negative here: **not ... any more**, or **no longer**."
    }
  ],
