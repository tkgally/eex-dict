  "synonym_discrimination": {
    "words": [
      "answer-n",
      "reply-n",
      "response-n"
    ],
    "note": "**Answer** is the general word, and the only one used for tests and problems: *the right answer*. **Reply** is especially common for letters, emails, and messages: *a reply to my email*. **Response** is more formal and can be an action as well as words: *the city's response to the flood*."
  },
  "usage_note": "You **give**, **get**, or **have** an answer, and you **find** an answer to a problem. The preposition after **answer** is **to**: *the answer to the question*.",
  "learner_errors": [
    {
      "incorrect": "Can you give me an answer of this question?",
      "correct": "Can you give me an answer to this question?",
      "note": "Use **to** after **answer**, not **of** or **for**."
    }
  ],
