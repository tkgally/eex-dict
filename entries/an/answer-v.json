  "synonym_discrimination": null,
  "usage_note": "**Answer** takes a direct object for the thing replied to (**answer the question**, **answer the letter**), never a preposition: not **answer to the question**. **Answer to someone** is a different pattern, meaning to be responsible to them.",
  "learner_errors": [
    {
      "incorrect": "answer to the question",
      "correct": "answer the question",
      "note": "**Answer** takes a direct object here; add **to** only before a person you are responsible to."
    }
