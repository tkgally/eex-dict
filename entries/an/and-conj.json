  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "In a list of three or more, a comma before and (red, white, and blue) is usual in American writing and often left out in British writing. Both are correct; choose one and keep to it.",
  "learner_errors": [
    {
      "incorrect": "She likes reading and to swim.",
      "correct": "She likes reading and swimming.",
      "note": "The parts joined by and should have the same form."
    },
    {
      "incorrect": "Kim and Sam is coming.",
      "correct": "Kim and Sam are coming.",
      "note": "Two subjects joined by and take a plural verb."
    },
    {
      "incorrect": "I tried and called her.",
      "correct": "I tried to call her.",
      "note": "Try and is used only in the base form; in the past, use tried to."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "The then and so uses of and are often better translated with a separate word for then or so, and the try and and nice and uses have no equivalent: translate try and see as try to see.",
    "grammar": "English uses one and, before the last item, whether it joins nouns, adjectives, verbs, or clauses; some languages use different words for each or repeat the word. Two subjects joined by and take a plural verb: Kim and Sam are here.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Weak forms ənd, ən, and n; the d is usually dropped before a consonant, so bread and butter sounds like bread n butter. Stressing and every time sounds unnatural. The strong form ænd is for emphasis or when the word stands alone."
  },
