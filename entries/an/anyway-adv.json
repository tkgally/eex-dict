  "usage_note": "Any way as two words means in any manner: Do it any way you like. In writing, anyway is fine for the first two senses, but the conversation sense (Anyway, I should go) belongs to speech and informal messages.",
  "learner_errors": [
    {
      "incorrect": "Anyways, we left early.",
      "correct": "Anyway, we left early.",
      "note": "Anyways is very informal American speech; in writing use anyway."
    },
    {
      "incorrect": "It doesn't matter in anyway.",
      "correct": "It doesn't matter in any way.",
      "note": "Anyway is one word only as the adverb; after in, the two words any way mean any manner."
    }
