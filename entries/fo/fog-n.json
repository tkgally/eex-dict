  "synonym_discrimination": {
    "words": [
      "fog-n",
      "mist-n",
      "haze-n"
    ],
    "note": "**Fog** is thick and wet, and it can make it hard to see more than a short way: *We drove slowly in the fog*. **Mist** is thinner, often near water or hills, and you can usually see through it: *a light mist over the lake*. **Haze** is dry air that is not clear because of heat, dust, or smoke: *a summer haze over the city*."
  },
  "usage_note": "**Fog** is usually uncountable (*There's a lot of fog today*), but you can say *a thick fog* when you describe it, and *fogs* for several times it happens. To describe the weather, English usually uses the adjective: *It's foggy this morning*.",
  "learner_errors": [
    {
      "incorrect": "There are many fogs this morning.",
      "correct": "There is a lot of fog this morning.",
      "note": "**Fog** is uncountable when you talk about the weather on one day."
    },
    {
      "incorrect": "It's fog today.",
      "correct": "It's foggy today.",
      "note": "Use the adjective **foggy** after **it's** to describe the weather."
    }
  ],
