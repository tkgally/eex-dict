  "synonym_discrimination": {
    "words": [
      "force-v",
      "make-v",
      "compel-v"
    ],
    "note": "**Make** is the everyday word and is followed by a verb without **to**: *they made him wait*. **Force** is stronger and suggests pressure, threats, or physical strength; it takes **to**: *they forced him to wait*. **Compel** is formal and often passive: *she felt compelled to speak*."
  },
