  "synonym_discrimination": null,
  "usage_note": "**Following** comes after **the** and before a noun: *the following day*. **The following** can also stand alone, as a noun, before a list: *The following are needed: ...*. That use is shown at **following** (noun). Before a list in a sentence, **as follows** is the usual phrase: *The steps are as follows.*",
  "learner_errors": [
    {
      "incorrect": "The rules are as following:",
      "correct": "The rules are as follows:",
      "note": "The fixed phrase is **as follows**, never **as following**."
    },
    {
      "incorrect": "Following day, we went home.",
      "correct": "The following day, we went home.",
      "note": "Use **the** before **following** in sense 1."
    }
  ],
