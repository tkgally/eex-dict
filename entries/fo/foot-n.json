  "usage_note": "The plural of **foot** is **feet**: *my feet*, *ten feet*. When a measurement comes before a noun, it takes the singular: *a six-foot fence*, not *a six-feet fence*. **On foot** is the usual way to say walking; *by foot* is also heard but less common.",
  "learner_errors": [
    {
      "incorrect": "My foots are cold.",
      "correct": "My feet are cold.",
      "note": "The plural of **foot** is **feet**."
    },
    {
      "incorrect": "We built a ten-feet wall.",
      "correct": "We built a ten-foot wall.",
      "note": "A measurement before a noun uses the singular **foot**."
    },
    {
      "incorrect": "We went there by walk.",
      "correct": "We went there on foot.",
      "note": "Say **on foot** or **walked there**."
    }
  ],
