  "synonym_discrimination": {
    "words": [
      "former-adj",
      "previous-adj",
      "ex-prefix"
    ],
    "note": "Use **former** for someone who had a job or role in the past (*a former teacher*). **Previous** means the one just before this one (*my previous job*). **Ex-** is joined to a noun, mainly for partners and holders of a position, and is informal: *my ex-wife*. A person can have many former jobs but only one previous job."
  },
  "usage_note": "**Former** always comes before a noun: *a former soldier*, never *the soldier is former*. **The former** standing alone means the first of two things just named; that use is shown at **former** (noun).",
  "learner_errors": [
    {
      "incorrect": "I saw him the former week.",
      "correct": "I saw him the previous week.",
      "note": "For the one just before, use **previous** or **last**; **former** is for past roles and earlier times."
    }
  ],
