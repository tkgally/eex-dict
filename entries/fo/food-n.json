  "synonym_discrimination": {
    "words": [
      "food-n",
      "meal-n",
      "dish-n"
    ],
    "note": "**Food** is anything you eat: *We need more food*. A **meal** is one time when you sit down and eat, such as breakfast or dinner: *We had a big meal*. A **dish** is one kind of food prepared in a particular way, or part of a meal: *a rice dish*, *Her best dish is soup*."
  },
  "usage_note": "**Food** is uncountable when you mean food in general: *some food*, *a lot of food*, never *a food*. The plural **foods** is used for kinds of food, often after an adjective: *spicy foods*, *healthy foods*.",
  "learner_errors": [
    {
      "incorrect": "We bought many foods for the party.",
      "correct": "We bought a lot of food for the party.",
      "note": "For food in general, use **food** with **a lot of** or **some**, not the plural."
    },
    {
      "incorrect": "Can I have a food?",
      "correct": "Can I have something to eat?",
      "note": "**Food** in general takes no **a**; ask for **something to eat** or **some food**."
    }
  ],
