  "usage_note": "Do not put **to** before **home** after verbs of movement: *go home*, *come back home*. When **home** has a word such as **my** or **their** before it, it is a noun and takes **to**: *We went to their home*. With **at**, it is also a noun: *at home*.",
  "learner_errors": [
    {
      "incorrect": "I arrived to home at six.",
      "correct": "I arrived home at six.",
      "note": "No preposition comes before **home** after **arrive**."
    },
    {
      "incorrect": "She went back to home.",
      "correct": "She went back home.",
      "note": "No **to** before **home** after **go back** and **come back**."
    }
  ],
