  "synonym_discrimination": {
    "words": [
      "home-n",
      "house-n"
    ],
    "note": "A **house** is a building: *a house with four bedrooms*. A **home** is the place where someone lives and feels they belong, which can be a house, an apartment, or a room: *They made a home in a small apartment*. In advertising and building, **home** is often used just to mean a house or an apartment: *new homes for sale*."
  },
  "usage_note": "**At home** means in your own house; American English also says *stay home* without **at**. In *go home* and *come home*, **home** is an adverb (see **home** as an adverb).",
  "learner_errors": [
    {
      "incorrect": "I went to home early.",
      "correct": "I went home early.",
      "note": "After **go**, **come**, and **get**, **home** has no **to**."
    },
    {
      "incorrect": "She is in home today.",
      "correct": "She is at home today.",
      "note": "The phrase is **at home**, not **in home**."
    }
  ],
