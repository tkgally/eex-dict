  "synonym_discrimination": null,
  "usage_note": "**How** asks about the way or the condition; **what ... like** asks about character or appearance. *How is your sister?* asks about her health; *What is your sister like?* asks what kind of person she is.",
  "learner_errors": [
    {
      "incorrect": "How do you call this in English?",
      "correct": "What do you call this in English?",
      "note": "With **call** the answer is a name, so use **what**."
    },
    {
      "incorrect": "I don't know how does it work.",
      "correct": "I don't know how it works.",
      "note": "After *I don't know*, *I wonder*, and so on, the subject comes before the verb and there is no **do**."
    },
    {
      "incorrect": "How is the weather like?",
      "correct": "What is the weather like?",
      "note": "Use **what ... like** or **how is**, not both together."
    }
  ],
