  "synonym_discrimination": {
    "words": [
      "hope-v",
      "wish-v",
      "expect-v"
    ],
    "note": "**Hope** is for something you want and that could happen: *I hope you pass the test.* **Wish** is for something that is not true or not likely: *I wish I could fly.* **Expect** means you think something will happen, whether you want it or not: *I expect it will rain.*"
  },
  "usage_note": "After **hope**, a present tense often refers to the future: *I hope you have a good trip* means the same as *I hope you will have a good trip*. To hope that something does not happen, make the second verb negative: *I hope it doesn't rain.*",
  "learner_errors": [
    {
      "incorrect": "I wish you pass the exam.",
      "correct": "I hope you pass the exam.",
      "note": "For something that could really happen, use **hope**; **wish** plus a clause is for things that are not true."
    },
    {
      "incorrect": "I don't hope it rains tomorrow.",
      "correct": "I hope it doesn't rain tomorrow.",
      "note": "Make the second verb negative, not **hope**."
    },
    {
      "incorrect": "I hope to you have a nice day.",
      "correct": "I hope you have a nice day.",
      "note": "A to-infinitive after **hope** cannot have its own subject; use a that-clause."
    }
  ],
