  "usage_note": "**Appreciate** is a polite way of thanking someone or of asking for something, and it is common in emails and requests: *I'd appreciate a reply by Friday*; *Any help would be appreciated*.",
  "learner_errors": [
    {
      "incorrect": "I would appreciate if you could send me the form.",
      "correct": "I would appreciate it if you could send me the form.",
      "note": "**It** is needed before the **if** clause: *I'd appreciate it if*."
    },
    {
      "incorrect": "I appreciate for your help.",
      "correct": "I appreciate your help.",
      "note": "**Appreciate** takes a direct object, with no **for**; compare *thank you for your help*."
    }
