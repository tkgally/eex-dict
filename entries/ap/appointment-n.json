  "usage_note": "You **make** or **book** an appointment, **keep** it, or **cancel** it. **Appointment** is used mainly for a planned visit to a professional or an office; for a casual plan with friends, English says *meet* or *have plans*.",
  "learner_errors": [
    {
      "incorrect": "I have a date with the dentist.",
      "correct": "I have an appointment with the dentist.",
      "note": "A **date** is a romantic meeting or a day of the month; a planned visit to a professional is an **appointment**."
    },
    {
      "incorrect": "I have an appointment with my friends tonight.",
      "correct": "I'm meeting my friends tonight.",
      "note": "**Appointment** is mainly for a formal or professional meeting; it sounds odd for a casual evening with friends."
    }
  ],
