  "synonym_discrimination": null,
  "usage_note": "In the sense *think good*, **approve** needs **of**: *They approve of the plan*. Without **of**, **approve** means *accept officially*: *They approved the plan* means that the plan may now go ahead.",
  "learner_errors": [
    {
      "incorrect": "My father doesn't approve my job.",
      "correct": "My father doesn't approve of my job.",
      "note": "When it means *think good*, **approve** is followed by **of**."
    },
    {
      "incorrect": "The manager approved me to leave early.",
      "correct": "The manager allowed me to leave early.",
      "note": "**Approve** takes the plan or request as its object, not the person; use **allow** or **let** for the person."
    }
  ],
