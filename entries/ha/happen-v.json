  "synonym_discrimination": {
    "words": [
      "happen-v",
      "occur-v"
    ],
    "note": "**Happen** is the usual word in speech and most writing: *What happened?* **Occur** means the same but is more formal, and is common in written reports: *The error occurred at noon.* For a planned event, use *take place*: *The meeting will take place on Friday.*"
  },
