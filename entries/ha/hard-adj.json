  "synonym_discrimination": {
    "words": [
      "hard-adj",
      "difficult-adj"
    ],
    "note": "**Hard** and **difficult** both mean not easy (*a hard question*, *a difficult question*). **Hard** is more common in speech and also means firm (*a hard chair*); **difficult** is a little more formal and is also used of people who are not easy to deal with (*a difficult customer*)."
  },
  "usage_note": "The adverb **hard** has the same form (*work hard*). **Hardly** is a different word that means *almost not*.",
  "learner_errors": [
