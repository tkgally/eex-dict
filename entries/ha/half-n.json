  "synonym_discrimination": null,
  "usage_note": "**Half** is a noun when it has **a**, **the**, or a plural: *a half*, *the second half*, *two halves*. Directly before a noun phrase (*half an hour*, *half the cake*) it is a determiner, and in *half of them* or *I'll have half* it is a pronoun; as an adverb it means *partly* (*half asleep*). Those uses have their own entries.",
  "learner_errors": [
    {
      "incorrect": "Cut it into two halfs.",
      "correct": "Cut it into two halves.",
      "note": "The plural is **halves**."
    },
    {
      "incorrect": "We waited one hour and half.",
      "correct": "We waited an hour and a half.",
      "note": "Use **a** before **half** at the end: *an hour and a half*, or say *one and a half hours*."
    }
  ],
