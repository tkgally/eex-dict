  "synonym_discrimination": {
    "words": [
      "hate-n",
      "hatred-n"
    ],
    "note": "**Hatred** is the usual noun for a strong, lasting feeling against a person or group: *a deep hatred of war*. **Hate** is common before other nouns (*hate mail*, *a hate crime*) and in pairs with **love**: *love and hate*. In ordinary speech the verb is far more common than either noun: *I hate waiting*."
  },
  "usage_note": "The noun **hate** is much less common than the verb. For your own everyday dislikes, the verb is the natural choice: *I hate cold weather*.",
  "learner_errors": [
    {
      "incorrect": "I have a big hate for spiders.",
      "correct": "I really hate spiders.",
      "note": "People use the verb **hate** for their own dislikes; the noun sounds unnatural here."
    },
    {
      "incorrect": "There was a lot of hates between them.",
      "correct": "There was a lot of hatred between them.",
      "note": "The feeling is uncountable: no plural. **Hatred** is the more usual word."
    }
