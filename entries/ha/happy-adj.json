  "synonym_discrimination": {
    "words": [
      "happy-adj",
      "glad-adj",
      "pleased-adj"
    ],
    "note": "**Happy** is the general word, for the feeling and for people, times, and things: *a happy child*, *a happy day*. **Glad** is used almost always after a verb (a few fixed phrases such as *glad tidings* are attributive), and **pleased** usually is too; both are usually about one particular thing: *I'm glad you came*; *she was pleased with the result*. **Glad** is a little warmer and **pleased** a little cooler and more formal, and neither ordinarily describes a time or an event."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm very happy of my new job.",
      "correct": "I'm very happy with my new job.",
      "note": "**Of** is not used after **happy**."
    },
    {
      "incorrect": "I'm happy for see you again.",
      "correct": "I'm happy to see you again.",
      "note": "**Happy** is followed by **to** plus the base form of a verb, not **for** plus a verb."
    },
    {
      "incorrect": "I'm happy for the good news.",
      "correct": "I'm happy about the good news.",
      "note": "**Happy for** goes with a person: *happy for you*; before a thing use **about** or **with**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Some languages have separate words for a passing feeling and a lasting state; English **happy** covers both. The satisfied sense (*happy with*) and the willing sense (*happy to help*) may need words meaning content or willing.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "The stress is on the first syllable, and the final **y** is a short **ee** sound. The double **p** is one short sound, not a long one."
  },
