  "synonym_discrimination": {
    "words": [
      "happy-adj",
      "glad-adj",
      "pleased-adj"
    ],
    "note": "Happy is the general word, for the feeling and for people, times, and things: a happy child, a happy day. Glad is used only after a verb, and pleased usually is; both are usually about one particular thing: I'm glad you came; She was pleased with the result. Glad is a little warmer and pleased a little cooler and more formal, and neither can describe a time or an event."
  },
  "usage_note": "In replies and offers, happy to often means willing rather than pleased: I'd be happy to help is a polite offer, and I'm happy to wait means that waiting is fine with you. Happy to help is also a friendly closing line in messages.",
  "learner_errors": [
    {
      "incorrect": "I'm very happy of my new job.",
      "correct": "I'm very happy with my new job.",
      "note": "Happy takes with or about before a thing; of is not used."
    },
    {
      "incorrect": "I'm happy for see you again.",
      "correct": "I'm happy to see you again.",
      "note": "Happy is followed by to plus the base form of a verb, not for plus a verb."
    },
    {
      "incorrect": "I'm happy for the good news.",
      "correct": "I'm happy about the good news.",
      "note": "Happy for goes with a person: happy for you; before a thing use about or with."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Some languages have separate words for a passing feeling and a lasting state; English happy covers both. The greeting sense (Happy Birthday) is a fixed formula, and the satisfied sense (happy with) may need a word meaning content or agreeable.",
    "grammar": "Happy takes about or with before a thing, for before a person, to before a verb, and that before a clause: happy about the result, happy for you, happy to help, happy that you came.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The stress is on the first syllable, and the final y is a short ee sound. The double p is one short sound, not a long one."
  },
