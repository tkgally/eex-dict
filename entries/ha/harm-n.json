  "synonym_discrimination": {
    "words": [
      "harm-n",
      "damage-n",
      "injury-n"
    ],
    "note": "**Harm** is the most general word and can be physical or not: *the harm that lies can do*. **Damage** is used mostly for things that are broken or spoiled: *damage to the car*. **Injury** is harm to the body of a person or an animal: *a knee injury*. Harm is never plural; *an injury* and *injuries* are."
  },
  "usage_note": "The usual verbs with **harm** are **do** and **cause**: *do harm*, *do someone harm*, *cause harm to someone*. **Harm** has no plural and is not used with **a**.",
  "learner_errors": [
    {
      "incorrect": "It made a lot of harm to the garden.",
      "correct": "It did a lot of harm to the garden.",
      "note": "The verb with **harm** is **do** or **cause**, not **make**."
    },
    {
      "incorrect": "This won't cause you a harm.",
      "correct": "This won't cause you any harm.",
      "note": "**Harm** is uncountable, so it takes **any** or **no**, not **a**."
    }
