  "synonym_discrimination": {
    "words": [
      "habit-n",
      "custom-n",
      "tradition-n"
    ],
    "note": "A **habit** is something one person does often, often without thinking: *a habit of biting her nails*. A **custom** is something that people in a society usually do: *the custom of giving gifts at weddings*. A **tradition** is a custom or belief that has been passed down for a long time: *a family tradition*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I have a habit to get up early.",
      "correct": "I have a habit of getting up early.",
      "note": "**Habit** takes **of** and an -ing form."
    },
    {
      "incorrect": "In my country it is a habit to take off your shoes indoors.",
      "correct": "In my country it is a custom to take off your shoes indoors.",
      "note": "A **custom** belongs to a society; a **habit** belongs to a person."
    }
