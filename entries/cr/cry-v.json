  "synonym_discrimination": {
    "words": [
      "cry-v",
      "weep-v",
      "sob-v"
    ],
    "note": "**Cry** is the everyday word for producing tears: *the baby is crying*. **Weep** is more formal or literary and often suggests quiet tears: *she wept at the grave*. **Sob** means to cry noisily, with short breaths: *he sobbed into his pillow*."
  },
  "usage_note": "In everyday English **cry** most often means producing tears; for a loud voice, **shout**, **yell**, or **call** are more usual, and the shouting sense with quoted words belongs mainly to stories. **Cry out** covers a sudden shout of pain or fear in all styles.",
  "learner_errors": [
    {
      "incorrect": "The teacher cried at us to be quiet.",
      "correct": "The teacher shouted at us to be quiet.",
      "note": "In everyday English **cry** usually means producing tears; for a loud voice use **shout** or **yell**."
    },
    {
      "incorrect": "He made me to cry.",
      "correct": "He made me cry.",
      "note": "After **make someone**, use the base form without **to**."
    }
  ],
