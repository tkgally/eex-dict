  "synonym_discrimination": {
    "words": [
      "crazy-adj",
      "mad-adj"
    ],
    "note": "In American English, **mad** usually means *angry* (*She's mad at me*), and **crazy** usually means *foolish* or *wild* (*a crazy idea*). In British English, **mad** is common in both meanings (*a mad idea*). Both mean *liking very much* before **about**: *crazy about music*, *mad about music*."
  },
  "usage_note": "Using **crazy** about a person who really has an illness of the mind can hurt; careful speakers say *mentally ill* instead.",
  "learner_errors": [
    {
      "incorrect": "She is crazy of him.",
      "correct": "She is crazy about him.",
      "note": "In the sense of liking very much, **crazy** is followed by **about**."
    }
  ],
