  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**Lay** needs an object in its main senses: you **lay** something somewhere. **Lie** (past **lay**, past participle **lain**) has no object: you **lie** on a bed. The two are often mixed up, even by native speakers, because the past of **lie** is **lay**. In informal speech people often say *lay down* for *lie down*, but careful writing keeps them apart.",
  "learner_errors": [
    {
      "incorrect": "I'm going to lay down for an hour.",
      "correct": "I'm going to lie down for an hour.",
      "note": "For resting your body, the verb is **lie**: *lie down*."
    },
    {
      "incorrect": "She layed the book on the desk.",
      "correct": "She laid the book on the desk.",
      "note": "The past form of **lay** is **laid**."
    }
  ],
