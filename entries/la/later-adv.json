  "synonym_discrimination": null,
  "usage_note": "With a period of time, **later** counts forward from a moment in the past or in a story (*two days later*), while **in** counts forward from now (*in two days*). **Later** is the comparative of **late** (*She arrived later than me*), but on its own it usually just means *afterward*, with no comparison.",
  "learner_errors": [
    {
      "incorrect": "I'll call you two hours later.",
      "correct": "I'll call you in two hours.",
      "note": "To count forward from now, use **in**; **two hours later** counts from a time in the past."
    },
    {
      "incorrect": "After two days later, she came back.",
      "correct": "Two days later, she came back.",
      "note": "Use **after two days** or **two days later**, not both together."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"later\" with a period of time counts from a past moment (*three days later*); to count from now, English uses \"in\" (*in three days*). Some languages use one word for both, so learners often say \"later\" where English needs \"in\".",
