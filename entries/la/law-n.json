  "synonym_discrimination": {
    "words": [
      "law-n",
      "rule-n",
      "regulation-n"
    ],
    "note": "A **law** is made by a government and applies to everyone it covers: *a law against stealing*. A **rule** is set by a smaller group, such as a school, a club, or a game: *the rules of chess*. A **regulation** is an official rule, often detailed, made by an organization or a government department: *safety regulations*."
  },
  "usage_note": "*The law* (with **the**) is the whole system: *obey the law*, *against the law*. *A law* is one rule: *pass a law*. For the subject studied, use no article: *study law*.",
  "learner_errors": [
    {
      "incorrect": "It is against law to park here.",
      "correct": "It is against the law to park here.",
      "note": "The phrase is *against the law*, with **the**."
    },
    {
      "incorrect": "She wants to study laws.",
      "correct": "She wants to study law.",
      "note": "The subject is uncountable: *study law*."
    }
  ],
