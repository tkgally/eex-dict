  "synonym_discrimination": {
    "words": [
      "last-adj",
      "latest-adj"
    ],
    "note": "**Latest** means the newest, with more probably to come (*her latest movie*). **Last** can mean the final one, with no more after it (*her last movie* may mean she made no more), or simply the one before this one."
  },
  "usage_note": "Before **week**, **month**, **year**, and **night**, **last** has no **the** and no preposition: *last week*. *The last week* usually means the seven days up to now, or the final week of a period. **Last** is also an adverb (*He came last*) and a verb (*The movie lasts two hours*); see those entries.",
  "learner_errors": [
    {
      "incorrect": "I saw him in last week.",
      "correct": "I saw him last week.",
      "note": "Use no **in** and no **the** before *last week*, *last year*, and *last night* when you mean the one before this one."
    }
  ],
