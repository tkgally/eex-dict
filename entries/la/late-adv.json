  "synonym_discrimination": null,
  "usage_note": "**Late** is both an adjective and an adverb with the same form: *a late train*, *the train came late*. **Lately** is a different word that means *recently*: *I haven't seen him lately*. **Later** has its own entry for the meaning *at a time after now*.",
  "learner_errors": [
    {
      "incorrect": "The bus came lately.",
      "correct": "The bus came late.",
      "note": "**Lately** means *recently*; the adverb for *after the expected time* is **late**."
    },
    {
      "incorrect": "We arrived more late than the others.",
      "correct": "We arrived later than the others.",
      "note": "The comparative is **later**, not **more late**."
    }
  ],
