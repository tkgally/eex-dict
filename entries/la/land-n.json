  "synonym_discrimination": {
    "words": [
      "land-n",
      "ground-n",
      "earth-n",
      "soil-n"
    ],
    "note": "**Land** is the dry part of the earth or an area of it, often as property: *buy land*. **Ground** is the surface under your feet: *sit on the ground*. **Soil** is the material that plants grow in: *fill the pot with soil*; **earth** can mean this material or the ground, and with a capital letter it is the planet."
  },
  "usage_note": "In the sense *an area of ground*, **land** is uncountable: *some land*, *a piece of land*, not *a land*. **A land** and the plural **lands** mean countries or regions and belong to literary writing.",
  "learner_errors": [
    {
      "incorrect": "They bought a land near the river.",
      "correct": "They bought some land near the river.",
      "note": "For ground that someone owns, **land** is uncountable; say *some land* or *a piece of land*."
    },
    {
      "incorrect": "Many lands were sold to the company.",
      "correct": "A lot of land was sold to the company.",
      "note": "Use the uncountable form for ground; **lands** means countries in literary writing."
    }
  ],
