  "synonym_discrimination": {
    "words": [
      "laugh-v",
      "giggle-v",
      "smile-v"
    ],
    "note": "**Laugh** is the general word for the sound of something being funny: *we laughed at his joke*. **Giggle** is a quick, high, often nervous or silly laugh, common with children: *the girls giggled in the back row*. **Smile** has no sound at all: the corners of your mouth move up: *she smiled at me*."
  },
  "usage_note": "Notice the difference between **laugh at** and **laugh with**: *we laughed at him* usually means we made fun of him, while *we laughed with him* means we shared the joke. **Laugh at** a joke or a funny thing is neutral (*everyone laughed at the joke*).",
  "learner_errors": [
    {
      "incorrect": "Everybody laughed to my joke.",
      "correct": "Everybody laughed at my joke.",
      "note": "The thing that is funny takes **at**, not **to** or **for**."
    },
    {
      "incorrect": "He made me laughing.",
      "correct": "He made me laugh.",
      "note": "After **make someone**, use the base form: *make someone laugh*."
    },
    {
      "incorrect": "I laughed out loudly.",
      "correct": "I laughed out loud.",
      "note": "The fixed phrase is **out loud**, with no **-ly**."
    }
  ],
