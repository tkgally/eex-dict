  "synonym_discrimination": {
    "words": [
      "interested-adj",
      "interesting-adj"
    ],
    "note": "You are **interested** in something; the thing is **interesting** to you: *I am interested in art*; *Art is interesting*. The **-ed** word describes the person who feels, and the **-ing** word the thing that causes the feeling."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I am interesting in music.",
      "correct": "I am interested in music.",
      "note": "Use **interested** for how you feel; **interesting** describes the music."
    },
    {
      "incorrect": "I'm interested on football.",
      "correct": "I'm interested in football.",
      "note": "**Interested** takes **in**."
    }
  ],
