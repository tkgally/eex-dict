  "usage_note": "The preposition after **interest** is **in**: *an interest in music*. The feeling is described with the adjective **interested** (*I'm interested in music*) and the cause with **interesting** (*music is interesting*); both are separate entries.",
  "learner_errors": [
    {
      "incorrect": "I have a big interest for music.",
      "correct": "I have a strong interest in music.",
      "note": "Use **in** after **interest**, and **strong**, **keen**, or **great** rather than **big**."
    },
    {
      "incorrect": "The bank gives good interests.",
      "correct": "The bank pays good interest.",
      "note": "In the money sense **interest** is uncountable, and the verb is **pay**."
    }
  ],
