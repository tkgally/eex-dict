  "synonym_discrimination": {
    "words": [
      "influence-n",
      "effect-n",
      "impact-n"
    ],
    "note": "**Effect** is the general word for a result or change: *the effect of the medicine*. **Influence** is a power, often slow or hard to see, to shape how people think or act or how something develops: *the influence of friends*. **Impact** suggests a strong, sudden, or easily seen effect: *the storm's impact on the town*."
  },
  "usage_note": "**Influence** takes **on** for the person or thing affected (*an influence on young people*). For power it takes **over**, **with**, or **in**: *influence over the decision*, *influence with the boss*, *influence in the town*.",
  "learner_errors": [
    {
      "incorrect": "She has a big influence to her son.",
      "correct": "She has a big influence on her son.",
      "note": "Use **on** after **influence** for the person or thing affected."
    }
  ],
