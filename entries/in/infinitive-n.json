  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "the basic form of a verb, such as **go** or **be**, often with **to** before it",
      "explanation": "English uses two kinds: the infinitive with **to** (*I want to leave*), and the infinitive without **to** after modal verbs and a few other verbs (*you must leave*, *let me leave*). Which kind follows a verb depends on that verb, so it is best learned with the verb.",
      "grammar": {
        "countability": "countable",
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
        "domain": [],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "After \"want,\" use the infinitive with \"to.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "The infinitive of \"went\" is \"go.\"",
          "note": null,
          "pattern": null
        },
        {
          "text": "In \"She made me laugh,\" the verb \"laugh\" is an infinitive without \"to.\"",
          "note": null,
          "pattern": null
        }
      ],
