  "synonym_discrimination": {
    "words": [
      "piece-n",
      "part-n",
      "bit-n"
    ],
    "note": "**Piece** is a part that is separate or can be separated (*a piece of cake*). **Part** is any of the parts that make up a whole, separate or not (*part of the city*). **Bit** is like **piece** but more informal and usually small (*a bit of chocolate*)."
  },
  "usage_note": null,
