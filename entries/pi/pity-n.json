  "synonym_discrimination": null,
  "usage_note": "**Pity** can suggest that you think the other person is weak, so people often prefer **sympathy** for a kind feeling about someone's trouble. *It's a pity* is neutral and very common; *it's a shame* means the same and is a little more informal.",
  "learner_errors": [
    {
      "incorrect": "It's pity that you can't come.",
      "correct": "It's a pity that you can't come.",
      "note": "In this use, **pity** takes **a**: *it's a pity*, *what a pity*."
    }
  ],
