  "synonym_discrimination": {
    "words": [
      "picture-n",
      "photo-n",
      "photograph-n",
      "image-n"
    ],
    "note": "**Picture** is the most general word: a painting, a drawing, or a photograph (*a picture of a cat*). **Photo** and **photograph** are made only with a camera; **photo** is the everyday word (*a photo of my family*). **Image** is more formal and is used especially for pictures on screens (*a clear image*)."
  },
  "usage_note": null,
