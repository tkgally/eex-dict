  "synonym_discrimination": null,
  "usage_note": "**Addition** is usually uncountable when it means the math process of adding numbers: *practice addition*, *learn addition*. It can be countable for one problem in a set, as in *the first addition was easy*, though *addition problems* is the more natural way to say this. It is always countable when it means a person, thing, or room that has been added: *an addition to the team*, *build an addition*.",
  "learner_errors": [
    {
      "incorrect": "She is a new addition in the team.",
      "correct": "She is a new addition to the team.",
      "note": "**addition to** something, not **in**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**Addition** is usually uncountable for the math process (*learn addition*), though a countable use for one problem exists; it is always countable for a person, thing, or room added (*an addition to the team*, *build an addition*).",
    "culture": null,
    "false_friends": "An internationalism spelled like **addition** in several languages usually keeps the math sense; check whether it also covers a person or thing added, or a room built onto a house.",
    "pronunciation": null
  },
