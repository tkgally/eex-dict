  "adaptation": {
    "semantic": null,
    "grammar": "In *she is likely to win*, the person is the subject; many languages can only say *it is probable that she wins*. Both patterns are correct in English, but learners often miss the first.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "**Likely** has two syllables: *LIKE-lee*. The **e** in the middle is not said."
  },
