  "synonym_discrimination": {
    "words": [
      "likely-adj",
      "probable-adj",
      "possible-adj"
    ],
    "note": "Something **possible** can happen, even if it probably will not: *it's possible that he'll come*. Something **likely** or **probable** will probably happen: *it's likely that he'll come*. **Probable** is more formal, and only **likely** can have a person or thing as subject with **to**: *she is likely to win*, not *she is probable to win*."
  },
  "usage_note": "**Likely** is used in two patterns: *it is likely that* + a clause, and a subject + *be likely to* + a verb: *he is likely to agree*. **Likely** before a verb without **be** (*they will likely come*) is the adverb, common in American English; it has its own entry.",
  "learner_errors": [
    {
      "incorrect": "She likely to win.",
      "correct": "She is likely to win.",
      "note": "The adjective needs **be**: *be likely to*."
    },
    {
      "incorrect": "It is likely him to come.",
      "correct": "He is likely to come.",
      "note": "Make the person the subject, or say *it is likely that he will come*."
    }
  ],
  "etymology": null,
