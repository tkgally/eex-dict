  "synonym_discrimination": null,
  "usage_note": "This is the verb whose past form is **lay** and past participle **lain**. **Lie** meaning *say something that is not true* is a different verb with the regular past **lied**: *he lied to me*. Do not confuse either with **lay** (*put something down*), which almost always takes an object.",
  "learner_errors": [
    {
      "incorrect": "I laid down for an hour.",
      "correct": "I lay down for an hour.",
      "note": "The past of **lie** is **lay**; **laid** is the past of **lay**, which needs an object."
    },
    {
      "incorrect": "The book was laying on the floor.",
      "correct": "The book was lying on the floor.",
      "note": "With no object, the verb is **lie**, and its **-ing** form is **lying**."
    }
  ],
  "etymology": null,
