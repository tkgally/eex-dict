  "synonym_discrimination": {
    "words": [
      "living-adj",
      "alive-adj",
      "live-adj"
    ],
    "note": "**Alive** goes after a verb: *the fish is still alive*. **Living** usually goes before a noun, especially for people and for things in general: *living relatives*, *living things*. **Live** (rhymes with **five**) goes before a noun for animals and for events that happen as you watch them: *live fish*, *live music*."
  },
  "usage_note": "**The living** means people who are alive, as opposed to the dead: *the world of the living*.",
  "learner_errors": [
    {
      "incorrect": "There were no alive people in the building.",
      "correct": "There were no living people in the building.",
      "note": "**Alive** does not go before a noun; use **living** there, or say *nobody in the building was alive*."
    }
  ],
