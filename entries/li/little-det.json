  "synonym_discrimination": null,
  "usage_note": "Bare **little** says not enough; **a little** says a small but real amount. The same split applies to **few** and **a few** with countable plural nouns. The comparative of **little** is **less**, and the superlative is **least**: *less time*, *the least effort*. **Little** as an adjective meaning small in size (*a little house*), as a pronoun used alone without a noun (*she ate little*), and as an adverb (*a little tired*) belongs to separate entries.",
  "learner_errors": [
    {
      "incorrect": "I have little money, so I'm happy.",
      "correct": "I have a little money, so I'm happy.",
      "note": "Bare **little** sounds negative; a positive sentence about a small, sufficient amount needs **a little**."
    },
    {
      "incorrect": "She has little books.",
      "correct": "She has few books.",
      "note": "**Little** and **a little** go with uncountable nouns; countable plural nouns need **few** and **a few**."
    }
  ],
