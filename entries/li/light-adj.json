  "synonym_discrimination": {
    "words": [
      "light-adj",
      "pale-adj",
      "bright-adj"
    ],
    "note": "For colors, **light** means with a lot of white in it: *light green*. **Pale** means even lighter and weaker, and of a face it can mean ill: *pale yellow*, *you look pale*. **Bright** means strong and full of color: *bright red*. For a room, **bright** and **light** both mean full of light."
  },
  "usage_note": "**Light** meaning *not heavy* and **light** meaning *not dark* are used in the same forms, so the noun after it shows which is meant: *a light bag*, *a light room*. In American advertising, food with less fat or sugar is sometimes spelled **lite**.",
  "learner_errors": [
    {
      "incorrect": "I sleep very light.",
      "correct": "I'm a very light sleeper.",
      "note": "After **sleep**, use the adverb **lightly** (*I sleep lightly*), or say *a light sleeper*."
    },
    {
      "incorrect": "The rain was very weak today.",
      "correct": "The rain was very light today.",
      "note": "Rain, snow, and wind are **light**, not **weak**."
    }
  ],
