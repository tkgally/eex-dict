  "synonym_discrimination": {
    "words": [
      "listen-v",
      "hear-v"
    ],
    "note": "**Hear** is about sounds that reach your ears, whether you try or not: *I heard a noise outside*. **Listen** means you pay attention on purpose, and it takes **to** before an object: *listen to the radio*. You can **listen** and still not **hear**: *I listened but heard nothing*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I like to listen music.",
      "correct": "I like to listen to music.",
      "note": "**Listen** needs **to** before the thing you listen to."
    },
    {
      "incorrect": "Listen me!",
      "correct": "Listen to me!",
      "note": "Put **to** before the person."
    },
    {
      "incorrect": "I listened a strange noise last night.",
      "correct": "I heard a strange noise last night.",
      "note": "For a sound that reaches you without your trying, use **hear**; **listen** is about paying attention on purpose."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"listen\" takes **to** before an object: *listen to me*. In many languages the verb takes a direct object, so learners often leave **to** out.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"listen\": the **t** is not pronounced, as in **castle** and **whistle**."
  },
