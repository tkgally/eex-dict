  "learner_errors": [
    {
      "incorrect": "He works like a doctor at the clinic.",
      "correct": "He works as a doctor at the clinic.",
      "note": "**Like** only says something resembles a role, without being it; **as** names the actual role."
    },
    {
      "incorrect": "She looks like tired today.",
      "correct": "She looks tired today.",
      "note": "**Like** is followed by a noun or pronoun, not directly by an adjective; drop **like** before an adjective."
    },
    {
      "incorrect": "How is the weather like?",
      "correct": "What is the weather like?",
      "note": "Use **what**, not **how**, with **like** in a question asking for a description."
