  "synonym_discrimination": null,
  "usage_note": "**Live** is for your home over a long time. For a short time, use **stay**: *I'm staying at a hotel this week*. The continuous form **be living** shows that an arrangement is for now and may change: *I'm living with friends until I find an apartment*.",
  "learner_errors": [
    {
      "incorrect": "I live here since two years.",
      "correct": "I have lived here for two years.",
      "note": "For a time that started in the past and continues now, use **have lived** or **have been living** with **for** or **since**."
    },
    {
      "incorrect": "I am live in a small town.",
      "correct": "I live in a small town.",
      "note": "Do not put **am** before the verb in the simple present."
    },
    {
      "incorrect": "This week I live in a hotel.",
      "correct": "This week I'm staying at a hotel.",
      "note": "For a short visit, use **stay**, not **live**."
    }
  ],
