  "synonym_discrimination": null,
  "usage_note": "In sense 1, **like** can take the **-ing** form or **to** and a base form with little difference: *I like swimming*, *I like to swim*. After **would like**, only **to** is possible: *I'd like to swim*.",
  "learner_errors": [
    {
      "incorrect": "Yes, I like.",
      "correct": "Yes, I like it.",
      "note": "**Like** needs an object; add **it** or another word for the thing you like."
    },
    {
      "incorrect": "I like very much football.",
      "correct": "I like football very much.",
      "note": "Do not put **very much** between **like** and its object."
    },
    {
      "incorrect": "Do you like to come to my party?",
      "correct": "Would you like to come to my party?",
      "note": "To invite someone, use **would you like**; **do you like** asks what someone enjoys in general."
    }
  ],
