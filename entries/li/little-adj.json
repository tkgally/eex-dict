  "synonym_discrimination": {
    "words": [
      "little-adj",
      "small-adj"
    ],
    "note": "**Small** is the neutral word for size and is usual after a verb: *the room is small*. **Little** usually comes before a noun and often adds a feeling, such as liking or being sorry for someone: *a nice little house*, *the poor little cat*. For a younger brother or sister, say **little** or **younger**, not **small**."
  },
  "usage_note": "This adjective is rarely compared: people usually say **smaller** and **smallest** instead, and **littler** and **littlest** are informal. **Less** and **least** belong to **little** meaning *not much* (*little time*, *a little water*), which is the determiner; **a little** before an adjective (*a little tired*) is the adverb. Both have their own entries.",
  "learner_errors": [
    {
      "incorrect": "My small brother is ten.",
      "correct": "My little brother is ten.",
      "note": "For a younger brother or sister, say **little** or **younger**."
    },
    {
      "incorrect": "Our room is very little.",
      "correct": "Our room is very small.",
      "note": "After **be**, **small** is much more usual than **little**."
    }
  ],
