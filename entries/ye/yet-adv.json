  "synonym_discrimination": {
    "words": [
      "yet-adv",
      "still-adv",
      "already-adv"
    ],
    "note": "**Yet** is used in questions and negatives about something that you expect to happen (*Has he called yet?*). **Still** says that something continues, often longer than expected (*He's still asleep*). **Already** says that something has happened, often sooner than expected (*She's already left*)."
  },
  "usage_note": "**Yet** meaning *but* (*simple yet useful*) is a conjunction, which has its own entry. Both British and American English use **have** + past participle with **yet** (*Have you eaten yet?*); American English also uses the simple past (*Did you eat yet?*), especially in speech.",
  "learner_errors": [
    {
      "incorrect": "I have finished yet.",
      "correct": "I have already finished.",
      "note": "In a positive statement, use **already**; **yet** belongs in questions and negatives."
    },
    {
      "incorrect": "He yet hasn't arrived.",
      "correct": "He hasn't arrived yet.",
      "note": "**Yet** usually goes at the end; to put it before the verb, use **still**: *He still hasn't arrived*."
    }
  ],
