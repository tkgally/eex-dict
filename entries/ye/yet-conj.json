  "senses": [
    {
      "n": 1,
      "signpost": null,
      "definition": "used to add something surprising after what was just said",
      "explanation": "**Yet** joins two clauses in which the second seems, at first, to go against the first, much like **but**, but with more emphasis or surprise. It is often paired with **and**: **and yet**. It can also join two adjectives that seem to go against each other: *a simple yet effective idea*.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
        "domain": [],
        "currency": [],
        "attitude": []
      },
      "pronunciation": null,
      "examples": [
        {
          "text": "The test was hard, yet she passed easily.",
          "note": null,
          "pattern": null
        },
        {
          "text": "He is over eighty, yet he still runs every morning.",
          "note": null,
          "pattern": null
        },
        {
          "text": "It sounds strange, and yet it's true.",
          "note": null,
          "pattern": null
        },
        {
          "text": "Sara is shy, yet she loves speaking in front of a crowd.",
          "note": null,
          "pattern": null
        }
      ],
      "collocations": [
        {
          "type": "phrase",
          "items": [
            "and yet",
            "strange yet true",
            "simple yet effective"
          ]
        }
      ],
      "synonyms": [
        {
          "slug": "but-conj",
          "note": "**but** is the everyday word; **yet** adds emphasis to a contrast that feels surprising"
        }
      ],
