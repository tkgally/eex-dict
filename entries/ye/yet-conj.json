  "synonym_discrimination": null,
  "usage_note": "**Yet** as a conjunction is a little more formal than **but** and is more common in writing. It is not used as a second contrast word after **although** or **though**: one word for the contrast is enough.",
  "learner_errors": [
    {
      "incorrect": "Although he was tired, yet he kept working.",
      "correct": "Although he was tired, he kept working.",
      "note": "Use either **although** or **yet**, not both: *He was tired, yet he kept working*."
    }
  ],
