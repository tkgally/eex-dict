  "synonym_discrimination": null,
  "usage_note": "No preposition before **this year**, **last year**, **next year**, or **every year**. Use **in** before a year as a number (*in 1990*) and **for** with a length of time (*for three years*). When a number and **year** come before a noun, **year** is singular and the words are joined: *a ten-year-old girl*.",
  "learner_errors": [
    {
      "incorrect": "I am twenty years.",
      "correct": "I am twenty years old.",
      "note": "Say **twenty years old**, or simply **I'm twenty**."
    },
    {
      "incorrect": "I came here before two years.",
      "correct": "I came here two years ago.",
      "note": "Use **ago** after the time to count back from now."
    },
    {
      "incorrect": "a ten-years-old boy",
      "correct": "a ten-year-old boy",
      "note": "Before a noun, **year** stays singular and takes hyphens."
    }
