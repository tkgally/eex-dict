  "synonym_discrimination": {
    "words": [
      "break-n",
      "rest-n",
      "pause-n"
    ],
    "note": "A **break** is a stop in work or study, or in something that is going on: *a lunch break*. A **rest** is time to relax so that your body or mind can recover: *You need a good rest*. A **pause** is a very short stop, often in speech or music: *After a pause, she answered*."
  },
