  "synonym_discrimination": null,
  "usage_note": "Learners often confuse **bring** and **take**: **bring** describes movement toward the speaker or toward a place they will be, and **take** describes movement away from them. *I'll bring the cake to your party* (toward you); *I'll take the cake to the party* (away from me, toward a third place).",
  "learner_errors": [
    {
      "incorrect": "I bought my laptop to class.",
      "correct": "I brought my laptop to class.",
      "note": "**brought** is the past of **bring**; **bought** is the past of **buy**."
    },
    {
      "incorrect": "She brang some cake.",
      "correct": "She brought some cake.",
      "note": "**Bring** does not change its vowel like **sing**, **sang**; the past tense and past participle are both **brought**."
    }
  ],
