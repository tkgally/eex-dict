  "synonym_discrimination": null,
  "usage_note": "Learners often confuse **bring** and **take**: **bring** describes movement toward the speaker or toward a place they will be, and **take** describes movement away from them. *I'll bring the cake to your party* (toward you); *I'll take the cake to the party* (away from me, toward a third place).",
  "learner_errors": [
    {
      "incorrect": "I'll bring these files to the client's office on my way to work.",
      "correct": "I'll take these files to the client's office on my way to work.",
      "note": "**Bring** moves something toward the speaker or listener; movement to a third place, away from both, uses **take**."
    }
  ],
