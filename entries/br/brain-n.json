  "synonym_discrimination": {
    "words": [
      "brain-n",
      "mind-n"
    ],
    "note": "**Brain** is the part of the body inside the head; it can be hurt and doctors can see it: *brain damage*. **Mind** is a person's thinking, feeling, and remembering: *She has a quick mind*, *I changed my mind*. You can say *use your brain* or *use your mind* for thinking hard, but decisions and opinions belong to the **mind**."
  },
  "usage_note": null,
