  "synonym_discrimination": {
    "words": [
      "possible-adj",
      "likely-adj",
      "probable-adj"
    ],
    "note": "**Possible** means that something can happen, even if the chance is small: *Snow is possible, but it isn't likely*. **Likely** and **probable** mean that the chance is good. **Likely** is the everyday word and can take **to**: *She's likely to win*. **Probable** is more formal."
  },
  "usage_note": "A person is not **possible**: the subject is usually **it** or the thing that can happen. Say *It's possible for me to come* or *I can come*, not *I am possible to come*. The pattern *as quickly as possible* means *as quickly as can be done*.",
  "learner_errors": [
    {
      "incorrect": "I am possible to come tomorrow.",
      "correct": "It is possible for me to come tomorrow.",
      "note": "Use **it** as the subject, or say *I can come*."
    },
    {
      "incorrect": "Please reply as soon as possibly.",
      "correct": "Please reply as soon as possible.",
      "note": "The fixed phrase uses the adjective **possible**, not the adverb."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**possible** usually has *it* as its subject before an infinitive: *it is possible to go*. A person cannot be the subject (*I am possible to go* is wrong), although some languages allow this with their own word.",
