  "synonym_discrimination": {
    "words": [
      "possibility-n",
      "chance-n",
      "opportunity-n"
    ],
    "note": "**Possibility** is something that may happen or be true: *a possibility of rain*. **Chance** can mean the same, and also a time when you can do something: *a chance to rest*. **Opportunity** is a good time or situation for doing something you want to do: *an opportunity to travel*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "There is a possibility to rain.",
      "correct": "There is a possibility that it will rain.",
      "note": "When **possibility** means that something may happen, it is followed by **of** and an *-ing* form or by a **that**-clause."
    },
    {
      "incorrect": "I had the possibility to study abroad.",
      "correct": "I had the opportunity to study abroad.",
      "note": "For a good chance to do something, English says **opportunity** or **chance**."
    }
  ],
