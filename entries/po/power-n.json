  "synonym_discrimination": {
    "words": [
      "power-n",
      "authority-n",
      "control-n"
    ],
    "note": "**Power** is the general word for the ability to control people or events (*the power of money*). **Authority** is power that comes from a position or the law and that people accept (*She has the authority to sign the contract*). **Control** is power over something at a particular moment, in practice (*He lost control of the car*)."
  },
