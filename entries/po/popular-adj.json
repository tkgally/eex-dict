  "synonym_discrimination": {
    "words": [
      "popular-adj",
      "famous-adj"
    ],
    "note": "**Famous** means that many people know about someone or something: *a famous actor*. **Popular** means that many people like it or use it: *a popular café*. A famous person can be unpopular, and a popular local restaurant need not be famous."
  },
  "usage_note": "Something is **popular with** or **among** a group of people, not **for** them: *popular with tourists*.",
  "learner_errors": [
    {
      "incorrect": "The museum is popular for tourists.",
      "correct": "The museum is popular with tourists.",
      "note": "Use **with** (or **among**) before the people who like something."
    }
  ],
