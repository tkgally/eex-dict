  "synonym_discrimination": null,
  "usage_note": "Before a noun, **poor** can mean either *with little money* (sense 1) or *making you feel sorry for them* (sense 4): *the poor woman* is often the second. After a verb, it means sense 1, 2, or 3: *She is poor*, *The light was poor*, *He is poor at math*. The noun is **poverty**: *They live in poverty*.",
  "learner_errors": [
    {
      "incorrect": "He is a poor.",
      "correct": "He is poor.",
      "note": "**Poor** is an adjective, so it needs no **a** unless a noun follows: *a poor man*."
    },
    {
      "incorrect": "Many people there live in poor.",
      "correct": "Many people there live in poverty.",
      "note": "After a preposition use the noun **poverty**."
    }
