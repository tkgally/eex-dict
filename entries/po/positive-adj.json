  "synonym_discrimination": {
    "words": [
      "positive-adj",
      "sure-adj",
      "certain-adj"
    ],
    "note": "**Sure** is the everyday word: *I'm sure she'll come*. **Certain** is a little more formal. **Positive** is stronger: it says that you have no doubt at all, and it is used mainly after **be**: *I'm positive I paid*."
  },
  "usage_note": "In sense 4, **positive** comes after a verb such as **be**, not before a noun: *I'm positive*, not *a positive person* (which means a hopeful person, sense 1).",
  "learner_errors": [
    {
      "incorrect": "I feel positive for the future.",
      "correct": "I feel positive about the future.",
      "note": "Use **about** before the thing you feel hopeful about."
    },
    {
      "incorrect": "She was tested positive.",
      "correct": "She tested positive.",
      "note": "With a test result, say *test positive*, not *be tested positive*."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "In many languages the word that looks like **positive** does not mean *completely certain* (sense 4); a translator may need a word like *sure* there.",
