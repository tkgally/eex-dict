    {
      "incorrect": "I waked up late this morning.",
      "correct": "I woke up late this morning.",
      "note": "The usual past tense is **woke** and the past participle **woken**; **waked** is rare."
    },
    {
      "incorrect": "Please awake me at six.",
      "correct": "Please wake me at six.",
      "note": "**Awake** is mostly an adjective; for the action, use **wake** or **wake up**."
