  "synonym_discrimination": {
    "words": [
      "want-v",
      "like-v",
      "wish-v",
      "desire-v"
    ],
    "note": "**Want** is the everyday word: *I want a drink*. **Would like** is more polite: *I'd like a drink, please*. **Wish** is used for something that is not true now or is unlikely (*I wish I were taller*), for good hopes for someone (*I wish you a safe trip*), and in formal speech (*if you wish*). **Desire** is formal or literary."
  },
  "usage_note": "**I want** can sound rude when you ask for something. In a shop or a restaurant, **I'd like** or **Could I have** is more polite: *I'd like a coffee, please*.",
  "learner_errors": [
    {
      "incorrect": "I want that you come with me.",
      "correct": "I want you to come with me.",
      "note": "**Want** is followed by an object and a **to**-infinitive, not a **that**-clause."
    },
    {
      "incorrect": "I'm wanting a coffee.",
      "correct": "I want a coffee.",
      "note": "**Want** is not normally used in continuous tenses."
    },
    {
      "incorrect": "I want go home now.",
      "correct": "I want to go home now.",
      "note": "Another verb after **want** needs **to**."
    }
  ],
