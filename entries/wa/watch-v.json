  "synonym_discrimination": {
    "words": [
      "watch-v",
      "look-v",
      "see-v"
    ],
    "note": "**Watch** means look at something that moves or changes, for some time: *watch a game*, *watch the children play*. **Look at** means turn your eyes toward something, often something still: *look at a photo*. **See** means notice with your eyes, often without trying: *I saw a bird*. You **watch television**, but you usually **see** a movie at the movie theater."
  },
  "usage_note": "**Watch someone do something** is used for a whole action seen from start to end: *I watched him park the car*. **Watch someone doing something** is used for an action while it is happening: *I watched him parking the car*.",
  "learner_errors": [
    {
      "incorrect": "I saw TV last night.",
      "correct": "I watched TV last night.",
      "note": "Use **watch** for television."
    },
    {
      "incorrect": "I watched him to leave the house.",
      "correct": "I watched him leave the house.",
      "note": "After **watch someone**, use the base form or the **-ing** form, not **to**."
    }
  ],
  "etymology": null,
