  "synonym_discrimination": {
    "words": [
      "warn-v",
      "caution-v",
      "alert-v"
    ],
    "note": "**Warn** is the general word for telling someone about a danger: *warn someone about the ice*. **Caution** is more formal and usually means advise someone to be careful: *caution against a quick decision*. **Alert** means make someone aware of a danger or a problem, often so that they can act: *alert the police*."
  },
  "usage_note": "**Warn of** is more formal than **warn about** and is common in news reports: *warn of storms*. **Warn against** is followed by a noun or an **-ing** form: *warn against eating raw meat*.",
  "learner_errors": [
    {
      "incorrect": "She warned to me that the bridge was closed.",
      "correct": "She warned me that the bridge was closed.",
      "note": "**Warn** takes the person as a direct object, with no **to**."
    },
    {
      "incorrect": "He warned me about that the road was closed.",
      "correct": "He warned me that the road was closed.",
      "note": "Use **about** before a noun, or a **that**-clause, but not both."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"warn\" takes the person as a direct object: *warn someone that...*, *warn someone about something*, *warn someone not to do something*. Do not add **to** before the person.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"warn\" sounds the same as **worn**; the **ar** here does not sound like the **ar** of **car**."
  },
