  "synonym_discrimination": {
    "words": [
      "wait-v",
      "expect-v",
      "await-v"
    ],
    "note": "**Wait** means stay or do nothing until something happens: *wait for the bus*. **Expect** means think that something will happen: *I expect the bus in five minutes*. **Await** is formal and takes an object with no **for**: *await a reply*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm waiting you outside.",
      "correct": "I'm waiting for you outside.",
      "note": "The person or thing you wait for follows **for**."
    },
    {
      "incorrect": "I'm waiting that she calls me.",
      "correct": "I'm waiting for her to call me.",
      "note": "Use **wait for** + a person + a **to**-infinitive, not a **that**-clause."
    }
