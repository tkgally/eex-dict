  "synonym_discrimination": {
    "words": [
      "wash-v",
      "clean-v",
      "rinse-v"
    ],
    "note": "**Wash** means clean with water and usually soap: *wash the dishes*. **Clean** is the general word for making something free of dirt in any way: *clean the windows*, *clean the oven*. **Rinse** means pour water over something to take away soap or dirt, without rubbing it: *rinse the glass*."
  },
  "usage_note": "**Wash up** means different things in different places. In American English it means wash your hands and face: *go wash up before dinner*. In British English it means wash the plates and pans after a meal. **Do the dishes** is understood everywhere.",
  "learner_errors": [
    {
      "incorrect": "I washed my teeth.",
      "correct": "I brushed my teeth.",
      "note": "Teeth are **brushed**, not washed."
    },
    {
      "incorrect": "I washed me and went to bed.",
      "correct": "I washed and went to bed.",
      "note": "**Wash** with no object already means wash yourself; **washed myself** is possible, **washed me** is not."
    }
  ],
