  "synonym_discrimination": {
    "words": [
      "war-n",
      "battle-n",
      "conflict-n",
      "fight-n"
    ],
    "note": "A **war** is a long period of fighting between countries or groups (*the war lasted for years*). A **battle** is one fight inside a war (*they lost the battle but won the war*). **Conflict** is a more general and more formal word for fighting or serious disagreement (*the conflict in the region*). A **fight** is usually between a few people, with hands or words (*a fight outside the bar*)."
  },
  "usage_note": "Say **at war** for the state of fighting (*The two countries are at war*) and **in the war** for things that happened during a particular war (*She lost her brother in the war*).",
  "learner_errors": [
    {
      "incorrect": "The two countries are in war.",
      "correct": "The two countries are at war.",
      "note": "Use **at war** for countries that are fighting each other."
    },
    {
      "incorrect": "He died at the war.",
      "correct": "He died in the war.",
      "note": "Use **in** for things that happened during a war."
    }
  ],
