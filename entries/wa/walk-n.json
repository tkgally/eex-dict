  "synonym_discrimination": null,
  "usage_note": "You **go for** or **take** a walk, and **take** a person or a dog **for** a walk. A distance is often given as time: *It's a ten-minute walk*.",
  "learner_errors": [
    {
      "incorrect": "Let's make a walk in the park.",
      "correct": "Let's take a walk in the park.",
      "note": "Use **take** or **go for** a walk, not *make* or *do*."
    },
    {
      "incorrect": "The station is ten minutes walk.",
      "correct": "The station is a ten-minute walk.",
      "note": "Say **a ten-minute walk**, with **a** and no **-s** on **minute**, or *ten minutes' walk*."
    }
  ],
