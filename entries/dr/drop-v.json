  "synonym_discrimination": {
    "words": [
      "drop-v",
      "fall-v"
    ],
    "note": "**Fall** has no object: something **falls** (*the glass fell*). **Drop** can have an object: you **drop** something (*I dropped the glass*). Without an object, **drop** often suggests a sudden or straight fall (*the glass dropped to the floor*)."
  },
  "usage_note": null,
  "learner_errors": [
