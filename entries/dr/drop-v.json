      "incorrect": "I fell my phone and it broke.",
      "correct": "I dropped my phone and it broke.",
      "note": "**Fall** cannot take an object; use **drop** for letting something fall."
    },
    {
      "incorrect": "The book droped on the floor.",
      "correct": "The book dropped on the floor.",
      "note": "The **p** is doubled before **-ed** and **-ing**: **dropped**, **dropping**."
    }
