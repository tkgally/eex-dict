  "synonym_discrimination": null,
  "usage_note": "**Often** usually comes before the main verb (*I often go*), after **be** (*She is often late*), or after the first helping verb (*I have often wondered*). It can also come at the end, especially with **quite** or **very** (*We see them quite often*). The comparative is usually **more often**. *More often than not* is in the entry for **more**.",
  "learner_errors": [
    {
      "incorrect": "I eat often rice.",
      "correct": "I often eat rice.",
      "note": "Do not put **often** between the verb and its object; put it before the main verb."
    },
    {
      "incorrect": "How many times do you often go?",
      "correct": "How often do you go?",
      "note": "To ask about frequency, say **how often**."
    }
