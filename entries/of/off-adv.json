  "synonym_discrimination": null,
  "usage_note": "**Off** with a noun after it (*off the table*) is a preposition, in the entry **off** (preposition); **off** describing a state after **be** (*The milk is off*, *The game is off*) is an adjective. Many phrasal verbs use **off**, such as **take off**, **turn off**, **get off**, and **put off**; each has its own entry.",
  "learner_errors": [
    {
      "incorrect": "Please open off the light.",
      "correct": "Please turn off the light.",
      "note": "A light or a machine is turned **off** or switched **off**; **open** and **close** are not used."
    }
  ],
