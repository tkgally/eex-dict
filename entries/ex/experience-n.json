  "synonym_discrimination": null,
  "usage_note": "Knowledge from doing something is uncountable: *a lot of experience*, *ten years of experience*. Single events are countable: *two strange experiences*. After **experience**, use **of**, **with**, or **in** before a noun (*experience of teaching*, *experience with computers*, *experience in sales*), or put an **-ing** form directly after it (*experience working with children*).",
  "learner_errors": [
    {
      "incorrect": "I have many experiences in teaching.",
      "correct": "I have a lot of experience in teaching.",
      "note": "Knowledge from doing a job is uncountable."
    },
    {
      "incorrect": "We made a wonderful experience.",
      "correct": "We had a wonderful experience.",
      "note": "You **have** an experience; you do not **make** one."
    }
  ],
