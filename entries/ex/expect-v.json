  "synonym_discrimination": {
    "words": [
      "expect-v",
      "hope-v",
      "wait-v",
      "look-forward-to-phrv"
    ],
    "note": "**Expect** means you believe something will happen, good or bad: *I expect the bus will be late*. **Hope** means you want something to happen but are not sure it will: *I hope the bus is on time*. **Wait** (**wait for**) is about the time before something happens: *We waited for the bus for an hour*. **Look forward to** means you are happy about something that is coming: *I'm looking forward to the trip*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I'm expecting the bus for twenty minutes.",
      "correct": "I've been waiting for the bus for twenty minutes.",
      "note": "For the time you spend before something comes, use **wait for**."
    },
    {
      "incorrect": "I expect you have a good trip.",
      "correct": "I hope you have a good trip.",
      "note": "To wish someone something good, use **hope**, not **expect**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"expect\": many languages use one word where English has **expect**, **hope**, and **wait**. In English, **expect** is a belief, **hope** is a wish, and **wait** is the time that passes.",
