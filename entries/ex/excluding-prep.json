      "n": 1,
      "signpost": null,
      "definition": "not including someone or something",
      "explanation": "**Excluding** is common with prices and numbers, to say what is not counted. It is more formal than **except**.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
