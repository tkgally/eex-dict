  "synonym_discrimination": {
    "words": [
      "explode-v",
      "blow-up-phrv",
      "burst-v"
    ],
    "note": "**Explode** is the general word for something that bursts with force and a loud noise, often with fire: *the bomb exploded*. **Blow up** is less formal and can be used with or without an object: *the car blew up*, *they blew up the bridge*. **Burst** is used when something breaks open because of pressure inside it, usually without fire: *the balloon burst*, *a pipe burst*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "After the crash, the car was exploded.",
      "correct": "After the crash, the car exploded.",
      "note": "When something bursts by itself, **explode** has no object and no passive: *the car exploded*. Use the passive only when someone makes it explode: *the bomb was exploded by the police*."
    },
    {
      "incorrect": "He exploded to me when I was late.",
      "correct": "He exploded at me when I was late.",
      "note": "When someone suddenly gets angry with a person, the preposition is **at**."
    }
  ],
