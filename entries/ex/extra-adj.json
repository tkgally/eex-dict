  "synonym_discrimination": {
    "words": [
      "extra-adj",
      "additional-adj",
      "spare-adj"
    ],
    "note": "**Extra** means more than usual or more than you need: *an extra blanket*. **Additional** means the same but is more formal: *additional costs*. **Spare** means kept in case you need it, or not being used now: *a spare key*, *a spare room*."
  },
  "usage_note": "**Extra** goes after words like **a**, **the**, and **my**, or after a number: *an extra hour*, *the extra chair*, *two extra people*. **Extra** before an adjective or an adverb (*extra large*, *extra carefully*) and after a verb (*pay extra*) is the adverb, and **an extra** (a person in the background of a film, or something you pay more for) is the noun.",
  "learner_errors": [
    {
      "incorrect": "I need extra one chair.",
      "correct": "I need one extra chair.",
      "note": "**Extra** comes after the number or after **a**, **an**: *one extra chair*, *an extra chair*."
    },
    {
      "incorrect": "Breakfast is extra cost.",
      "correct": "Breakfast is extra.",
      "note": "After **be**, use **extra** alone; you can also say *breakfast costs extra*."
    }
  ],
