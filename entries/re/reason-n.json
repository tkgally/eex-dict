  "synonym_discrimination": {
    "words": [
      "reason-n",
      "cause-n"
    ],
    "note": "A **cause** is what makes something happen, often an event or a thing: *the cause of the fire*. A **reason** explains why something happened or why a person acted: *the reason I left*. A person usually has a **reason**, not a **cause**, for doing something."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "The reason of my visit is to see you.",
      "correct": "The reason for my visit is to see you.",
      "note": "Use **reason for**, not **reason of**, before a noun."
    },
    {
      "incorrect": "The reason is because I was ill.",
      "correct": "The reason is that I was ill.",
      "note": "In careful English, **the reason is** is followed by **that**; **because** here is common in speech but often corrected."
    }
