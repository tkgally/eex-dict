  "synonym_discrimination": {
    "words": [
      "real-adj",
      "genuine-adj",
      "true-adj",
      "actual-adj"
    ],
    "note": "**Real** is the general word: *real gold*, *the real reason*. **Genuine** stresses that something is not a copy or not pretended: *genuine leather*, *genuine interest*. **True** is used for facts and statements: *a true story*. **Actual** points to what exists or happened, often in contrast with what was expected: *the actual cost*."
  },
  "usage_note": "In informal American speech **real** is often used before an adjective to mean *very*: *real good*. **Really** is the standard choice in writing and in careful speech: *really good*.",
  "learner_errors": [
    {
      "incorrect": "I real like this song.",
      "correct": "I really like this song.",
      "note": "Before a verb, use the adverb **really**."
    }
