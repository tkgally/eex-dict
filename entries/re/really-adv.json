  "synonym_discrimination": {
    "words": [
      "really-adv",
      "very-adv"
    ],
    "note": "**Very** goes only before adjectives and adverbs: *very cold*, *very slowly*. **Really** can go there too, and also before a verb: *I really like it*, not *I very like it*. **Really** is especially common in conversation."
  },
  "usage_note": "With a negative, the place of **really** changes the meaning: *I don't really like it* means *I like it only a little*, but *I really don't like it* means *I dislike it a lot*.",
  "learner_errors": [
    {
      "incorrect": "I like really this song.",
      "correct": "I really like this song.",
      "note": "**Really** goes before the main verb, not between the verb and its object."
    },
    {
      "incorrect": "He's a really friend.",
      "correct": "He's a real friend.",
      "note": "Before a noun, use the adjective **real**; **really** goes before an adjective, an adverb, or a verb."
    }
  ],
