  "synonym_discrimination": {
    "words": [
      "remain-v",
      "stay-v"
    ],
    "note": "**Stay** is the everyday word: *Stay here*, *It stayed cold*. **Remain** means the same but is more formal and common in writing and announcements: *Please remain seated*. Only **remain** has the sense *be left*: *Only a few cookies remained*."
