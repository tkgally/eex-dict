  "synonym_discrimination": null,
  "usage_note": "**Reported speech** is the grammar term for telling what someone said without their exact words (*She said that she was tired*). In news and official language, the passive **be reported to** + infinitive (*He is reported to be in hospital*) shows that the writer has heard the information but has not checked it.",
  "learner_errors": [
    {
      "incorrect": "I reported the police about the accident.",
      "correct": "I reported the accident to the police.",
      "note": "The thing is the object of **report**; the person or the authority comes after **to**."
    },
    {
      "incorrect": "He reported me that the meeting was cancelled.",
      "correct": "He told me that the meeting was cancelled.",
      "note": "**Report** does not take a person as the object before a **that**-clause; use **tell** in everyday speech."
    }
  ],
