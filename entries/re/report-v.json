  "adaptation": {
    "semantic": null,
    "grammar": "The person told comes after **to**: *report the theft to the police*, never *report the police the theft*. *Report someone* (with a person as object) means telling an authority about something wrong they did.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"report\" has the stress on the second part, *rih-PORT*, for both the verb and the noun."
  },
