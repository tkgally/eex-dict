  "usage_note": "**Recently** can go at the start or the end of a sentence, or before the main verb. *Until recently* means *up to a short time ago, but not now*: *Until recently, he lived alone*.",
  "learner_errors": [
    {
      "incorrect": "I saw him recently ago.",
      "correct": "I saw him recently.",
      "note": "Do not use **ago** with **recently**; say *recently* or *a short time ago*."
    },
    {
      "incorrect": "Recently I go to the gym a lot.",
      "correct": "Recently I've been going to the gym a lot.",
      "note": "For something that has been happening for a time up to now, use the present perfect continuous with **recently**."
