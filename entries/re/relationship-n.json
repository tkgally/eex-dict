  "synonym_discrimination": {
    "words": [
      "relationship-n",
      "relation-n"
    ],
    "note": "**Relationship** is the usual word for the connection between two people or two things: *a good relationship with my boss*. **Relations**, in the plural, is used for the dealings between groups or countries: *relations between the two countries*. The singular **relation** is often a family member: *a distant relation*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I have a good relationship to my sister.",
      "correct": "I have a good relationship with my sister.",
      "note": "Use **with** for the person you have a relationship with; **to** is used for a family connection or a link between things."
    }
  ],
