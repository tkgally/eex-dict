  "synonym_discrimination": null,
  "usage_note": "**Cuts** in the plural, with no other word, often means reductions in government spending (*the cuts have hurt schools*). **A cut in** something names the thing reduced (*a cut in prices*); **cuts to** is common for a budget or a service (*cuts to the health service*).",
  "learner_errors": [
    {
      "incorrect": "They made a cut of the price.",
      "correct": "They made a cut in the price.",
      "note": "A reduction is a **cut in** something, not **of**; **a cut of** means a share or a piece (*a cut of the profits*, *a cut of meat*)."
    }
  ],
