  "synonym_discrimination": {
    "words": [
      "lonely-adj",
      "alone-adj"
    ],
    "note": "**Alone** means without other people, and says nothing about how you feel: *I live alone*. **Lonely** means unhappy because you are alone: *I feel lonely*. You can be **alone** without being **lonely**, and **lonely** in a room full of people."
  },
  "usage_note": "In American English, **lonesome** is also used for sense 1, especially in speech and songs.",
  "learner_errors": [
    {
      "incorrect": "I like being lonely sometimes.",
      "correct": "I like being alone sometimes.",
      "note": "**Lonely** means unhappy; if you enjoy it, you are **alone**."
    },
    {
      "incorrect": "She lives lonely in a big house.",
      "correct": "She lives alone in a big house.",
      "note": "**Lonely** is not used as an adverb after a verb like **live**; say **alone**."
    }
  ],
