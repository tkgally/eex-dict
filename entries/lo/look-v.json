  "synonym_discrimination": {
    "words": [
      "look-v",
      "see-v",
      "watch-v"
    ],
    "note": "**See** is what happens when something comes into your eyes, whether you try or not: *I saw a bird*. **Look** is turning your eyes toward something on purpose, and takes **at**: *look at the bird*. **Watch** is looking at something for a time, especially something that moves or changes: *watch a movie*, *watch the children*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Look this picture.",
      "correct": "Look at this picture.",
      "note": "**Look** needs **at** before the thing you look at."
    },
    {
      "incorrect": "You look like tired.",
      "correct": "You look tired.",
      "note": "Before an adjective, **look** needs no **like**; use **like** before a noun: *you look like a teacher*."
    }
  ],
