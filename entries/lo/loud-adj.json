  "synonym_discrimination": {
    "words": [
      "loud-adj",
      "noisy-adj"
    ],
    "note": "**Loud** describes a sound, or the thing that makes it: *a loud noise*, *loud music*, *a loud voice*. **Noisy** describes a person, place, or thing that makes a lot of noise or is full of noise: *a noisy street*, *noisy children*. You say *a loud voice*, not usually *a noisy voice*."
  },
  "usage_note": "After a verb, the usual adverb is **loudly**: *He laughed loudly*. In informal speech, **loud** itself is also used this way, especially after **talk**, **speak**, and **laugh** (*Don't talk so loud*), and in *out loud*.",
  "learner_errors": [
    {
      "incorrect": "Can you speak more loud, please?",
      "correct": "Can you speak louder, please?",
      "note": "The comparative is **louder**, not **more loud**."
    }
  ],
