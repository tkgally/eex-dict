  "synonym_discrimination": null,
  "usage_note": "**Local** is an adjective; the noun **a local** means a person who lives in a place (*ask one of the locals*), and in informal British English also a bar near your home. Neither means a room or a building.",
  "learner_errors": [
    {
      "incorrect": "We rented a local for our new shop.",
      "correct": "We rented a space for our new shop.",
      "note": "**Local** is not a noun for a room or a building; say **space**, **room**, or **building**."
    }
  ],
