  "usage_note": "Sense 1 is usually praise (*a sensitive teacher*), but sense 2 is often a criticism (*Don't be so sensitive*). Learners often confuse **sensitive** with **sensible**, which means having good judgment.",
  "learner_errors": [
    {
      "incorrect": "It was a sensitive decision to save some money.",
      "correct": "It was a sensible decision to save some money.",
      "note": "For good judgment, use **sensible**; **sensitive** is about feelings or reacting easily."
    },
    {
      "incorrect": "She is sensitive for criticism.",
      "correct": "She is sensitive to criticism.",
      "note": "The usual preposition is **to**, or **about** for a topic."
    }
