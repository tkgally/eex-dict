  "synonym_discrimination": null,
  "usage_note": "The past tense and past participle are both **set**. Do not confuse **set** with **sit**: you *sit down* yourself, but you *set something down*; the sun *sets*, and its past is *set*, not *sat*. *Be set to* (*Prices are set to rise*) and *all set* (*Are you all set?*) are adjective uses; see **set** (adjective).",
  "learner_errors": [
    {
      "incorrect": "I setted my alarm for six.",
      "correct": "I set my alarm for six.",
      "note": "The past tense and past participle of **set** are both **set**."
    },
    {
      "incorrect": "The sun sat at seven o'clock.",
      "correct": "The sun set at seven o'clock.",
      "note": "**Sat** is the past of **sit**; the past of **set** is **set**."
    }
  ],
