  "synonym_discrimination": {
    "words": [
      "secret-adj",
      "private-adj",
      "confidential-adj"
    ],
    "note": "**Secret** means deliberately hidden from other people: *a secret plan*. **Private** means belonging to one person or group, or not meant for the public, without the idea of hiding: *a private letter*, *private life*. **Confidential** is used for official or business information that must be shared only with certain people: *confidential documents*."
  },
  "usage_note": "**Secret** is also a noun (*Can you keep a secret?*); that is a separate entry. The adverb is **secretly**: *They met secretly*.",
  "learner_errors": [
    {
      "incorrect": "Please keep it secretly.",
      "correct": "Please keep it secret.",
      "note": "After **keep it**, use the adjective **secret**, not the adverb **secretly**."
    }
  ],
