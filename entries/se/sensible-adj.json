  "synonym_discrimination": {
    "words": [
      "sensible-adj",
      "reasonable-adj",
      "practical-adj"
    ],
    "note": "**Sensible** praises good everyday judgment: *a sensible plan*, *Be sensible!* **Reasonable** means fair or easy to accept, and is common for prices and requests: *a reasonable price*. **Practical** stresses what works in real life: *a practical solution*."
  },
  "usage_note": "The noun for this kind of good judgment is **sense**, as in *common sense* and *have the sense to do something*. **Sensibility** means something different: the ability to feel and understand art or emotion.",
  "learner_errors": [
    {
      "incorrect": "She is very sensible and cries at sad films.",
      "correct": "She is very sensitive and cries at sad films.",
      "note": "For someone easily moved or upset, use **sensitive**; **sensible** means having good judgment."
    }
  ],
