  "synonym_discrimination": null,
  "usage_note": "**Second** is written **2nd** in short form (*the 2nd of May*). It usually comes after **the**, **a**, or a word such as **my** (*the second floor*, *a second chance*, *her second book*). **Second** meaning a very short time is a noun with its own entry. *Every second day* means every other day: one day yes, the next day no.",
  "learner_errors": [
    {
      "incorrect": "the two of May",
      "correct": "the second of May",
      "note": "Dates use the ordinal number: *the second of May* or *May second*."
    },
    {
      "incorrect": "It's my two time here.",
      "correct": "It's my second time here.",
      "note": "To give a place in a series, use **second**, not **two**."
    }
  ],
