  "synonym_discrimination": null,
  "usage_note": "In English-speaking countries, your **first name** (also **given name**) is your own name, and your **last name** (also **surname** or **family name**) is the name you share with your family. In English, the first name is usually said and written before the last name. Forms often ask for each one separately, so write your family name as your last name even if it comes first in your own language.",
  "learner_errors": [
    {
      "incorrect": "How is your name?",
      "correct": "What is your name?",
      "note": "English asks **what** about a name, not **how**."
    },
    {
      "incorrect": "My name is called Omar.",
      "correct": "My name is Omar.",
      "note": "A person is called something; a name is not. You can also say *I'm called Omar*."
    }
  ],
