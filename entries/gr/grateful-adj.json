  "synonym_discrimination": {
    "words": [
      "grateful-adj",
      "thankful-adj"
    ],
    "note": "Both mean feeling thanks. **Grateful** is more usual when a person has helped you (*I am grateful to you for your help*). **Thankful** is common when you are glad about a lucky event (*thankful that it did not rain*)."
  },
  "usage_note": "*I would be grateful if you could...* is a polite way to ask for something, used especially in letters and emails.",
