  "synonym_discrimination": {
    "words": [
      "great-adj",
      "big-adj",
      "large-adj"
    ],
    "note": "**Big** and **large** describe physical size (*a big house*, *a large box*); **large** is more formal and common with numbers and amounts (*a large number*). **Great** for size goes mainly with nouns of amount, distance, or degree (*great care*, *a great distance*, *a great number*); with ordinary objects it sounds formal or literary."
  },
  "usage_note": "Said in a flat or annoyed voice, *Oh, great* means the opposite of sense 1: the speaker is unhappy about some bad news. Family words such as **great-grandmother** are written with a hyphen.",
  "learner_errors": [
    {
      "incorrect": "We have a great problem with the car.",
      "correct": "We have a big problem with the car.",
      "note": "For problems, mistakes, and other everyday things, **big** is usual; **great** in the size meaning goes mainly with words of amount or degree, such as *care* or *distance*."
    },
    {
      "incorrect": "We had a very great time.",
      "correct": "We had a really great time.",
      "note": "In the meaning *very good*, **great** is already strong; **really** is usual before it, not **very**."
    }
  ],
