  "synonym_discrimination": {
    "words": [
      "group-n",
      "team-n",
      "crowd-n"
    ],
    "note": "**Group** is the general word for people or things together: *a group of friends*. A **team** is a group that works or plays together toward one aim: *a soccer team*. A **crowd** is a large number of people in one place, usually not organized: *a crowd outside the stadium*."
  },
  "usage_note": "In American English **group** normally takes a singular verb: *the group is meeting today*. British English also uses a plural verb when the members act as separate people: *the group are arguing about the plan*. After **a group of** and a plural noun, a plural verb is also common in speech, though careful American writing prefers the singular: *a group of students was waiting*.",
  "learner_errors": [
    {
      "incorrect": "a group of student",
      "correct": "a group of students",
      "note": "After **a group of**, use a plural noun."
    },
    {
      "incorrect": "We worked in group.",
      "correct": "We worked in groups.",
      "note": "Use **in groups** or **in a group**; **group** is countable."
    }
  ],
