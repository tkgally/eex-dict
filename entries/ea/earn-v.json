  "synonym_discrimination": {
    "words": [
      "earn-v",
      "win-v",
      "gain-v"
    ],
    "note": "You **earn** money by working for it (*earn a salary*). You **win** money in a game, a competition, or by luck (*win the lottery*). **Gain** means to get more of something, often slowly, such as weight, experience, or time (*gain experience*)."
  },
