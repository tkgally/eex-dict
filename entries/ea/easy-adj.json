  "synonym_discrimination": {
    "words": [
      "easy-adj",
      "simple-adj"
    ],
    "note": "**Easy** is about effort: an easy task needs little work or skill (*an easy exam*). **Simple** is about having few parts or not being complicated (*a simple design*, *a simple dress*). Many things are both, so *simple instructions* and *easy instructions* are both natural, but only **simple** fits *a simple dress*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "This book is easy to read it.",
      "correct": "This book is easy to read.",
      "note": "After **easy to** and a verb, do not repeat the object."
    },
    {
      "incorrect": "He learned English easy.",
      "correct": "He learned English easily.",
      "note": "Use the adverb **easily** to say how something is done; **easy** as an adverb is used only in some informal phrases such as *take it easy* and *go easy*."
    }
  ],
