  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "In *The book is easy to read*, the subject (*the book*) is the thing being read, so no object follows the verb. Many languages build this kind of sentence differently.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The **ea** sounds like the **ee** of **see**, and the **s** sounds like **z**: *EE-zee*."
  },
