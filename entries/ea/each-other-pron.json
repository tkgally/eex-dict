    {
      "n": 1,
      "signpost": null,
      "definition": "used when each of two or more people or things does something to the other or others",
      "explanation": "**Each other** is used only as an object, after a verb or a preposition, never as a subject: *they help each other*, not *each other help them*. The possessive is **each other's**. The subject must be plural, or two people joined by **and**.",
      "grammar": {
        "countability": null,
        "transitivity": null,
        "codes": [],
        "patterns": []
      },
      "labels": {
        "register": [],
        "region": [],
