  "synonym_discrimination": {
    "words": [
      "earth-n",
      "world-n",
      "ground-n",
      "soil-n"
    ],
    "note": "**World** is the usual word for the planet as the place where people and countries are: *travel around the world*. **Earth** names the planet among other planets, or seen from space: *the earth from space*. For the surface you stand on, **ground** is usual: *sit on the ground*. For what plants grow in, **soil** and **earth** both work: *rich soil*, *soft earth*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I want to travel around the earth.",
      "correct": "I want to travel around the world.",
      "note": "For people, countries, and travel, use **world**; **earth** is the planet, the ground, or the soil."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages use one word for the planet, the ground, and the soil, as English **earth** does; but for people and countries English prefers **world**: *the best in the world*, not *the best on the earth*.",
