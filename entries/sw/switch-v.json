  "synonym_discrimination": {
    "words": [
      "switch-v",
      "change-v",
      "swap-v"
    ],
    "note": "**Change** is the general word: *change your plans*, *change trains*. **Switch** suggests a quick, complete move from one thing to another, often one of two choices: *switch to a new bank*, *switch seats*. **Swap** is a little more informal and means giving one thing and getting another in return: *swap seats*, *swap stories*."
  },
  "usage_note": "To make a light or a machine start or stop, English uses the phrasal verbs **switch on** and **switch off**, which have their own entries (*switch on the light* or *switch the light on*); **turn on** and **turn off** are more common in American English. **Switch** alone, with no particle, is not used for this.",
  "learner_errors": [
    {
      "incorrect": "Can you switch the light?",
      "correct": "Can you switch on the light?",
      "note": "To make a light or a machine work, use **switch on** or **turn on** (*switch the light on* is also correct); to stop it, **switch off** or **turn off**."
    },
    {
      "incorrect": "I switched my job last year.",
      "correct": "I switched jobs last year.",
      "note": "With **switch** meaning change, the noun is usually plural and has no possessive: *switch jobs*, *switch schools*."
    }
  ],
