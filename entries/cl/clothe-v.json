  "synonym_discrimination": null,
  "usage_note": "**Clothe** is formal. For the everyday act of putting on clothes, people say *get dressed* or *dress*, and for what someone has on, *wear*: *She was wearing white* rather than *She was clothed in white*. **Fully clothed** (wearing all your clothes) is common in every style.",
  "learner_errors": [
    {
      "incorrect": "I clothe myself every morning.",
      "correct": "I get dressed every morning.",
      "note": "**Clothe** is not used for the daily act of putting on your clothes."
    },
    {
      "incorrect": "He clothed a blue shirt.",
      "correct": "He wore a blue shirt.",
      "note": "For what someone has on their body, use **wear**."
    }
