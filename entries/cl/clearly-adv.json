  "synonym_discrimination": null,
  "usage_note": "In sense 2, **clearly** comments on the whole statement: *Clearly, she was tired* means that it was easy to see that she was tired, not that she was tired in a clear way.",
  "learner_errors": [
    {
      "incorrect": "It is clearly that he is wrong.",
      "correct": "It is clear that he is wrong.",
      "note": "After **it is**, use the adjective **clear**; **clearly** is the adverb: *he is clearly wrong*."
    }
  ],
