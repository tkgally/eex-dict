  "synonym_discrimination": {
    "words": [
      "clothes-n",
      "clothing-n",
      "outfit-n"
    ],
    "note": "**Clothes** is the everyday word: *I need new clothes*. **Clothing** is more formal and is uncountable; it is used for clothes of a particular kind or in business: *protective clothing*, *a clothing company*. An **outfit** is a set of clothes worn together, especially for an occasion: *a new outfit for the wedding*."
  },
  "usage_note": "**Clothes** is plural only and takes a plural verb: *my clothes are wet*. There is no singular form. For one thing, say *a piece of clothing* or name it: *a shirt*, *a coat*.",
  "learner_errors": [
    {
      "incorrect": "My clothes is still wet.",
      "correct": "My clothes are still wet.",
      "note": "**Clothes** is plural and takes a plural verb."
    },
    {
      "incorrect": "I bought a new clothe yesterday.",
      "correct": "I bought a new shirt yesterday.",
      "note": "There is no singular **clothe** as a noun; name the thing or say *a piece of clothing*."
    }
  ],
