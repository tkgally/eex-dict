  "synonym_discrimination": {
    "words": [
      "close-v",
      "shut-v"
    ],
    "note": "For doors, windows, eyes, and mouths, **close** and **shut** mean the same: *close the door*, *shut the door*. **Shut** is a little less formal and can sound more forceful. **Shut** is possible for a shop or a business, especially in British English, but use **close** for meetings, accounts, and computers: *close a meeting*, *close an account*, *close a file*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "Can you close the light?",
      "correct": "Can you turn off the light?",
      "note": "Lights, televisions, and machines are turned off or switched off, not closed."
    },
    {
      "incorrect": "The shop is close on Sundays.",
      "correct": "The shop is closed on Sundays.",
      "note": "After **be**, use the adjective **closed**. **Close** as an adjective means near."
    }
  ],
