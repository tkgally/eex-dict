  "synonym_discrimination": null,
  "usage_note": "For simply being near, after verbs such as **come**, **stand**, and **sit**, use **close**: *come close*, *stand close to me*. **Closely** is used for attention (*watch closely*), for connection (*closely related*), and for one thing following or packed near another (*closely followed by*, *closely packed*, *walk closely behind*).",
  "learner_errors": [
    {
      "incorrect": "Come closely so you can see.",
      "correct": "Come closer so you can see.",
      "note": "For moving near someone or something, use **close** or **closer**; **closely** means carefully or strongly connected."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Many languages use one word for **near** and for **carefully** (*watch closely*). English uses **close** after **come**, **stand**, and **sit**, and **closely** for attention, for connection, and for things that follow or are packed near each other.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "Two syllables with the stress on the first: *KLOHSS-lee*. The **s** is a hissing **s**, as in **close** meaning near, not the **z** sound of **close** meaning shut."
  },
