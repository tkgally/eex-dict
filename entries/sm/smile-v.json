  "synonym_discrimination": null,
  "usage_note": "**Smile at** someone means looking at them while smiling (*she smiled at me*); **smile to yourself** means smiling while thinking of something, with nobody watching. A **smile** is silent; a **laugh** or a **giggle** usually has a sound.",
  "learner_errors": [
    {
      "incorrect": "She smiled to me.",
      "correct": "She smiled at me.",
      "note": "The person you look at while smiling takes **at**."
    },
    {
      "incorrect": "He smiled me.",
      "correct": "He smiled at me.",
      "note": "**Smile** does not take a person as a direct object."
    }
  ],
