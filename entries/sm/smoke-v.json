  "synonym_discrimination": null,
  "usage_note": "**No smoking** on a sign means smoking is not allowed. *Do you smoke?* asks about a habit; to ask if you may smoke now, people say *Do you mind if I smoke?* The habit is often described with **smoke**, **quit**, or **give up**: *I gave up smoking last year*.",
  "learner_errors": [
    {
      "incorrect": "I stopped to smoke last year.",
      "correct": "I stopped smoking last year.",
      "note": "**Stop smoking** means you no longer smoke; **stop to smoke** means you stopped doing something else in order to smoke."
    },
    {
      "incorrect": "He drinks cigarettes.",
      "correct": "He smokes cigarettes.",
      "note": "In English you **smoke** a cigarette; some languages use a verb meaning drink or suck."
    }
  ],
