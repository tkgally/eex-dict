  "synonym_discrimination": {
    "words": [
      "magic-adj",
      "magical-adj"
    ],
    "note": "**Magic** is the usual word before a noun for things that have special powers or are used in tricks: *a magic ring*, *a magic trick*. **Magical** is more usual for a feeling of wonder, and after a verb: *a magical evening*, *The view was magical*."
  },
  "usage_note": "**Magic** is also a noun (*She believes in magic*); this entry is for its use to describe a thing.",
