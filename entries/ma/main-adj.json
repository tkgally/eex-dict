  "synonym_discrimination": null,
  "usage_note": "Main is the everyday word; chief and principal say the same thing in more formal writing. Main can mean the largest part as well as the most important one: the main course is the biggest dish of a meal, and the main road is the most important road, usually the biggest and busiest.",
  "learner_errors": [
    {
      "incorrect": "This problem is main.",
      "correct": "This is the main problem.",
      "note": "Main is used only before a noun; after be, say the most important or the biggest."
    },
    {
      "incorrect": "the most main reason",
      "correct": "the main reason",
      "note": "Main already means the most important or the largest, so it takes no most or very."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Main covers both the most important and the largest; a language may need one word for the main reason and another for the main road or the main course.",
    "grammar": "Main comes only before a noun and has no comparative form: the main reason, never the reason is main or the most main reason. After be, use the most important or the biggest.",
    "culture": "In many American towns the central shopping street is named Main Street, and the name is used for ordinary local life and small businesses.",
