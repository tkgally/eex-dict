  "synonym_discrimination": {
    "words": [
      "match-v",
      "fit-v",
      "suit-v"
    ],
    "note": "**Match** is about two things that look good together or are the same: *the bag matches her shoes*. **Fit** is about size and shape: *the shoes fit*. **Suit** is about how something looks on a person or is right for them: *red suits you*."
  },
