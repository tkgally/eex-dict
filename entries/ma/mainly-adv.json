  "synonym_discrimination": {
    "words": [
      "mainly-adv",
      "mostly-adv",
      "largely-adv"
    ],
    "note": "All three mean *for the most part*. **Mainly** is the usual choice for the most important reason or use (*I came mainly to see you*). **Mostly** is common in speech and can also mean *usually* (*We mostly eat at home*). **Largely** is a little more formal and often goes with **because** or a form such as **ignored** (*largely ignored*)."
  },
  "usage_note": "**Mainly** usually goes just before the word or phrase it limits: *mainly in the morning*, *mainly students*. With a verb, it goes before the main verb or after **be**: *It mainly rains in winter*, *They are mainly young*.",
  "learner_errors": [
    {
      "incorrect": "The mainly problem is money.",
      "correct": "The main problem is money.",
      "note": "Before a noun, use the adjective **main**."
    }
  ],
