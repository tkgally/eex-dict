  "synonym_discrimination": {
    "words": [
      "man-n",
      "gentleman-n",
      "guy-n"
    ],
    "note": "**Man** is the ordinary, neutral word: *a man in a blue coat*. **Gentleman** is more polite and is used especially when speaking to or about men in public: *Ladies and gentlemen, please sit down*. **Guy** is informal and very common in speech: *He's a nice guy*."
  },
  "usage_note": "The plural is **men**: *one man, two men*. *Man!* said alone to show surprise or strong feeling (*Man, that was close!*) is an interjection; see that entry.",
  "learner_errors": [
    {
      "incorrect": "Two mans came to the door.",
      "correct": "Two men came to the door.",
      "note": "The plural is **men**, not **mans**."
    },
    {
      "incorrect": "the mens' room",
      "correct": "the men's room",
      "note": "**Men** is already plural, so the possessive is **men's**."
    }
  ],
