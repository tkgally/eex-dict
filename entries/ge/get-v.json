  "synonym_discrimination": {
    "words": [
      "get-v",
      "become-v",
      "go-v",
      "turn-v"
    ],
    "note": "All four say that a state changes. Become is more formal and more usual in writing: he became a teacher; it became clear. Get is the everyday spoken word with adjectives: get tired, get cold, get married. Go is for changes for the worse or beyond control: go bad, go blind, go wrong. Turn is for colors and for sudden or complete changes: the leaves turn red; the milk turned sour."
  },
  "usage_note": "Get is one of the most common words in speech and is normal in writing too, but some teachers prefer a more exact verb in careful writing. In an essay or a report, a more exact word is often better: receive a letter, obtain permission, become angry, arrive at the station, catch a cold.",
  "learner_errors": [
    {
      "incorrect": "I got him do the work.",
      "correct": "I got him to do the work.",
      "note": "After get and an object, the next verb takes to; only make, let, and have take the bare form."
    },
    {
      "incorrect": "When I got to home, nobody was there.",
      "correct": "When I got home, nobody was there.",
      "note": "Home, here, and there are adverbs, so no preposition follows get; a noun such as the office does take to."
    },
    {
      "incorrect": "She has got married last year.",
      "correct": "She got married last year.",
      "note": "With a finished past time, use the simple past got; have got means have, not have received."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "Get is a general verb of change that other languages express with many different verbs: receive, obtain, buy, fetch, become, arrive, catch, understand. Translate each sense separately; the synonym listed under each sense is usually the more exact word.",
    "grammar": "Three structures are easily confused: get plus adjective (get tired) marks a change; get plus object plus to-infinitive (get him to help) means persuade; get plus object plus past participle (get it fixed) means cause or arrange. Home, here, and there follow get with no preposition.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "The vowel is the short e of bed, and the final t is clearly heard. The past tense got has the vowel of hot in American English and of not in British English; gotten has two syllables with the stress on the first."
  },
