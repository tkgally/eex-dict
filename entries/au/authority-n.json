  "usage_note": "For the police and other officials as a group, use the plural **the authorities**, with a plural verb: *the authorities are investigating*. **Authority** meaning power is uncountable: *She has authority*, not *an authority*, in that sense.",
  "learner_errors": [
    {
      "incorrect": "The authority are looking for him.",
      "correct": "The authorities are looking for him.",
      "note": "For the police and officials as a group, use the plural **the authorities**."
    },
    {
      "incorrect": "Teachers have authority on the students.",
      "correct": "Teachers have authority over the students.",
      "note": "You have authority **over** people, but you are an authority **on** a subject."
    }
  ],
