  "synonym_discrimination": null,
  "usage_note": "**Audience** is one group: *a large audience*, not *many audiences*, when you mean many people at one event. For one person, say *a member of the audience* or *someone in the audience*. In British English the verb after **audience** can be plural: *the audience were cheering*.",
  "learner_errors": [
    {
      "incorrect": "There were many audiences at the concert.",
      "correct": "There was a large audience at the concert.",
      "note": "**Audience** means the whole group of people. To talk about its size, use **large** or **small**."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "\"audience\" names the whole group, so one event has one audience: *a large audience*, not *many audiences*. For one person, use *a member of the audience*.",
    "culture": null,
    "false_friends": "In some languages a similar word also means a meeting in a court of law. English uses **hearing** for that.",
