  "synonym_discrimination": {
    "words": [
      "cause-n",
      "reason-n"
    ],
    "note": "A **cause** is what makes something happen: *the cause of the accident*. A **reason** explains why something happened or why someone did it: *the reason I left early*. People have reasons; events have causes. Both are possible for feelings: *no reason to worry*, *no cause for worry*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "What was the cause for the accident?",
      "correct": "What was the cause of the accident?",
      "note": "Use **the cause of** an event; **cause for** goes with feelings: *cause for concern*."
    }
  ],
