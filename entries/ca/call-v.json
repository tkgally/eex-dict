  "synonym_discrimination": {
    "words": [
      "call-v",
      "phone-v",
      "ring-v"
    ],
    "note": "**Call** is the usual word everywhere for using a telephone: *I'll call you tonight*. **Phone** means the same and is common in both American and British English: *She phoned the office*. **Ring** is British and informal: *Ring me when you get there*."
  },
  "usage_note": "In the name sense, the name follows the object with no **as** and no **with**: *They called her Sara*. The passive is common for names of things: *This dish is called a stew*. To ask someone's name, say *What's your name?*, not *How are you called?*.",
  "learner_errors": [
    {
      "incorrect": "I called to her yesterday to ask about the party.",
      "correct": "I called her yesterday to ask about the party.",
      "note": "When you phone someone, **call** takes a direct object; **call to** someone means shout to them."
    },
    {
      "incorrect": "My name is called Ana.",
      "correct": "My name is Ana.",
      "note": "A person **is called** something; a name **is** something. You can also say *I'm called Ana*."
    },
    {
      "incorrect": "How are you called?",
      "correct": "What's your name?",
      "note": "Ask *What are you called?* or, more usually, *What's your name?*; **how** is not used."
    }
  ],
  "etymology": null,
