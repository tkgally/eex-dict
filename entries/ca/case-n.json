  "word_family": [],
  "synonym_discrimination": null,
  "usage_note": "**In case** means *because something might happen*: you act now to be ready (*Take a coat in case it gets cold*). **If** means *only when it happens* (*Call me if you need help*). After **in case**, use the present tense for the future: *in case it rains*, with no **will**.",
  "learner_errors": [
    {
      "incorrect": "I'll take my umbrella in case it will rain.",
      "correct": "I'll take my umbrella in case it rains.",
      "note": "After **in case**, use the present tense to talk about the future."
    },
    {
      "incorrect": "Bring a jacket in case of it gets cold.",
      "correct": "Bring a jacket in case it gets cold.",
      "note": "**In case of** comes before a noun (*in case of rain*); before a clause, use **in case**."
    },
    {
      "incorrect": "In case you see Ana, tell her I said hello.",
      "correct": "If you see Ana, tell her I said hello.",
      "note": "Use **if** when you mean *only when it happens*; **in case** means doing something now to be ready."
    }
  ],
