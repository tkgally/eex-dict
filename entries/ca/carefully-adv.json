  "synonym_discrimination": null,
  "usage_note": "**Careful** is the adjective (*be careful*, *a careful driver*); after an action verb, use **carefully**: *drive carefully*. Before a past participle, **carefully** comes first: *a carefully chosen word*.",
  "learner_errors": [
    {
      "incorrect": "Drive careful!",
      "correct": "Drive carefully!",
      "note": "After an action verb, use the adverb **carefully**; **careful** is the adjective, used after **be**."
    },
    {
      "incorrect": "Please read carefuly.",
      "correct": "Please read carefully.",
      "note": "**Careful** already ends in **l**, and **-ly** adds another: **carefully** has two."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**Carefully** goes after the verb and its object (*close the door carefully*) or before the verb (*carefully close the door*), not between the verb and its object.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "Three syllables with the stress on the first: *KAIR-fuh-lee*. The **ful** is short and weak, like *fuh*."
  },
