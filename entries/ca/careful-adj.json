  "usage_note": "*Be careful!* and *Careful!* are common warnings. *Take care* is different: it is a friendly way of saying goodbye. To say how someone does something, use the adverb **carefully**: *drive carefully*.",
  "learner_errors": [
    {
      "incorrect": "Please drive careful.",
      "correct": "Please drive carefully.",
      "note": "To describe how someone does something, use the adverb **carefully**."
    },
    {
      "incorrect": "Be careful the dog!",
      "correct": "Be careful of the dog!",
      "note": "Use **of** before a danger to avoid, and **with** before something you are using or holding: *careful with that knife*."
    }
