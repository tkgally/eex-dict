  "synonym_discrimination": {
    "words": [
      "worried-adj",
      "anxious-adj",
      "nervous-adj",
      "concerned-adj"
    ],
    "note": "**Worried** is the everyday word: *I'm worried about Kim*. **Anxious** is stronger and a little more formal, often for a feeling that lasts: *anxious about the future*. **Nervous** is mostly about something that is going to happen soon, often something you must do: *nervous before the interview*. **Concerned** is more formal and is common for a problem that affects other people: *concerned about her health*."
  },
  "usage_note": null,
  "learner_errors": [
    {
      "incorrect": "I am worry about you.",
      "correct": "I am worried about you.",
      "note": "**Worry** is the verb or the noun; after **be** use the adjective **worried**."
    },
    {
      "incorrect": "The news is very worried.",
      "correct": "The news is very worrying.",
      "note": "A person who feels it is **worried**; the thing that causes the feeling is **worrying**."
    },
    {
      "incorrect": "I'm worried for the test.",
      "correct": "I'm worried about the test.",
      "note": "Use **worried about** for a test or an event; **worried for** usually means afraid of what may happen to someone or something."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": null,
    "grammar": "**Worried** describes how a person feels; the thing that causes the feeling is **worrying** (*a worrying problem*). Many languages do not make this difference with two forms, so learners often mix them.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "**Worried** has two parts, with the stress on the first: *WUR-eed* in American English and *WUH-reed* in British English. The **o** sounds like the **u** of **sun** or **fur**, not like the **o** of **sorry**."
  },
