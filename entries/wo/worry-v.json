  "synonym_discrimination": {
    "words": [
      "worry-v",
      "anxious-adj",
      "concerned-adj"
    ],
    "note": "**Worry** is the everyday verb: *I worry about money*. **Be anxious** is stronger and suggests a nervous fear: *anxious about the test results*. **Be concerned** is more formal and is common in official or polite language: *We are concerned about the delay*."
  },
  "usage_note": "**Don't worry** is a very common way to comfort someone or to say that something is not a problem. For a feeling now, the adjective is the most common choice (*I'm worried about the exam*), though *I'm worrying about the exam* is also possible; **I worry** often describes a habit (*I worry about my weight*).",
  "learner_errors": [
    {
      "incorrect": "I am worry about my exam.",
      "correct": "I am worried about my exam.",
      "note": "After **be**, use the adjective **worried**; **worry** is the verb or the noun."
    },
    {
      "incorrect": "Don't worry for me.",
      "correct": "Don't worry about me.",
      "note": "Use **about** to say what the worry is; **worry for** someone is less common and means fear for their safety."
    }
  ],
  "etymology": null,
  "see_also": [],
  "adaptation": {
    "semantic": "\"worry\" covers both feeling anxious (*I worry*) and causing the feeling (*it worries me*). Many languages use a reflexive verb or two different verbs for these.",
    "grammar": "The feeling after **be** is the adjective **worried** (*I'm worried*); the verb **worry** is not used after **be**.",
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"worry\" rhymes with **hurry**; it does not rhyme with **sorry**."
  },
