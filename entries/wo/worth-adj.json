  "synonym_discrimination": null,
  "usage_note": "**Worth** comes after a verb such as **be** and never before a noun. It is followed directly by an amount, a noun, or an **-ing** form, like a preposition: *worth ten dollars*, *worth waiting for*. **It's worth** + **-ing** is a common way to give advice: *It's worth checking the price first*. The noun (*a week's worth of food*) is a separate entry.",
  "learner_errors": [
    {
      "incorrect": "This book is worth to read.",
      "correct": "This book is worth reading.",
      "note": "Use an **-ing** form after **worth**, not **to** and a verb."
    },
    {
      "incorrect": "The film is worth being seen.",
      "correct": "The film is worth seeing.",
      "note": "The **-ing** form after **worth** already has a passive meaning."
    }
  ],
