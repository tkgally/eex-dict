  "synonym_discrimination": {
    "words": [
      "work-n",
      "job-n"
    ],
    "note": "**Work** is uncountable: it is the activity, or your job in general (*I have a lot of work*; *I'm looking for work*). **Job** is countable: it is one particular position that you are paid for (*I'm looking for a job*; *she has two jobs*). You cannot say *a work* for a position."
  },
  "usage_note": "**Work** is uncountable in senses 1 to 3: *a lot of work*, *some work*, not *a work* or *works*. The countable **a work** means something an artist or writer has made. **Go to work** and **at work** take no article.",
  "learner_errors": [
    {
      "incorrect": "I'm looking for a work.",
      "correct": "I'm looking for a job.",
      "note": "**Work** is uncountable; for one position, use **a job**."
    },
    {
      "incorrect": "I have many works to do.",
      "correct": "I have a lot of work to do.",
      "note": "**Work** meaning tasks has no plural."
    },
    {
      "incorrect": "I go to the work by bus.",
      "correct": "I go to work by bus.",
      "note": "No article in **go to work** and **at work**."
    }
  ],
