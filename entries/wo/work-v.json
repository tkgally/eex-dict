  "adaptation": {
    "semantic": "Many languages use different verbs for a person doing a job, a machine running, and a plan succeeding. English uses **work** for all three: *She works in a bank*, *The radio works*, *The plan worked*.",
    "grammar": null,
    "culture": null,
    "false_friends": null,
    "pronunciation": "\"work\" has the vowel of **bird** and **her**, not the vowel of **walk** or **fork**."
  },
