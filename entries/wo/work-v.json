  "synonym_discrimination": {
    "words": [
      "work-v",
      "function-v",
      "operate-v"
    ],
    "note": "**Work** is the everyday word when a machine does its job: *The heater doesn't work*. **Function** is more formal and often technical: *The system is functioning normally*. **Operate** can mean the same, but it more often means make a machine do its job: *operate the machine*."
  },
  "usage_note": "**Work** as a verb is usually intransitive: you **work for** a company, **at** or **in** a place, **as** a teacher, and **on** a task. The transitive uses (*work a machine*, *work the land*) are less common.",
  "learner_errors": [
    {
      "incorrect": "I work in a hospital as nurse.",
      "correct": "I work in a hospital as a nurse.",
      "note": "Put **a** or **an** before a job after **work as**."
    },
    {
      "incorrect": "I worked very hardly.",
      "correct": "I worked very hard.",
      "note": "The adverb is **hard**; **hardly** means *almost not*."
    },
    {
      "incorrect": "Where do you work in?",
      "correct": "Where do you work?",
      "note": "**Where** already includes the idea of **in**; do not add a preposition at the end."
    }
  ],
