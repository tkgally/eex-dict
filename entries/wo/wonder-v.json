  "usage_note": "When **wonder** reports a question, the clause after it keeps statement word order and needs no question mark: *I wonder where she lives.*",
  "learner_errors": [
    {
      "incorrect": "I wonder what time is it.",
      "correct": "I wonder what time it is.",
      "note": "After **wonder**, a question word is followed by statement word order."
    },
    {
      "incorrect": "I wonder that he is late.",
      "correct": "I wonder why he is late.",
      "note": "To report a question, use a question word, **if**, or **whether** after **wonder**; **wonder that** is rare and formal, and means *be surprised that*."
    }
