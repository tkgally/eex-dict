  "synonym_discrimination": null,
  "usage_note": "Americans usually call study after high school **college**, even at a university: *She's in college*, *He goes to college in the city*. **University** is common in names and for the place itself, with **a** or **the**: *a university in the south*. British English uses **university** with no article for studying there: *She's at university*.",
  "learner_errors": [
    {
      "incorrect": "My son goes to an university.",
      "correct": "My son goes to a university.",
      "note": "**University** begins with the sound of **you**, so use **a**, not **an**."
    },
    {
      "incorrect": "I'm a student of university.",
      "correct": "I'm a university student.",
      "note": "Put **university** before **student**, or say *a student at the university*."
    }
