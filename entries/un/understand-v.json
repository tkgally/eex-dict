  "synonym_discrimination": {
    "words": [
      "understand-v",
      "realize-v",
      "know-v"
    ],
    "note": "**Understand** is to know what something means or why it happens: *I understand the problem now*. **Realize** is to become aware of a fact, often suddenly: *I realized I had left my keys at home*. **Know** is to have a piece of information already: *I know where she lives*."
  },
  "usage_note": "In conversation people often say *I see* or *Got it* to show that they understand, and *Sorry, I don't follow* or *I'm not sure I understand* when they do not.",
  "learner_errors": [
