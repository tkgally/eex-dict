  "synonym_discrimination": {
    "words": [
      "under-prep",
      "below-prep",
      "beneath-prep"
    ],
    "note": "**Under** is the usual word when one thing is directly lower than another and is covered by it or touching it: *under the blanket*. **Below** means at a lower level, whether or not something is directly over it, and is preferred for levels on a scale: *below the window*, *below zero*. **Beneath** means the same as **under** but is formal or literary: *beneath the surface*."
  },
  "usage_note": "**Under** with no noun after it (*The boat went under*) is an adverb, a separate entry; this entry covers only the preposition.",
